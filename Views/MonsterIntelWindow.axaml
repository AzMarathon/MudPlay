<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:combat="using:MudPlay.Game.Combat"
        xmlns:calc="using:MudPlay.Game.Calculators"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1560" d:DesignHeight="760"
        x:Class="MudPlay.Views.MonsterIntelWindow"
        x:DataType="vm:MonsterIntelViewModel"
        Title="Monster Intel"
        Width="1560" Height="760"
        MinWidth="1100" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Group">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.Group">
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.DetailLine">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="12">
        <Grid RowDefinitions="Auto,*">

            <!-- ===== Context bar: current room roster + combat target ===== -->
            <Border Grid.Row="0" Classes="Group" Margin="0,0,0,10" IsVisible="{Binding HasContextBar}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Current target: {0}">
                                    <Binding Path="CurrentTargetName" TargetNullValue="(none)"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <CheckBox Grid.Column="1" Content="Follow target" IsChecked="{Binding FollowTarget, Mode=TwoWay}"
                                   ToolTip.Tip="Auto-select whatever this character is currently fighting."/>
                        <CheckBox Grid.Column="2" Content="Pin" IsChecked="{Binding Pinned, Mode=TwoWay}" Margin="12,0,0,0"
                                   ToolTip.Tip="Hold the current detail view steady even while following is on."/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RoomMonsters}" IsVisible="{Binding RoomMonsters.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="combat:MonsterIntelEntry">
                                <Button Content="{Binding Name}" Margin="0,0,6,6" Padding="8,3"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectMonsterCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" x:Name="PanesGrid" ColumnDefinitions="1.5*,6,*">

            <!-- ===== Left: searchable master list ===== -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBox Grid.Column="0" Classes="clearable" Text="{Binding NameFilter, Mode=TwoWay}"
                             PlaceholderText="Filter by name…"/>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="8,0,0,0"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="MonsterGrid" ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          SelectionMode="Extended" SelectionChanged="OnMonsterGridSelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource ChromeBgElevBrush}"
                          BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"   Binding="{ReflectionBinding Name}"          Width="*"    MinWidth="180" SortMemberPath="Name"/>
                        <DataGridTextColumn Header="HP"     Binding="{ReflectionBinding HpText}"        Width="Auto" MinWidth="70"  SortMemberPath="Hp"/>
                        <DataGridTextColumn Header="Exp"    Binding="{ReflectionBinding ExpText}"       Width="Auto" MinWidth="80"  SortMemberPath="Exp"/>
                        <DataGridTextColumn Header="AC/DR"  Binding="{ReflectionBinding AcDrText}"      Width="Auto" MinWidth="70"/>
                        <DataGridTextColumn Header="Dodge"  Binding="{ReflectionBinding DodgeText}"     Width="Auto" MinWidth="65"/>
                        <DataGridTextColumn Header="MR"     Binding="{ReflectionBinding MagicResText}"  Width="Auto" MinWidth="55"/>
                        <DataGridTextColumn Header="Acc"    Binding="{ReflectionBinding AccuracyText}"  Width="Auto" MinWidth="70"/>
                        <DataGridTextColumn Header="Mag"    Binding="{ReflectionBinding MagicalText}"   Width="Auto" MinWidth="55"/>
                        <DataGridTextColumn Header="Undead" Binding="{ReflectionBinding UndeadText}"    Width="Auto" MinWidth="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Drag handle: resizes the list vs. detail panes. Ratio persists
                 per-profile via SplitterLayoutStore (see code-behind). -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource ChromeBorderBrush}"
                          ShowsPreview="False"/>

            <!-- ===== Right: selected-monster detail ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <Panel>
                <StackPanel Spacing="0" IsVisible="{Binding ShowSingleDetail}">
                    <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold" Margin="0,0,0,10"/>

                    <Border Classes="Group">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Overview"/>
                            <ItemsControl ItemsSource="{Binding OverviewLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Elemental Defenses"/>
                            <ItemsControl ItemsSource="{Binding ElementalDefenses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ElementalDefenseRow">
                                        <TextBlock Classes="DetailLine">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}: {1} ({2})">
                                                    <Binding Path="Element"/>
                                                    <Binding Path="PercentText"/>
                                                    <Binding Path="Classification"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="DetailLine" Text="No known elemental resistances or vulnerabilities."
                                       IsVisible="{Binding !ElementalDefenses.Count}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding CastsLines.Count}">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Casts"/>
                            <ItemsControl ItemsSource="{Binding CastsLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding HasMatchupContext}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="Group" Text="Your Matchup"/>

                            <ItemsControl ItemsSource="{Binding MatchupLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" TextWrapping="Wrap" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel IsVisible="{Binding IncomingThreatLines.Count}">
                                <TextBlock Classes="FieldLabel" Text="Incoming elemental threat" Margin="0,4,0,2"/>
                                <ItemsControl ItemsSource="{Binding IncomingThreatLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="DetailLine" TextWrapping="Wrap" Text="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding SpellEffectiveness.Count}">
                                <TextBlock Classes="FieldLabel" Text="Your attack spells, ranked" Margin="0,4,0,2"/>
                                <ItemsControl ItemsSource="{Binding SpellEffectiveness}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="calc:SpellEffectivenessResult">
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Classes="DetailLine" FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} ({1})">
                                                            <Binding Path="Name"/>
                                                            <Binding Path="Element"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Classes="DetailLine" Margin="10,0,0,0" IsVisible="{Binding Eligible}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} effective damage, {1} mana/round">
                                                            <Binding Path="EffectiveDamage"/>
                                                            <Binding Path="ManaCostPerRound"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Classes="DetailLine" Margin="10,0,0,0" Text="{Binding BlockedReason}"
                                                           IsVisible="{Binding !Eligible}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding HasObservations}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="Group" Text="Your Observations"
                                           ToolTip.Tip="What this character has actually seen happen in combat against this monster — kept separate from the game-data facts above."/>
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearObservationsCommand}"
                                        ToolTip.Tip="Clear all recorded observations for every monster (not just this one)."/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ObservationLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding AttackRows.Count}">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Attacks"/>
                            <ItemsControl ItemsSource="{Binding AttackRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AttackRowViewModel">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Classes="DetailLine" Text="{Binding Header}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="DetailLine" Text="{Binding Kind}" Margin="10,0,0,0"/>
                                            <TextBlock Classes="DetailLine" Text="{Binding Detail}" Margin="10,0,0,0"/>
                                            <TextBlock Classes="DetailLine" Text="{Binding Energy}" Margin="10,0,0,0"
                                                       IsVisible="{Binding Energy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding LootLines.Count}">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Loot"/>
                            <ItemsControl ItemsSource="{Binding LootLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding LocationLines.Count}">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Locations"/>
                            <ItemsControl ItemsSource="{Binding LocationLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="Group" Text="Automation"/>
                            <TextBlock Classes="DetailLine" Text="{Binding AutomationSummaryText}" TextWrapping="Wrap"/>
                            <Button Content="Edit Automation…" Command="{Binding EditAutomationCommand}"
                                    ToolTip.Tip="Configure how MudPlay's auto-combat treats this monster — relationship, priority, attack overrides, backstab, kill-on-sight."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Select a monster on the left to see its details. Ctrl/Shift-click to select 2+ and compare them side by side."
                           Foreground="{StaticResource ChromeFgSecBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="{Binding ShowPlaceholder}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40,20,0"/>

                <!-- ===== Comparison view (2+ rows selected) ===== -->
                <ScrollViewer IsVisible="{Binding HasComparison}" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="combat:MonsterIntelEntry">
                                <Border Classes="Group" Width="260" VerticalAlignment="Top">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding HpText, StringFormat='HP: {0}'}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding ExpText, StringFormat='Exp: {0}'}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding AcDrText, StringFormat='AC/DR: {0}'}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding DodgeText, StringFormat='Dodge: {0}'}"
                                                   IsVisible="{Binding DodgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding MagicResText, StringFormat='MR: {0}'}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding AccuracyText, StringFormat='Acc: {0}'}"
                                                   IsVisible="{Binding AccuracyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding MagicalText, StringFormat='Mag: {0}'}"
                                                   IsVisible="{Binding MagicalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding SpellImmuneText, StringFormat='SpellImmu: {0}'}"
                                                   IsVisible="{Binding SpellImmuneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding ResistsText, StringFormat='Resists: {0}'}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding ResistsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="DetailLine" Text="{Binding CastsText, StringFormat='Casts: {0}'}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding CastsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="DetailLine" Text="Undead" IsVisible="{Binding Undead}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
              </Panel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
