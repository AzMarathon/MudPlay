<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:combat="using:MudPlay.Game.Combat"
        xmlns:calc="using:MudPlay.Game.Calculators"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="MudPlay.Views.MonsterIntelWindow"
        x:DataType="vm:MonsterIntelViewModel"
        Title="Monster Intel"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Group">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.Group">
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.DetailLine">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- ===== Character bar: who you are, right now ===== -->
            <Border Grid.Row="0" Classes="Group" Margin="0,0,0,10" IsVisible="{Binding HasCharacterContext}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="28">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="FieldLabel" Text="Character"/>
                        <TextBlock Classes="DetailLine">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} — Level {1} {2}">
                                    <Binding Path="Stats.Name"/>
                                    <Binding Path="Stats.Level"/>
                                    <Binding Path="Stats.Class"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="FieldLabel" Text="HP"/>
                        <TextBlock Classes="DetailLine">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}/{1}">
                                    <Binding Path="Live.Hp"/>
                                    <Binding Path="Live.MaxHp"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="FieldLabel" Text="{Binding ManaLabel}"/>
                        <TextBlock Classes="DetailLine">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}/{1}">
                                    <Binding Path="Live.Ma"/>
                                    <Binding Path="Live.MaxMa"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Classes="FieldLabel" Text="Weapon"/>
                        <TextBlock Classes="DetailLine" Text="{Binding WeaponSummaryText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Classes="FieldLabel" Text="Known attack spells"/>
                        <TextBlock Classes="DetailLine" Text="{Binding KnownAttackSpellCount}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Context bar: current room's monster roster ===== -->
            <Border Grid.Row="1" Classes="Group" Margin="0,0,0,10"
                    IsVisible="{Binding HasContextBar}">
                <StackPanel Spacing="6" IsVisible="{Binding RoomMonsters.Count}">
                    <TextBlock Classes="FieldLabel" Text="In this room"/>
                    <ItemsControl ItemsSource="{Binding RoomMonsters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="combat:MonsterIntelEntry">
                                <Button Content="{Binding Name}" Margin="0,0,6,6" Padding="8,3"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectMonsterCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" x:Name="PanesGrid" ColumnDefinitions="1.5*,6,*">

            <!-- ===== Left: searchable master list ===== -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,12,0">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBox Grid.Column="0" Classes="clearable" Text="{Binding NameFilter, Mode=TwoWay}"
                             PlaceholderText="Filter by name…"/>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="8,0,0,0"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,8"
                            IsVisible="{Binding HasCharacterContext}">
                    <CheckBox Content="Hittable" IsChecked="{Binding HittableOnly, Mode=TwoWay}"
                              ToolTip.Tip="Only show monsters your currently-equipped weapon is magical enough to hit physically."/>
                    <CheckBox Content="Castable" IsChecked="{Binding CastableOnly, Mode=TwoWay}"
                              ToolTip.Tip="Only show monsters where at least one of your known attack spells clears their spell immunity."/>
                    <CheckBox Content="Safe" IsChecked="{Binding SafeOnly, Mode=TwoWay}"
                              ToolTip.Tip="Only show monsters whose own attack has at most the threshold chance to hit you, given your live AC/Dodge/wards."/>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding SafeOnly}">
                        <TextBlock Classes="FieldLabel" Text="≤" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding SafeHitThreshold, Mode=TwoWay}"
                                       Minimum="0" Maximum="100" Increment="1"
                                       FormatString="0" Width="90"
                                       ToolTip.Tip="Chance-to-hit-you threshold, in percent."/>
                        <TextBlock Classes="FieldLabel" Text="%" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="2" x:Name="MonsterGrid" ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource ChromeBgElevBrush}"
                          BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"       Binding="{ReflectionBinding Name}"                 Width="*"    MinWidth="160" MaxWidth="300" SortMemberPath="Name"/>
                        <DataGridTextColumn Header="HP"         Binding="{ReflectionBinding HpText}"               Width="Auto" MinWidth="80"  SortMemberPath="Hp"/>
                        <DataGridTextColumn Header="Hits You %" Binding="{ReflectionBinding IncomingHitPercentText}" Width="Auto" MinWidth="90" SortMemberPath="IncomingHitPercent"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Drag handle: resizes the list vs. detail panes. Ratio persists
                 per-profile via SplitterLayoutStore (see code-behind). -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource ChromeBorderBrush}"
                          ShowsPreview="False"/>

            <!-- ===== Right: selected-monster detail ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <Panel>
                <StackPanel Spacing="0" IsVisible="{Binding ShowSingleDetail}">
                    <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold" Margin="0,0,0,10"/>

                    <Border Classes="Group" IsVisible="{Binding HasMatchupContext}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="Group" Text="Your Matchup"/>

                            <ItemsControl ItemsSource="{Binding MatchupLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" TextWrapping="Wrap" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel IsVisible="{Binding IncomingThreatLines.Count}">
                                <TextBlock Classes="FieldLabel" Text="Incoming elemental threat" Margin="0,4,0,2"/>
                                <ItemsControl ItemsSource="{Binding IncomingThreatLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="DetailLine" TextWrapping="Wrap" Text="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding SpellEffectiveness.Count}">
                                <TextBlock Classes="FieldLabel" Text="Your attack spells, ranked" Margin="0,4,0,2"/>
                                <ItemsControl ItemsSource="{Binding SpellEffectiveness}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="calc:SpellEffectivenessResult">
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Classes="DetailLine" FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} ({1})">
                                                            <Binding Path="Name"/>
                                                            <Binding Path="Element"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Classes="DetailLine" Margin="10,0,0,0" IsVisible="{Binding Eligible}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} effective damage, {1} mana/round">
                                                            <Binding Path="EffectiveDamage"/>
                                                            <Binding Path="ManaCostPerRound"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Classes="DetailLine" Margin="10,0,0,0" Text="{Binding BlockedReason}"
                                                           IsVisible="{Binding !Eligible}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding HasObservations}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="Group" Text="Your Observations"
                                           ToolTip.Tip="What this character has actually seen happen in combat against this monster — kept separate from the game-data facts above."/>
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearObservationsCommand}"
                                        ToolTip.Tip="Clear all recorded observations for every monster (not just this one)."/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ObservationLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="DetailLine" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="Group" IsVisible="{Binding AttackRows.Count}">
                        <StackPanel>
                            <TextBlock Classes="Group" Text="Attacks"/>
                            <ItemsControl ItemsSource="{Binding AttackRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AttackRowViewModel">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Classes="DetailLine" Text="{Binding Header}" FontWeight="SemiBold"/>
                                            <TextBlock Classes="DetailLine" Text="{Binding Kind}" Margin="10,0,0,0"/>
                                            <TextBlock Classes="DetailLine" Text="{Binding Detail}" Margin="10,0,0,0"/>
                                            <TextBlock Classes="DetailLine" Text="{Binding Energy}" Margin="10,0,0,0"
                                                       IsVisible="{Binding Energy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Select a monster on the left to see its details."
                           Foreground="{StaticResource ChromeFgSecBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           IsVisible="{Binding ShowPlaceholder}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40,20,0"/>
              </Panel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
