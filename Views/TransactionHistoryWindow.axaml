<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="440"
        x:Class="MudPlay.Views.TransactionHistoryWindow"
        x:DataType="vm:TransactionHistoryViewModel"
        Title="Transaction History"
        Width="520" Height="440"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel LastChildFill="True">

        <!-- ============ Column header ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="120,56,*,48">
                <TextBlock Grid.Column="0" Text="Timestamp"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Type"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="Action"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="Keep" HorizontalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ============ Footer: user-driven clear ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Button Content="Clear history"
                    HorizontalAlignment="Right"
                    Command="{Binding ClearCommand}"
                    IsEnabled="{Binding !IsEmpty}"
                    ToolTip.Tip="Clear the ledger — any entries you've checked to keep are left behind"/>
        </Border>

        <!-- ============ Entries list (+ empty placeholder) ============ -->
        <Grid Background="{StaticResource ChromeBgSunkenBrush}">
            <ListBox ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Multiple">
                <ListBox.Styles>
                    <!-- Let each row's tint fill the whole entry edge-to-edge so
                         consecutive stashes read as one gold band with no gaps:
                         zero the container padding and stretch its content — the
                         Border below carries the spacing. -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:TransactionRowViewModel">
                        <!-- Stash rows wash faint gold (the map's stash-marker
                             colour), filling the whole entry; other kinds stay
                             transparent but still hit-testable for the
                             double-click → centre-on-map. -->
                        <Border Background="{Binding Kind, Converter={x:Static vm:TransactionKindBackgroundConverter.Instance}}"
                                Padding="10,5" Cursor="Hand"
                                ToolTip.Tip="Double-click to show this room on the map"
                                DoubleTapped="OnRowDoubleTapped">
                            <Grid ColumnDefinitions="120,56,*,48">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Time, StringFormat='{}{0:ddMMMyy HH:mm:ss}'}"
                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Kind}"
                                           Foreground="{StaticResource ChromeFgBrush}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <SelectableTextBlock Text="{Binding Detail}"
                                                         Foreground="{StaticResource ChromeFgBrush}"
                                                         FontFamily="{StaticResource FontMono}"
                                                         FontSize="12"
                                                         TextWrapping="Wrap"/>
                                    <SelectableTextBlock Text="{Binding Location}"
                                                         IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                         Foreground="{StaticResource ChromeFgSecBrush}"
                                                         FontFamily="{StaticResource FontMono}"
                                                         FontSize="10"
                                                         TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Keep this entry when Clear history runs. -->
                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding Keep, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip.Tip="Keep this entry — Clear history won't remove it"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No transactions yet."
                       IsVisible="{Binding IsEmpty}"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </DockPanel>
</Window>
