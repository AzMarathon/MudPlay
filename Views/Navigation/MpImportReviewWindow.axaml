<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        x:Class="MudPlay.Views.Navigation.MpImportReviewWindow"
        x:DataType="vm:MpImportReviewViewModel"
        Title="{Binding FileName, StringFormat='Import MegaMUD loop — {0}'}"
        Width="1440" Height="860" MinWidth="1100" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <!-- One table, one scrollbar: every line is a .mp step (left of the divider) and
         our translation of it (right). The header and row templates share these
         column widths, so change them together:
         #, hash, Rooms.md, move, extra, options | divider | status, room (name and
         map/room), set room, command, delay, NR, NA, RH, RM, notes marker. -->
    <Window.Styles>
        <Style Selector="TextBlock.Cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="TextBlock.Head">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.HeadCenter">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,10,1"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.Value">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="ListBox.Steps">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.Steps ListBoxItem">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="TextBox.CellEdit">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="CheckBox.Cell">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Border.Divider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6">

            <!-- ============ The two summaries ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="MegaMUD file" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="Name"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="Value" Text="{Binding Label}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="Author"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Value" Text="{Binding Author}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="Start room"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="Value" Text="{Binding StartRoomText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="Label" Text="End room"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="Value" Text="{Binding EndRoomText}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PathDetails}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="Value" Margin="0,1,16,1" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="Value" VerticalAlignment="Center" Text="{Binding RoomsMdNote}"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                        <Button Content="Load Rooms.md…" FontSize="11" Padding="8,2"
                                Command="{Binding LoadRoomsMdCommand}"
                                ToolTip.Tip="Point at the MegaMUD Rooms.md this loop was made with. Its room names carry their map/room numbers, which pin down the start room and named rooms the hashes alone can't."/>
                    </StackPanel>
                    <Border IsVisible="{Binding NeedsRoomsMd}" Background="#33E0A040" CornerRadius="3" Padding="8,4">
                        <TextBlock Classes="Value"
                                   Text="The file's name doesn't say where this loop starts, so its start room is only a guess from the room hash. Load the Rooms.md the loop was made with to pin it down."/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="Value" Foreground="#E0A040" Text="{Binding StringFormat='⚠ {0}'}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="MudPlay loop" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="Loop name" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" FontSize="11"
                                 Text="{Binding LoopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="Start room" VerticalAlignment="Center"
                                   IsVisible="{Binding HasAnchorChoice}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" FontSize="11" HorizontalAlignment="Stretch"
                                  IsVisible="{Binding HasAnchorChoice}"
                                  ItemsSource="{Binding AnchorChoices}"
                                  SelectedItem="{Binding SelectedAnchor, Mode=TwoWay}"
                                  ToolTip.Tip="Several rooms in the map data match the loop's start room. Pick the one to walk from — the list is ordered best translation first."/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="Notes"/>
                        <TextBox Grid.Row="2" Grid.Column="1" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="48"
                                 Text="{Binding Notes, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock Classes="Value" Text="{Binding TranslationSummary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- ============ Column headers ============ -->
            <Border Grid.Row="1" Padding="6,4" Background="#18FFFFFF" CornerRadius="3">
                <Grid ColumnDefinitions="34,74,150,64,*,130,9,20,1.4*,84,130,64,26,26,26,26,22">
                    <TextBlock Grid.Column="0" Classes="Head" Text="#"/>
                    <TextBlock Grid.Column="1" Classes="Head" Text="Room hash"/>
                    <TextBlock Grid.Column="2" Classes="Head" Text="Rooms.md"/>
                    <TextBlock Grid.Column="3" Classes="Head" Text="Move"/>
                    <TextBlock Grid.Column="4" Classes="Head" Text="Extra commands"/>
                    <TextBlock Grid.Column="5" Classes="Head" Text="Step options"/>
                    <Border Grid.Column="6" Classes="Divider"/>
                    <TextBlock Grid.Column="8" Classes="Head" Text="MudPlay room"/>
                    <TextBlock Grid.Column="9" Classes="Head" Text="Set room"
                               ToolTip.Tip="Type a map/room here to put a different room on this step, then Verify."/>
                    <TextBlock Grid.Column="10" Classes="Head" Text="Command"/>
                    <TextBlock Grid.Column="11" Classes="Head" Text="Delay ms"
                               ToolTip.Tip="Milliseconds to wait after the command before moving on. Ignored with no command."/>
                    <TextBlock Grid.Column="12" Classes="HeadCenter" Text="NR" ToolTip.Tip="Do not rest in this room"/>
                    <TextBlock Grid.Column="13" Classes="HeadCenter" Text="NA" ToolTip.Tip="Do not attack in this room"/>
                    <TextBlock Grid.Column="14" Classes="HeadCenter" Text="RH" ToolTip.Tip="Rest up here — HP"/>
                    <TextBlock Grid.Column="15" Classes="HeadCenter" Text="RM" ToolTip.Tip="Rest up here — mana"/>
                </Grid>
            </Border>

            <!-- ============ Steps: the file | our loop ============ -->
            <ListBox Grid.Row="2" Classes="Steps" ItemsSource="{Binding Rows}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MpTranslatedRowViewModel">
                        <Grid ColumnDefinitions="34,74,150,64,*,130,9,20,1.4*,84,130,64,26,26,26,26,22">
                            <TextBlock Grid.Column="0" Classes="Cell" Text="{Binding Number}"/>
                            <TextBlock Grid.Column="1" Classes="Cell" Text="{Binding Source.Hash}" FontFamily="monospace"/>
                            <TextBlock Grid.Column="2" Classes="Cell" Text="{Binding Source.RoomsMdName}"
                                       ToolTip.Tip="{Binding Source.RoomsMdName}"/>
                            <TextBlock Grid.Column="3" Classes="Cell" Text="{Binding Source.Action}"
                                       ToolTip.Tip="{Binding Source.Action}"/>
                            <TextBlock Grid.Column="4" Classes="Cell" Text="{Binding Source.Extra}"
                                       ToolTip.Tip="{Binding Source.Extra}"/>
                            <TextBlock Grid.Column="5" Classes="Cell" Text="{Binding Source.Flags}"
                                       ToolTip.Tip="{Binding Source.Flags}"/>
                            <Border Grid.Column="6" Classes="Divider"/>
                            <TextBlock Grid.Column="7" Classes="Cell" Text="{Binding StatusText}"
                                       ToolTip.Tip="{Binding StatusTip}"/>
                            <TextBlock Grid.Column="8" Classes="Cell"
                                       Text="{Binding RoomName}" ToolTip.Tip="{Binding StatusTip}"/>
                            <TextBox Grid.Column="9" Classes="CellEdit"
                                     Text="{Binding RoomText, Mode=TwoWay}"
                                     PlaceholderText="map/room"
                                     ToolTip.Tip="Type a map/room to put a different room on this step (clear it to go back to the translation), then press Verify."/>
                            <TextBox Grid.Column="10" Classes="CellEdit"
                                     Text="{Binding Command, Mode=TwoWay}"
                                     PlaceholderText="command"
                                     ToolTip.Tip="Sent when the loop reaches this room."/>
                            <NumericUpDown Grid.Column="11"
                                           Value="{Binding DelayMs, Mode=TwoWay}"
                                           Minimum="0" Maximum="600000" Increment="100"
                                           FormatString="0" ShowButtonSpinner="False"
                                           FontSize="11" Height="22" MinHeight="22" Padding="4,1"
                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                           ToolTip.Tip="Milliseconds to wait after the command before moving on. Ignored with no command."/>
                            <CheckBox Grid.Column="12" Classes="Cell" IsChecked="{Binding DoNotRest, Mode=TwoWay}"
                                      ToolTip.Tip="Do not rest in this room"/>
                            <CheckBox Grid.Column="13" Classes="Cell" IsChecked="{Binding DoNotAttack, Mode=TwoWay}"
                                      ToolTip.Tip="Do not attack in this room"/>
                            <CheckBox Grid.Column="14" Classes="Cell" IsChecked="{Binding RestHereHp, Mode=TwoWay}"
                                      ToolTip.Tip="Rest up here — rest until HP is back to its rest-max"/>
                            <CheckBox Grid.Column="15" Classes="Cell" IsChecked="{Binding RestHereMana, Mode=TwoWay}"
                                      ToolTip.Tip="Rest up here — rest until mana is back to its rest-max"/>
                            <Panel Grid.Column="16">
                                <TextBlock Classes="Cell" Text="⚠" Foreground="#E05050"
                                           IsVisible="{Binding Unreachable}"
                                           ToolTip.Tip="Verify found no route onward from this room — set a different room on this step or the next."/>
                                <TextBlock Classes="Cell" Text="ⓘ"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           IsVisible="{Binding HasDropped}"
                                           ToolTip.Tip="{Binding Dropped, StringFormat='Not carried over: {0}'}"/>
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Panel Grid.Row="3">
                <TextBlock Classes="Value" Text="{Binding Status}" Foreground="#E0A040"
                           IsVisible="{Binding !StatusIsGood}"/>
                <TextBlock Classes="Value" Text="{Binding Status}" Foreground="#60C060"
                           IsVisible="{Binding StatusIsGood}"/>
            </Panel>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Content="Verify loop in MudPlay" Command="{Binding VerifyCommand}"
                        ToolTip.Tip="Put in any rooms you typed, translate the steps after them again, and check MudPlay's navigation can walk the whole loop, every leg back round to the start, the way it would run it."/>
                <TextBlock Grid.Column="1" Classes="Value" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           Text="✓ matches · ≈ room differs from the recording · ↺ found again · ✎ set by you · ✗ untranslated (left out unless you set a room) · ⚠ no route onward · ⓘ what isn't carried over"/>
                <Button Grid.Column="2" Content="Reject" Command="{Binding RejectCommand}" MinWidth="90" IsCancel="True"/>
                <Button Grid.Column="3" Content="Accept" Command="{Binding AcceptCommand}" MinWidth="90"
                        Classes="Accent" IsEnabled="{Binding CanAccept}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
