<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        x:Class="MudPlay.Views.Navigation.MpImportReviewWindow"
        x:DataType="vm:MpImportReviewViewModel"
        Title="{Binding FileName, StringFormat='Import MegaMUD loop — {0}'}"
        Width="1440" Height="860" MinWidth="1100" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <!-- One table, one scrollbar: every line is a .mp step (left of the divider) and
         our translation of it (right). The header and row templates share these
         column widths, so change them together:
         #, hash, Rooms.md, move, extra, options | divider | status, set room, room
         (name and map/room), stash, command, delay, NR, NA, RH, RM, notes marker. -->
    <Window.Styles>
        <Style Selector="TextBlock.Cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="TextBlock.Head">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.HeadCenter">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,10,1"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.Value">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <!-- A step left out of the loop stays in the table, greyed. -->
        <Style Selector="Grid.StepRow.Removed">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.RowEdit">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.Steps">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.Steps ListBoxItem">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="TextBox.CellEdit">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="CheckBox.Cell">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Border.Divider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6">

            <!-- ============ The two summaries ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="MegaMUD file" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="Name"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="Value" Text="{Binding Label}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="Author"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Value" Text="{Binding Author}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="Start room"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="Value" Text="{Binding StartRoomText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="Label" Text="End room"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="Value" Text="{Binding EndRoomText}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PathDetails}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="Value" Margin="0,1,16,1" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="Value" VerticalAlignment="Center" Text="{Binding RoomsMdNote}"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                        <Button Content="Load Rooms.md…" FontSize="11" Padding="8,2"
                                Command="{Binding LoadRoomsMdCommand}"
                                ToolTip.Tip="Point at the MegaMUD Rooms.md this loop was made with. Its room names carry their map/room numbers, which pin down the start room and named rooms the hashes alone can't."/>
                    </StackPanel>
                    <Border IsVisible="{Binding NeedsRoomsMd}" Background="#33E0A040" CornerRadius="3" Padding="8,4">
                        <TextBlock Classes="Value"
                                   Text="The file's name doesn't say where this loop starts, so its start room is only a guess from the room hash. Load the Rooms.md the loop was made with to pin it down."/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="Value" Foreground="#E0A040" Text="{Binding StringFormat='⚠ {0}'}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="MudPlay loop" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="Loop name" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" FontSize="11"
                                 Text="{Binding LoopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="Start room" VerticalAlignment="Center"
                                   IsVisible="{Binding HasAnchorChoice}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" FontSize="11" HorizontalAlignment="Stretch"
                                  IsVisible="{Binding HasAnchorChoice}"
                                  ItemsSource="{Binding AnchorChoices}"
                                  SelectedItem="{Binding SelectedAnchor, Mode=TwoWay}"
                                  ToolTip.Tip="Several rooms in the map data match the loop's start room. Pick the one to walk from — the list is ordered best translation first."/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="Notes"/>
                        <TextBox Grid.Row="2" Grid.Column="1" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="48"
                                 Text="{Binding Notes, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock Classes="Value" Text="{Binding TranslationSummary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- ============ Column headers ============ -->
            <Border Grid.Row="1" Padding="6,4" Background="#18FFFFFF" CornerRadius="3">
                <Grid ColumnDefinitions="34,74,150,64,*,130,9,20,84,1.4*,44,130,64,26,26,26,26,22,92">
                    <TextBlock Grid.Column="0" Classes="Head" Text="#"/>
                    <TextBlock Grid.Column="1" Classes="Head" Text="Room hash"/>
                    <TextBlock Grid.Column="2" Classes="Head" Text="Rooms.md"/>
                    <TextBlock Grid.Column="3" Classes="Head" Text="Move"/>
                    <TextBlock Grid.Column="4" Classes="Head" Text="Extra commands"/>
                    <TextBlock Grid.Column="5" Classes="Head" Text="Step options"/>
                    <Border Grid.Column="6" Classes="Divider"/>
                    <TextBlock Grid.Column="8" Classes="Head" Text="Set room"
                               ToolTip.Tip="Type a map/room here to put a different room on this step, then Verify."/>
                    <TextBlock Grid.Column="9" Classes="Head" Text="MudPlay room"/>
                    <TextBlock Grid.Column="10" Classes="HeadCenter" Text="Stash"
                               ToolTip.Tip="Add this room to your stash rooms when you accept the loop. Ticked where MegaMUD marked a stash point."/>
                    <TextBlock Grid.Column="11" Classes="Head" Text="Command"/>
                    <TextBlock Grid.Column="12" Classes="Head" Text="Delay ms"
                               ToolTip.Tip="Milliseconds to wait after the command before moving on. Ignored with no command."/>
                    <TextBlock Grid.Column="13" Classes="HeadCenter" Text="NR" ToolTip.Tip="Do not rest in this room"/>
                    <TextBlock Grid.Column="14" Classes="HeadCenter" Text="NA" ToolTip.Tip="Do not attack in this room"/>
                    <TextBlock Grid.Column="15" Classes="HeadCenter" Text="RH" ToolTip.Tip="Rest up here — HP"/>
                    <TextBlock Grid.Column="16" Classes="HeadCenter" Text="RM" ToolTip.Tip="Rest up here — mana"/>
                    <TextBlock Grid.Column="18" Classes="HeadCenter" Text="Edit"
                               ToolTip.Tip="✕ leave a step out of the loop (↺ puts it back) · + add a room below · ▲ ▼ move the row. The map redraws after each change; press Verify to check the loop still walks."/>
                </Grid>
            </Border>

            <!-- ============ Steps: the file | our loop ============ -->
            <ListBox Grid.Row="2" Classes="Steps" ItemsSource="{Binding Rows}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MpTranslatedRowViewModel">
                        <Grid Classes="StepRow" Classes.Removed="{Binding IsRemoved}"
                              ColumnDefinitions="34,74,150,64,*,130,9,20,84,1.4*,44,130,64,26,26,26,26,22,92">
                            <TextBlock Grid.Column="0" Classes="Cell" Text="{Binding NumberText}"/>
                            <TextBlock Grid.Column="1" Classes="Cell" Text="{Binding Source.Hash}" FontFamily="monospace"/>
                            <TextBlock Grid.Column="2" Classes="Cell" Text="{Binding Source.RoomsMdName}"
                                       ToolTip.Tip="{Binding Source.RoomsMdName}"/>
                            <TextBlock Grid.Column="3" Classes="Cell" Text="{Binding Source.Action}"
                                       ToolTip.Tip="{Binding Source.Action}"/>
                            <TextBlock Grid.Column="4" Classes="Cell" Text="{Binding Source.Extra}"
                                       ToolTip.Tip="{Binding Source.Extra}"/>
                            <TextBlock Grid.Column="5" Classes="Cell" Text="{Binding Source.Flags}"
                                       ToolTip.Tip="{Binding Source.Flags}"/>
                            <Border Grid.Column="6" Classes="Divider"/>
                            <TextBlock Grid.Column="7" Classes="Cell" Text="{Binding StatusText}"
                                       ToolTip.Tip="{Binding StatusTip}"/>
                            <TextBox Grid.Column="8" Classes="CellEdit"
                                     Text="{Binding RoomText, Mode=TwoWay}"
                                     PlaceholderText="map/room"
                                     ToolTip.Tip="Type a map/room to put a different room on this step (clear it to go back to the translation), then press Verify."/>
                            <TextBlock Grid.Column="9" Classes="Cell"
                                       Text="{Binding RoomName}" ToolTip.Tip="{Binding StatusTip}"/>
                            <CheckBox Grid.Column="10" Classes="Cell" IsChecked="{Binding MarkStash, Mode=TwoWay}"
                                      ToolTip.Tip="Add this room to your stash rooms when you accept the loop"/>
                            <TextBox Grid.Column="11" Classes="CellEdit"
                                     Text="{Binding Command, Mode=TwoWay}"
                                     PlaceholderText="command"
                                     ToolTip.Tip="Sent when the loop reaches this room."/>
                            <NumericUpDown Grid.Column="12"
                                           Value="{Binding DelayMs, Mode=TwoWay}"
                                           Minimum="0" Maximum="600000" Increment="100"
                                           FormatString="0" ShowButtonSpinner="False"
                                           FontSize="11" Height="22" MinHeight="22" Padding="4,0"
                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                           VerticalContentAlignment="Center"
                                           ToolTip.Tip="Milliseconds to wait after the command before moving on. Ignored with no command."/>
                            <CheckBox Grid.Column="13" Classes="Cell" IsChecked="{Binding DoNotRest, Mode=TwoWay}"
                                      ToolTip.Tip="Do not rest in this room"/>
                            <CheckBox Grid.Column="14" Classes="Cell" IsChecked="{Binding DoNotAttack, Mode=TwoWay}"
                                      ToolTip.Tip="Do not attack in this room"/>
                            <CheckBox Grid.Column="15" Classes="Cell" IsChecked="{Binding RestHereHp, Mode=TwoWay}"
                                      ToolTip.Tip="Rest up here — rest until HP is back to its rest-max"/>
                            <CheckBox Grid.Column="16" Classes="Cell" IsChecked="{Binding RestHereMana, Mode=TwoWay}"
                                      ToolTip.Tip="Rest up here — rest until mana is back to its rest-max"/>
                            <Panel Grid.Column="17">
                                <TextBlock Classes="Cell" Text="⚠" Foreground="#E05050"
                                           IsVisible="{Binding Unreachable}"
                                           ToolTip.Tip="Verify found no route onward from this room — set a different room on this step or the next."/>
                                <TextBlock Classes="Cell" Text="ⓘ"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           IsVisible="{Binding HasDropped}"
                                           ToolTip.Tip="{Binding Dropped, StringFormat='Not carried over: {0}'}"/>
                            </Panel>
                            <StackPanel Grid.Column="18" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <Button Classes="RowEdit" Content="{Binding RemoveGlyph}"
                                        ToolTip.Tip="{Binding RemoveTip}"
                                        Command="{Binding $parent[ListBox].((vm:MpImportReviewViewModel)DataContext).RemoveRowCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="RowEdit" Content="+"
                                        ToolTip.Tip="Add a room below this row — type its map/room into the new row's Set room box"
                                        Command="{Binding $parent[ListBox].((vm:MpImportReviewViewModel)DataContext).InsertBelowCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="RowEdit" Content="▲" ToolTip.Tip="Move this row up"
                                        Command="{Binding $parent[ListBox].((vm:MpImportReviewViewModel)DataContext).MoveUpCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="RowEdit" Content="▼" ToolTip.Tip="Move this row down"
                                        Command="{Binding $parent[ListBox].((vm:MpImportReviewViewModel)DataContext).MoveDownCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Panel Grid.Row="3">
                <TextBlock Classes="Value" Text="{Binding Status}" Foreground="#E0A040"
                           IsVisible="{Binding !StatusIsGood}"/>
                <TextBlock Classes="Value" Text="{Binding Status}" Foreground="#60C060"
                           IsVisible="{Binding StatusIsGood}"/>
            </Panel>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Content="Verify loop in MudPlay" Command="{Binding VerifyCommand}"
                        ToolTip.Tip="Put in any rooms you typed, translate the steps after them again, and check MudPlay's navigation can walk the whole loop, every leg back round to the start, the way it would run it."/>
                <!-- Map comparison: the colours match MapControl's Comparison pens. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <CheckBox Content="Display on map" IsChecked="{Binding DisplayOnMap, Mode=TwoWay}" FontSize="11"
                              ToolTip.Tip="Draw both versions of this loop on the Navigation map. Orange (wide): MegaMUD's recorded moves followed literally from the start room on our map — a red ✕ marks a room where a recorded step has no way on in our data, and the line carries on from there. Cyan (thin): the loop as converted here, walked the way MudPlay would run it. Where they agree the cyan runs inside the orange; where they part, you see two lines. Updates as you change rooms and Verify; clears when this window closes."/>
                    <Border Width="18" Height="6" CornerRadius="3" Background="#B3FF9800" VerticalAlignment="Center"
                            IsVisible="{Binding DisplayOnMap}"/>
                    <TextBlock Classes="Value" Text="MegaMUD recording" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding DisplayOnMap}"/>
                    <Border Width="18" Height="3" CornerRadius="1" Background="#00E5FF" VerticalAlignment="Center"
                            IsVisible="{Binding DisplayOnMap}"/>
                    <TextBlock Classes="Value" Text="MudPlay conversion" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding DisplayOnMap}"/>
                    <TextBlock Classes="Value" Text="✕ recorded step can't be followed" FontSize="11" Foreground="#FF3B3B"
                               VerticalAlignment="Center" IsVisible="{Binding DisplayOnMap}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="Value" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           Text="✓ matches · ≈ room differs from the recording · ↺ found again · ✎ set by you · + added by you · ✗ untranslated (left out unless you set a room) · greyed: left out · ⚠ no route onward · ⓘ what isn't carried over"/>
                <Button Grid.Column="3" Content="Reject" Command="{Binding RejectCommand}" MinWidth="90" IsCancel="True"/>
                <Button Grid.Column="4" Content="Accept" Command="{Binding AcceptCommand}" MinWidth="90"
                        Classes="Accent" IsEnabled="{Binding CanAccept}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
