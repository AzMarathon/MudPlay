<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="240"
        x:Class="FujinTerm.Views.Navigation.FavoriteEditDialog"
        x:DataType="vm:FavoriteEditDialogViewModel"
        Title="Edit favourite"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <StackPanel Spacing="8">
            <TextBlock Text="Edit the name, or change the map / room to re-point this favourite at a different room."
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,6,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="NameBox"
                         Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="(blank = room name)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Map:" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding Map, Mode=TwoWay}"
                               Minimum="0" Maximum="9999" Increment="1"
                               FormatString="0" HorizontalAlignment="Left" Width="140"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Room:" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Value="{Binding Room, Mode=TwoWay}"
                               Minimum="0" Maximum="999999" Increment="1"
                               FormatString="0" HorizontalAlignment="Left" Width="140"/>
            </Grid>

            <TextBlock Text="{Binding RoomNamePreview}"
                       Foreground="{StaticResource ChromeFgSecBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Margin="60,0,0,0"/>

            <CheckBox Content="★  Show in the right-click Favorites menu"
                      IsChecked="{Binding Starred, Mode=TwoWay}"
                      IsEnabled="{Binding CanToggleStar}"
                      Margin="0,6,0,0"/>
            <TextBlock Text="{Binding StarNote}"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,-2,0,0"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Save" Width="100"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"/>
                <Button Content="Cancel" Width="100"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
