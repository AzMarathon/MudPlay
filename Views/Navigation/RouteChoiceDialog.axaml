<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        x:Class="MudPlay.Views.Navigation.RouteChoiceDialog"
        x:DataType="vm:RouteChoiceDialogViewModel"
        Title="Choose a route"
        Width="620" MinWidth="560" MinHeight="240" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- A "danger" card (skip the safe prep: cross unprotected / send it, or
             plow through rooms you marked Avoid) reads as a soft-red tint so the
             risky option is obvious at a glance. Defined BEFORE the selected style
             so a picked danger card still shows the amber selection over the red. -->
        <Style Selector="Button.route.danger">
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentRedSoftBrush}"/>
        </Style>
        <Style Selector="Button.route.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentRedSoftBrush}"/>
        </Style>

        <!-- The Paradigm token card reads as a soft cyan-blue — deliberately distinct
             from the red danger tint and the plain/amber cards, so a token route can't
             be mistaken for a normal or a risky one. Defined BEFORE the selected style
             so a picked token card still shows the amber selection over the blue. -->
        <Style Selector="Button.route.token">
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentCyanSoftBrush}"/>
        </Style>
        <Style Selector="Button.route.token:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentCyanSoftBrush}"/>
        </Style>

        <!-- A selected route card reads as the amber brand accent: an amber
             border over a soft-amber fill, so the previewed route stands out
             from the unselected one. -->
        <Style Selector="Button.route.selected">
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentAmberSoftBrush}"/>
        </Style>
        <Style Selector="Button.route.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentAmberSoftBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <!-- Row 1 (the card list) is Auto, not star: with SizeToContent="Height" a
             star row gets pinned to the window's initial (Calculating-phase) height
             and then absorbs the taller card content when it swaps in, so the window
             never grows and the cards overflow onto the buttons. An Auto row always
             measures to its content, so the window resizes to fit once the cards
             populate. The Calculating placeholder carries its own MinHeight to keep
             the centered look while planning runs. -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0"
                       Text="{Binding Heading}"
                       VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource ChromeFgBrush}"/>

            <!-- While route planning runs on a background thread (the idle path), the
                 window is up but its options aren't computed yet — show a centered
                 "Calculating…" in place of the card list so it doesn't feel like
                 nothing's happening; Populate swaps the cards in when planning returns.
                 The MinHeight holds the placeholder open so the text sits centred in a
                 stable-sized window before the cards (which drive the real height) arrive. -->
            <Panel Grid.Row="1" MinHeight="130" IsVisible="{Binding IsCalculating}">
                <TextBlock Text="Calculating…"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource ChromeFgSecBrush}"/>
            </Panel>

            <StackPanel Grid.Row="1" Spacing="10"
                        IsVisible="{Binding ShowOptions}">
                <TextBlock Text="Options:"
                           FontSize="11"
                           Foreground="{StaticResource ChromeFgSecBrush}"/>
                <Button Classes="route"
                        Classes.selected="{Binding IsFreeSelected}"
                        Command="{Binding SelectFreeCommand}"
                        IsVisible="{Binding ShowFreeCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <TextBlock Text="{Binding FreeSummary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                </Button>

                <!-- Paradigm token card (blue): shown alongside the plain walk when a
                     held transport token reaches the destination faster. Never
                     pre-selected — using a token costs gold + a charge + wipes buffs. -->
                <Button Classes="route token"
                        Classes.selected="{Binding IsTokenSelected}"
                        Command="{Binding SelectTokenCommand}"
                        IsVisible="{Binding ShowTokenCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TokenSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding TokenDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </Button>

                <Button Classes="route"
                        Classes.selected="{Binding IsGatedSelected}"
                        Classes.danger="{Binding GatedIsDanger}"
                        Command="{Binding SelectGatedCommand}"
                        IsVisible="{Binding ShowGatedCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding GatedSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding GatedDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </Button>

                <!-- Non-tinted (safe) cards first — Free / Obtain above — then Search,
                     then the red-tinted risky cards (Cross-unprotected, Route-through-
                     avoided) last, so the safe picks read before the dangerous ones. -->
                <Button Classes="route"
                        Classes.selected="{Binding IsSearchSelected}"
                        Command="{Binding SelectSearchCommand}"
                        IsVisible="{Binding ShowSearchCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SearchSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding SearchDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </Button>

                <Button Classes="route"
                        Classes.selected="{Binding IsSendItSelected}"
                        Classes.danger="{Binding SendItIsDanger}"
                        Command="{Binding SelectSendItCommand}"
                        IsVisible="{Binding ShowSendItCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SendItSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding SendItDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </Button>

                <Button Classes="route"
                        Classes.selected="{Binding IsAvoidAltSelected}"
                        Classes.danger="{Binding AvoidAltIsDanger}"
                        Command="{Binding SelectAvoidAltCommand}"
                        IsVisible="{Binding ShowAvoidAltCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding AvoidAltSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding AvoidAltDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </Button>

                <Button Classes="route"
                        Classes.selected="{Binding IsShortcutSelected}"
                        Command="{Binding SelectShortcutCommand}"
                        IsVisible="{Binding ShowShortcutCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ShortcutSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding ShortcutDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding Footnote}"
                       IsVisible="{Binding ShowOptions}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ChromeFgSecBrush}"/>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                <!-- Details…: bottom-left, enabled once a route is picked. Opens the
                     shared route-details browse window for the selected route — the
                     full step plan with each room's monsters, hazards, and item gates
                     linked to their records. Richer than the Show-steps flyout. -->
                <Button Grid.Column="0"
                        Content="Details…"
                        Command="{Binding ShowDetailsCommand}"
                        FontSize="11" Padding="10,4"
                        HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsCancel="True" MinWidth="80"/>
                    <Button Content="Go"
                            Command="{Binding GoCommand}"
                            IsDefault="True" MinWidth="80"
                            Classes="accent"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
