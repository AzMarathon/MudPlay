<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        x:Class="MudPlay.Views.Navigation.RouteChoiceDialog"
        x:DataType="vm:RouteChoiceDialogViewModel"
        Title="Choose a route"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- A selected route card reads as the amber brand accent: an amber
             border over a soft-amber fill, so the previewed route stands out
             from the unselected one. -->
        <Style Selector="Button.route.selected">
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentAmberSoftBrush}"/>
        </Style>
        <Style Selector="Button.route.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentAmberSoftBrush}"/>
        </Style>
        <!-- Acquire steps (buy/ask/hunt an item to cross a gate) read amber to
             stand apart from the plain move/detour rows in the step flyout. -->
        <Style Selector="TextBlock.acquire">
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0"
                       Text="{Binding Heading}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource ChromeFgBrush}"/>

            <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center">
                <Button Classes="route"
                        Classes.selected="{Binding IsFreeSelected}"
                        Command="{Binding SelectFreeCommand}"
                        IsEnabled="{Binding HasFreeRoute}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <TextBlock Text="{Binding FreeSummary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                </Button>

                <Button Classes="route"
                        Classes.selected="{Binding IsGatedSelected}"
                        Command="{Binding SelectGatedCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding GatedSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="{Binding GatedDetail}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    </StackPanel>
                </Button>

                <Button Classes="route"
                        Classes.selected="{Binding IsSendItSelected}"
                        Command="{Binding SelectSendItCommand}"
                        IsVisible="{Binding ShowSendItCard}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="1"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SendItSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <TextBlock Text="Crosses the gates as-is — nothing acquired; you must already carry what's needed."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding Footnote}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ChromeFgMutedBrush}"/>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Show steps: enabled once a route is picked; opens a flyout with
                     the full start-to-finish command sequence for that route,
                     detours and item-acquisitions included. -->
                <Button Grid.Column="0"
                        Content="Show steps…"
                        IsEnabled="{Binding CanShowSteps}"
                        MinWidth="90">
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <Border MaxWidth="440" Padding="4">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Full step plan (detours and buys included)"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                    <ScrollViewer MaxHeight="340"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CurrentStepRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RouteStepRow">
                                                    <TextBlock Text="{Binding Line}"
                                                               Classes.acquire="{Binding IsAcquire}"
                                                               FontFamily="{StaticResource FontMono}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="Item buys are fetched automatically when the run reaches the gate; the walk to the shop is planned then."
                                               FontSize="10" TextWrapping="Wrap" MaxWidth="420"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Grid.Column="2"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
                <Button Grid.Column="3"
                        Content="Go"
                        Command="{Binding GoCommand}"
                        IsDefault="True" MinWidth="80"
                        Classes="accent"/>
            </Grid>
        </Grid>
    </Border>
</Window>
