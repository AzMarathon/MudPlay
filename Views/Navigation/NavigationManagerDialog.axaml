<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="540"
        x:Class="MudPlay.Views.Navigation.NavigationManagerDialog"
        x:DataType="vm:NavigationManagerDialogViewModel"
        Title="Navigation Management"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Border.ManagerRow">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding"      Value="6,3"/>
            <Setter Property="Margin"       Value="0,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Background"   Value="Transparent"/>
        </Style>
        <Style Selector="Border.ManagerRow TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

            <!-- Draft section — visible only while the NavigationWindow
                 is in LoopBuild mode. This is the explicit Save surface
                 (Run on the main window is transient and never writes
                 to disk per UX direction). -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8"
                    IsVisible="{Binding HasDraft}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                CornerRadius="3" Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentAmberBrush}">
                            <TextBlock Text="DRAFT"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#0E0E0E"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource ChromeFgSecBrush}">
                            <Run Text="{Binding Draft.Clicks.Count, FallbackValue=0}"/>
                            <Run Text=" room(s) clicked · "/>
                            <Run Text="{Binding Draft.ExpandedStepCount, FallbackValue=0}"/>
                            <Run Text=" step(s)"/>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="Name:"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Draft.ProposedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11"/>
                        <Button Grid.Column="2"
                                Content="Save"
                                Command="{Binding SaveDraftCommand}"
                                IsEnabled="{Binding Draft.CanSave, FallbackValue=False}"
                                MinWidth="70"/>
                        <Button Grid.Column="3"
                                Content="Discard"
                                Command="{Binding DiscardDraftCommand}"
                                Foreground="{StaticResource AccentRedBrush}"
                                MinWidth="70"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Body: a tab per saved-navigation kind. Tab 1 = the combined
                 Loops + Auto-Lair folder tree (they share one on-disk folder
                 layout). Tab 2 = GOTO favourites, with their own profile-backed
                 folder set (the CRUD surface the pre-rework window hosted). -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Loops &amp; Auto-Lairs">
            <Border BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{StaticResource ChromeBgElevBrush}"
                            Padding="6,3">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0"
                                       Text="Loops &amp; Auto-Lairs"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource ChromeFgBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- New Folder: creates an empty root folder
                                 (shared between loops and Auto-Lair setups).
                                 Subfolders / rename / delete live on the
                                 per-folder right-click menu. -->
                            <Button Grid.Column="1"
                                    Content="New Folder"
                                    FontSize="10"
                                    Padding="8,2"
                                    Command="{Binding NewFolderCommand}"
                                    ToolTip.Tip="Create a new folder at the root (shared between loops and Auto-Lair setups)."/>
                            <!-- New Loop: opens the LoopEditor in create
                                 mode. Away-from-the-map flow — type a name
                                 + add rooms via the editor's search box. -->
                            <Button Grid.Column="2"
                                    Content="New Loop"
                                    FontSize="10"
                                    Padding="8,2"
                                    Command="{Binding NewLoopCommand}"
                                    ToolTip.Tip="Open the loop editor on an empty loop."/>
                            <!-- New Lair: opens the LairEditor in create
                                 mode. Distinct editor so the correct
                                 walking-file type is authored. -->
                            <Button Grid.Column="3"
                                    Content="New Lair"
                                    FontSize="10"
                                    Padding="8,2"
                                    Command="{Binding NewLairCommand}"
                                    ToolTip.Tip="Create a new Auto-Lair setup from scratch."/>
                            <!-- Import .mp: file picker → MegaMUD .mp loop
                                 file → anchor resolver → LoopEditor with
                                 the imported loop pre-filled. -->
                            <Button Grid.Column="4"
                                    Content="Import .mp"
                                    FontSize="10"
                                    Padding="8,2"
                                    Command="{Binding ImportMpCommand}"
                                    ToolTip.Tip="Import a MegaMUD .mp loop file. Path-style .mp files (one-way A→B) are rejected."/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Right margin reserves a gutter for the overlay
                             vertical scrollbar (Fluent floats it over the
                             viewport's right edge) so it can't sit on top of
                             the per-loop / per-lair Run + action buttons in the
                             tree rows below. -->
                        <StackPanel Margin="0,0,14,0">
                            <!-- .mp import status line — empty until the
                                 user clicks "Import .mp" the first time.
                                 Persists for the lifetime of the dialog
                                 so the user can re-read the last
                                 attempt's reason. -->
                            <Border IsVisible="{Binding HasImportStatus}"
                                    Padding="6,4"
                                    Margin="0,0,0,2"
                                    Background="{StaticResource ChromeBgElevBrush}">
                                <TextBlock Text="{Binding ImportStatus}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource ChromeFgSecBrush}"/>
                            </Border>
                            <!-- Running-loop save row — visible only when
                                 the runner is actually driving a loop.
                                 Editable name + Save persists the in-
                                 flight loop without stopping it. -->
                            <Border Padding="6,4"
                                    Margin="0,0,0,2"
                                    Background="{StaticResource ChromeBgElevBrush}"
                                    IsVisible="{Binding HasRunningLoop}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Border Grid.Column="0"
                                            CornerRadius="3" Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentGreenBrush}">
                                        <TextBlock Text="RUNNING"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Foreground="#0E0E0E"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding RunningLoopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11"/>
                                    <Button Grid.Column="2"
                                            Content="Save"
                                            FontSize="10"
                                            Padding="8,2"
                                            Command="{Binding SaveRunningLoopCommand}"
                                            ToolTip.Tip="Persist the currently-running loop to disk under the typed name."/>
                                </Grid>
                            </Border>
                            <TextBox Classes="clearable" Text="{Binding WalkFilter, Mode=TwoWay}"
                                     PlaceholderText="Filter loops / lairs…"
                                     FontSize="11" Margin="0,0,0,3"
                                     IsVisible="{Binding HasWalkItems}"/>
                            <TextBlock Text="No loops or Auto-Lair setups saved on this BBS yet — build one from the Navigation map, or click New Loop / New Lair."
                                       Padding="8"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       IsVisible="{Binding !HasWalkItems}"/>
                            <TextBlock Text="No loops or lairs match the filter."
                                       Padding="8"
                                       FontSize="11"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       IsVisible="{Binding HasNoWalkMatches}"/>
                            <!-- Rendered FLAT: folders and their open children are all
                                 uniform-height NavFlatRow rows, NOT a nested TreeView where
                                 an expanded folder is one giant item that wrecks the
                                 virtualized scrollbar and drifts on expand. MaxHeight +
                                 VirtualizingStackPanel bound the viewport so a broad filter
                                 match virtualizes. See the rail's trees. -->
                            <ListBox Name="WalkTreeView"
                                     ItemsSource="{Binding WalkRows}"
                                     IsVisible="{Binding HasWalkTree}"
                                     Background="Transparent"
                                     Padding="0,0,14,0"
                                     MaxHeight="440"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     DragDrop.AllowDrop="True">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <!-- Strip the ListBoxItem chrome so rows read like tree
                                         rows: no padding, no selection fill, full width. -->
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListBox.Styles>
                                <!-- Root-level right-click creates a folder
                                     at the root (shared between loops and
                                     Auto-Lair setups). -->
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="New folder…"
                                                  Command="{Binding NewFolderCommand}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.DataTemplates>
                                    <!-- Flat-row wrapper: depth indent + a chevron for folders,
                                         then the item's own row template via the ContentControl. -->
                                    <DataTemplate DataType="vm:NavFlatRow">
                                        <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}" Background="Transparent">
                                            <Button Grid.Column="0"
                                                    Width="16" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Foreground="{StaticResource ChromeFgMutedBrush}"
                                                    IsVisible="{Binding IsFolder}"
                                                    Content="{Binding ChevronGlyph}"
                                                    ToolTip.Tip="Expand / collapse"
                                                    Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).ToggleFolderCommand}"
                                                    CommandParameter="{Binding Folder}"/>
                                            <ContentControl Grid.Column="1" Content="{Binding Item}"/>
                                        </Grid>
                                    </DataTemplate>
                                    <!-- Folder header — clicking the name toggles it too. -->
                                    <DataTemplate DataType="vm:NavFolderNodeViewModel">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).ToggleFolderCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Classes="ManagerRow" Background="Transparent">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0"
                                                               Text="📁"
                                                               FontSize="14"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentVioletBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="New subfolder…"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).NewFolderCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Rename folder…"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RenameFolderCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Delete folder"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteFolderCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                    <!-- Loop leaf. -->
                                    <DataTemplate DataType="vm:ManagerLoopRow">
                                        <Border Classes="ManagerRow" Background="Transparent" Tag="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" MinWidth="0">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentGreenBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding WaypointCount}"/>
                                                        <Run Text=" wpt"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Run"
                                                        FontSize="10"
                                                        Padding="8,2"
                                                        Foreground="{StaticResource AccentGreenBrush}"
                                                        ToolTip.Tip="Run this loop now (no map needed)"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RunLoopCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2"
                                                        Content="Load"
                                                        FontSize="10"
                                                        Padding="8,2"
                                                        ToolTip.Tip="Stage this loop as active; start it later from the toolbar"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).LoadLoopCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="3"
                                                        Content="Edit"
                                                        FontSize="10"
                                                        Padding="8,2"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).EditLoopCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4"
                                                        Content="✕"
                                                        FontSize="10"
                                                        Padding="6,2"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTip.Tip="Delete loop"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteLoopCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Run now"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RunLoopCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Load (stage as active)"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).LoadLoopCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Edit…"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).EditLoopCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move to folder…"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).MoveLoopCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteLoopCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        </Border>
                                    </DataTemplate>
                                    <!-- Auto-Lair leaf. -->
                                    <DataTemplate DataType="vm:ManagerLairSetupRow">
                                        <Border Classes="ManagerRow" Background="Transparent" Tag="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                                                  ColumnSpacing="6" MinWidth="0">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AccentAmberBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding MarkerCount}"/>
                                                        <Run Text=" lair(s) · "/>
                                                        <Run Text="{Binding Notes}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Run / Load / Edit / ✕ delete — same row shape
                                                     as the loop rows. Run loads this setup's
                                                     markers into the scheduler and starts it;
                                                     Load stages the markers without starting. -->
                                                <Button Grid.Column="1"
                                                        Content="Run" FontSize="10"
                                                        Padding="8,2"
                                                        Foreground="{StaticResource AccentGreenBrush}"
                                                        ToolTip.Tip="Run this Auto-Lair setup now (no map needed)"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RunLairSetupCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2"
                                                        Content="Load" FontSize="10"
                                                        Padding="8,2"
                                                        ToolTip.Tip="Stage this setup's markers; start it later"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).LoadLairSetupCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="3"
                                                        Content="Edit" FontSize="10"
                                                        Padding="8,2"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).EditLairSetupCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4"
                                                        Content="✕" FontSize="10"
                                                        Padding="6,2"
                                                        ToolTip.Tip="Delete this setup"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteLairSetupCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Run now"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RunLairSetupCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Load (stage markers)"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).LoadLairSetupCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Edit…"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).EditLairSetupCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move to folder…"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).MoveLairCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteLairSetupCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
                </TabItem>

                <!-- ============ Go To favourites tab ============ -->
                <TabItem Header="Go To" IsVisible="{Binding HasGotoTab}">
                    <Border BorderBrush="{StaticResource ChromeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Background="{StaticResource ChromeBgElevBrush}"
                                    Padding="6,3">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Text="GOTO favourites"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource ChromeFgBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="New Folder"
                                            FontSize="10" Padding="8,2"
                                            Command="{Binding NewGotoFolderCommand}"
                                            ToolTip.Tip="Create a new GOTO folder at the root."/>
                                    <Button Grid.Column="2"
                                            Content="Add"
                                            FontSize="10" Padding="8,2"
                                            Command="{Binding AddFavoriteCommand}"
                                            ToolTip.Tip="Add a room as a favourite — search by name or enter a map/room number."/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBox Classes="clearable" Text="{Binding GotoFilter, Mode=TwoWay}"
                                             PlaceholderText="Filter favourites…"
                                             FontSize="11" Margin="0,0,0,3"
                                             IsVisible="{Binding HasFavorites}"/>
                                    <TextBlock Text="No favourites yet — click Add, or right-click a room on the map → Add to favorites."
                                               Padding="8" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               IsVisible="{Binding !HasFavorites}"/>
                                    <TextBlock Text="No favourites match the filter."
                                               Padding="8" FontSize="11"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               IsVisible="{Binding HasNoGotoMatches}"/>
                                    <!-- Rendered FLAT (uniform-height NavFlatRow rows), collapsed
                                         at rest — see the Loops tab tree for why. -->
                                    <ListBox Name="GotoTreeView"
                                             ItemsSource="{Binding FavoriteRows}"
                                             IsVisible="{Binding HasFavoriteTree}"
                                             Background="Transparent"
                                             Padding="0,0,14,0"
                                             MaxHeight="440"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             DragDrop.AllowDrop="True">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <!-- Root-level right-click → new GOTO folder / add favourite. -->
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="New folder…"
                                                          Command="{Binding NewGotoFolderCommand}"/>
                                                <MenuItem Header="Add favourite…"
                                                          Command="{Binding AddFavoriteCommand}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.DataTemplates>
                                            <!-- Flat-row wrapper: depth indent + a chevron for folders,
                                                 then the item's own row template via the ContentControl. -->
                                            <DataTemplate DataType="vm:NavFlatRow">
                                                <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}" Background="Transparent">
                                                    <Button Grid.Column="0"
                                                            Width="16" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            Foreground="{StaticResource ChromeFgMutedBrush}"
                                                            IsVisible="{Binding IsFolder}"
                                                            Content="{Binding ChevronGlyph}"
                                                            ToolTip.Tip="Expand / collapse"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).ToggleFolderCommand}"
                                                            CommandParameter="{Binding Folder}"/>
                                                    <ContentControl Grid.Column="1" Content="{Binding Item}"/>
                                                </Grid>
                                            </DataTemplate>
                                            <!-- Folder header — the 📁+name toggles; the ✎/✕ buttons
                                                 sit alongside (siblings, not nested in the toggle). -->
                                            <DataTemplate DataType="vm:NavFolderNodeViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                    <Button Grid.Column="0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).ToggleFolderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Border Classes="ManagerRow" Background="Transparent">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="📁" FontSize="14"
                                                                           Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource AccentVioletBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="New subfolder…"
                                                                          Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).NewGotoFolderCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Rename folder…"
                                                                          Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RenameGotoFolderCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Delete folder"
                                                                          Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteGotoFolderCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Content="✎" FontSize="10" Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Rename folder"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).RenameGotoFolderCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2"
                                                            Content="✕" FontSize="10" Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource AccentRedBrush}"
                                                            ToolTip.Tip="Delete folder (its contents move up one level)"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteGotoFolderCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                            <!-- Favourite leaf — Walk / Edit / delete. -->
                                            <DataTemplate DataType="vm:FavoriteRowViewModel">
                                                <Border Classes="ManagerRow" Background="Transparent" Tag="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" MinWidth="0">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="★"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsStarred}"
                                                                   Foreground="{StaticResource AccentAmberBrush}"
                                                                   ToolTip.Tip="In the right-click Favorites menu"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding LabelWithKey}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource ChromeFgBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="2"
                                                                Content="Walk" FontSize="10" Padding="8,2"
                                                                Foreground="{StaticResource AccentGreenBrush}"
                                                                ToolTip.Tip="Walk to this favourite now (closes this window)"
                                                                Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).WalkToFavoriteCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3"
                                                                Content="Edit" FontSize="10" Padding="8,2"
                                                                ToolTip.Tip="Edit favourite (name / map / room)"
                                                                Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).EditFavoriteCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="4"
                                                                Content="✕" FontSize="10" Padding="6,2"
                                                                Foreground="{StaticResource AccentRedBrush}"
                                                                ToolTip.Tip="Delete favourite"
                                                                Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteFavoriteCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Walk here"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).WalkToFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Edit…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).EditFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Move to folder…"
                                                                      IsVisible="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).HasFolders}"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).MoveFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Delete"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationManagerDialogViewModel)DataContext).DeleteFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.DataTemplates>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Footer — walk-to search box + Run on the left, Close on
                 the right. Type / pick a room, hit Run: the dialog closes
                 and the walker heads there. The dropdown floats above the
                 box (its own Grid.Row="1" overlay anchored bottom) so it
                 doesn't shove the footer around. -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Classes="clearable"
                         Name="WalkToBox"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsVisible="{Binding HasWalkToSearch}"
                         PlaceholderText="Walk to room — search name or map/room…"
                         FontSize="11"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Run"
                        IsVisible="{Binding HasWalkToSearch}"
                        Foreground="{StaticResource AccentGreenBrush}"
                        Command="{Binding RunSearchCommand}"
                        ToolTip.Tip="Walk to the searched room and close this window"
                        MinWidth="70"/>
                <Button Grid.Column="2"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        IsCancel="True" MinWidth="80"/>
            </Grid>

            <!-- Walk-to search dropdown — floats over the body, anchored to
                 the footer's left edge. Hidden until matches exist. -->
            <Border Grid.Row="1"
                    IsVisible="{Binding HasSearchResults}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="0,0,0,2"
                    Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Width="320" MaxHeight="260">
                <ListBox ItemsSource="{Binding SearchResults}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomSearchResult">
                            <Border Padding="8,5"
                                    PointerPressed="OnWalkToResultClicked"
                                    Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="{Binding PrimaryLine}"
                                               FontSize="11"
                                               Foreground="{StaticResource ChromeFgBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SecondaryLine}"
                                               FontSize="10"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding SecondaryLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</Window>
