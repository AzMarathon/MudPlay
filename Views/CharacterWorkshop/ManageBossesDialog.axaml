<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="560"
        x:Class="MudPlay.Views.CharacterWorkshop.ManageBossesDialog"
        x:DataType="vm:ManageBossesDialogViewModel"
        Title="Manage bosses"
        Width="1180" Height="560"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <TextBox Grid.Row="0" Classes="clearable" Width="240" HorizontalAlignment="Left" Margin="0,0,0,10"
                 PlaceholderText="Filter by boss or room…"
                 Text="{Binding FilterText, Mode=TwoWay}"/>

        <DataGrid Grid.Row="1"
                  x:Name="BossGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1" BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="False"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Boss"
                                    Binding="{ReflectionBinding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="190"/>
                <DataGridTextColumn Header="Rooms (map/room; …)"
                                    Binding="{ReflectionBinding Rooms, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="190" FontFamily="{StaticResource FontMono}"/>
                <DataGridTextColumn Header="Respawn (h)"
                                    Binding="{ReflectionBinding RespawnHoursText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="95" FontFamily="{StaticResource FontMono}"/>
                <DataGridCheckBoxColumn Header="Respawns @ Cleanup"
                                        Binding="{ReflectionBinding IsCleanup, Mode=TwoWay}" Width="140"/>
                <DataGridCheckBoxColumn Header="Stock"
                                        Binding="{ReflectionBinding InStock, Mode=TwoWay}" Width="70"/>
                <DataGridCheckBoxColumn Header="ParaMUD"
                                        Binding="{ReflectionBinding InParadigm, Mode=TwoWay}" Width="80"/>
                <DataGridCheckBoxColumn Header="Show in Table"
                                        Binding="{ReflectionBinding ShowInTable, Mode=TwoWay}" Width="110"/>
                <DataGridTextColumn Header="Notes"
                                    Binding="{ReflectionBinding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="Add boss" Command="{Binding AddRowCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Remove selected" Command="{Binding RemoveRowCommand}"/>
            <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" Margin="0,0,8,0"/>
            <Button Grid.Column="4" Content="Save" Command="{Binding SaveCommand}" MinWidth="80" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
