<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:ctrl="using:MudPlay.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="600"
        x:Class="MudPlay.Views.CharacterWorkshop.DeathLogWindow"
        x:DataType="vm:DeathLogViewModel"
        Title="{Binding Title}"
        Width="820" Height="600"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Who / when / where / lives / death line, selectable for a bug report. -->
        <SelectableTextBlock Grid.Row="0" Text="{Binding Header}" Margin="0,0,0,10"
                             FontFamily="{StaticResource FontMono}"
                             FontSize="{StaticResource FontSizeMd}"
                             Foreground="{StaticResource ChromeFgBrush}"/>

        <!-- The death scene in the colours it was seen in: the same canvas the
             Backscroll window uses, with its own selection and Ctrl+C copy. -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1" CornerRadius="3">
            <ScrollViewer x:Name="OuterScroll"
                          Background="Black"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ctrl:BackscrollView x:Name="Transcript"
                                     FontFamily="{Binding FontFamily}"
                                     FontSize="{Binding FontSize}"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Close" Command="{Binding CloseCommand}"
                MinWidth="90" Margin="0,12,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
    </Grid>
</Window>
