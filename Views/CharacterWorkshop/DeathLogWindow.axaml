<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="600"
        x:Class="FujinTerm.Views.CharacterWorkshop.DeathLogWindow"
        x:DataType="vm:DeathLogViewModel"
        Title="{Binding Title}"
        Width="820" Height="600"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="16">

        <!-- Read-only monospace transcript of the death scene. TextBox (not a
             label) so the user can select + copy lines into a bug report. -->
        <Border Grid.Row="0"
                Background="{StaticResource ChromeBgSunkenBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1" CornerRadius="3">
            <TextBox Text="{Binding LogText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="{StaticResource FontMono}"
                     FontSize="{StaticResource FontSizeMd}"
                     Foreground="{StaticResource ChromeFgBrush}"
                     VerticalContentAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <Button Grid.Row="1" Content="Close" Command="{Binding CloseCommand}"
                MinWidth="90" Margin="0,12,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
    </Grid>
</Window>
