<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="520"
        x:Class="MudPlay.Views.CharacterWorkshop.ItemFinderEstimatesWindow"
        x:DataType="vm:ItemFinderEstimatesViewModel"
        Title="Configure Estimates"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Group">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.Group">
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="NumericUpDown.stat">
            <Setter Property="Width" Value="112"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="9999"/>
            <Setter Property="Increment" Value="1"/>
            <Setter Property="FormatString" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="12">
        <StackPanel Spacing="0">

            <!-- Who is swinging. Only the stats the selected attack reads are shown. -->
            <Border Classes="Group">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Group" Text="Your character"/>
                    <TextBlock Classes="FieldLabel" Text="{Binding AttackSummary}" TextWrapping="Wrap"/>
                    <DockPanel>
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat" Minimum="1" Maximum="999"
                                       Value="{Binding Level, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Level"/>
                    </DockPanel>
                    <DockPanel IsVisible="{Binding UsesStrength}">
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat"
                                       Value="{Binding Strength, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Strength"/>
                    </DockPanel>
                    <DockPanel>
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat"
                                       Value="{Binding Agility, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Agility"/>
                    </DockPanel>
                    <DockPanel IsVisible="{Binding UsesIntellectAndCharm}">
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat"
                                       Value="{Binding Intellect, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Intellect"/>
                    </DockPanel>
                    <DockPanel IsVisible="{Binding UsesIntellectAndCharm}">
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat"
                                       Value="{Binding Charm, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Charm"/>
                    </DockPanel>
                    <DockPanel IsVisible="{Binding UsesStealth}">
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat"
                                       Value="{Binding Stealth, Mode=TwoWay}"
                                       ToolTip.Tip="Your Stealth as the stat screen shows it, less the +Stealth of what you're wearing. The game also moves it with how much you carry; a lighter or heavier trial set isn't counted here."/>
                        <TextBlock Classes="FieldLabel" Text="Stealth"/>
                    </DockPanel>
                    <Button Content="Reset to my character" Command="{Binding ResetCharacterCommand}"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="Put back the stats read from your stat screen when the Item Finder opened, less the gear you were wearing."/>
                </StackPanel>
            </Border>

            <!-- What it is swinging at: typed, or filled from a monster's record. -->
            <Border Classes="Group">
                <StackPanel Spacing="6">
                    <TextBlock Classes="Group" Text="Target"/>
                    <AutoCompleteBox ItemsSource="{Binding MonsterNames}"
                                     SelectedItem="{Binding SelectedMonsterName, Mode=TwoWay}"
                                     FilterMode="ContainsOrdinal"
                                     MinimumPrefixLength="1"
                                     HorizontalAlignment="Stretch"
                                     PlaceholderText="Look up a monster to fill these in…"/>
                    <DockPanel>
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat" Minimum="-9999"
                                       Value="{Binding MonsterAc, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Armour class"/>
                    </DockPanel>
                    <DockPanel>
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat" Minimum="-9999"
                                       Value="{Binding MonsterDr, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Damage resist"/>
                    </DockPanel>
                    <DockPanel>
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat" Minimum="-9999"
                                       Value="{Binding MonsterDodge, Mode=TwoWay}"/>
                        <TextBlock Classes="FieldLabel" Text="Dodge"/>
                    </DockPanel>
                    <DockPanel>
                        <NumericUpDown DockPanel.Dock="Right" Classes="stat" Minimum="-9999"
                                       Value="{Binding MonsterBsDefense, Mode=TwoWay}"
                                       ToolTip.Tip="Only a backstab rolls against this (with a quarter of the armour class)."/>
                        <TextBlock Classes="FieldLabel" Text="BS defence"/>
                    </DockPanel>
                    <TextBlock Text="{Binding MonsterNote}" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentAmberBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               IsVisible="{Binding HasMonsterNote}"/>
                    <Button Content="Clear target" Command="{Binding ClearTargetCommand}"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="Back to no target: no armour, dodge or resist to get past."/>
                </StackPanel>
            </Border>

            <Button Content="Close" Command="{Binding CloseCommand}" MinWidth="80"
                    HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
