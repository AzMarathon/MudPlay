<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="720"
        x:Class="MudPlay.Views.CharacterWorkshop.ChestOffloadWindow"
        x:DataType="vm:ChestOffloadViewModel"
        Title="Chest Offload"
        Width="620" Height="720"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Section">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Border.Box">
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <!-- Clickable text link — matches the item-record/room links (cyan-blue). -->
        <Style Selector="Button.Link">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Link:disabled">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="Button.Link:disabled /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <DockPanel LastChildFill="True">

            <!-- Top: containers to open + charm + coin gained -->
            <StackPanel DockPanel.Dock="Top" Spacing="10">
                <Border Classes="Box">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="Section" Text="Containers you're holding" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Simulate Chest" Command="{Binding SimulateChestCommand}"
                                    ToolTip.Tip="Seed a few random containers whose loot is rolled from the chest's own table — test the window without real chests."/>
                        </Grid>
                        <TextBlock Text="No containers in your inventory."
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   IsVisible="{Binding !HasContainers}"/>
                        <ItemsControl ItemsSource="{Binding Containers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChestContainerRow">
                                    <Button Content="{Binding Display}" Command="{Binding OpenCommand}"
                                            Margin="0,0,6,6"
                                            ToolTip.Tip="Send &quot;open&quot; for this container"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Charm" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <NumericUpDown Grid.Column="1" Width="120" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                   Value="{Binding Charm, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="3" Text="Total to sell:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding SellTotal}" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"
                               ToolTip.Tip="What you'll earn selling everything below at the quantities set"/>
                    <TextBlock Grid.Column="5" Text="Coin gained:" VerticalAlignment="Center" Margin="18,0,6,0"/>
                    <TextBlock Grid.Column="6" Text="{Binding CurrencyGained}" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>

            <!-- Scrollable shop groups -->
            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="Open a container above to see what's sellable."
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               IsVisible="{Binding !HasLoot}"/>

                    <ItemsControl ItemsSource="{Binding ShopGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChestOffloadShopGroup">
                                <Border Classes="Box" Margin="0,0,0,2">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <Button Grid.Column="0" Classes="Link" Content="{Binding ShopName}"
                                                    Command="{Binding WalkCommand}"
                                                    IsEnabled="{Binding CanWalk}"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="Walk to this shop"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Total}" VerticalAlignment="Center"
                                                       Margin="8,0,10,0"
                                                       Foreground="{StaticResource AccentAmberBrush}"/>
                                            <Button Grid.Column="2" Content="Sell" Command="{Binding SellCommand}"
                                                    Margin="0,0,6,0"
                                                    ToolTip.Tip="Send the sell commands for the quantities below (do this while standing in the shop)"/>
                                            <Button Grid.Column="3" Content="Drop All" Command="{Binding DropAllCommand}"
                                                    ToolTip.Tip="Drop every item in this shop's listing and remove it from the sell plan"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChestOffloadItemRow">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        <NumericUpDown Grid.Column="1" Width="104"
                                                                       Minimum="0" Maximum="{Binding Gained}" Increment="1" FormatString="0"
                                                                       Value="{Binding SellQty, Mode=TwoWay}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Gained, StringFormat='of {0}'}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding LineValue}" VerticalAlignment="Center"
                                                                   Margin="10,0,8,0" MinWidth="90"/>
                                                        <Button Grid.Column="4" Content="Drop" Command="{Binding DropCommand}"
                                                                ToolTip.Tip="Drop this whole stack and remove it from the sell plan"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="Box" IsVisible="{Binding HasUnsellable}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="Section" Text="No shop buys these"/>
                            <ItemsControl ItemsSource="{Binding Unsellable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChestOffloadItemRow">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
