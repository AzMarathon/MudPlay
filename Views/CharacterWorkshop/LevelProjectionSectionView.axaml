<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
             xmlns:tables="using:MudPlay.ViewModels.GameData.Tables"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="MudPlay.Views.CharacterWorkshop.LevelProjectionSectionView"
             x:DataType="vm:LevelProjectionSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,*">

        <!-- What-if controls: target level range + race / class / realm. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Classes="FieldLabel" Text="Levels"/>
                <NumericUpDown Value="{Binding FromLevel}" Minimum="2" Maximum="1000" Increment="1"
                               Width="120" FormatString="0"/>
                <TextBlock Classes="FieldLabel" Text="to"/>
                <NumericUpDown Value="{Binding ToLevel}" Minimum="2" Maximum="1000" Increment="1"
                               Width="120" FormatString="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Classes="FieldLabel" Text="Race"/>
                <ComboBox ItemsSource="{Binding RaceOptions}" SelectedItem="{Binding SelectedRace}" MinWidth="118"/>
                <TextBlock Classes="FieldLabel" Text="Class"/>
                <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" MinWidth="118"/>
            </StackPanel>
            <Button Content="Reset to current" Margin="0,0,12,6"
                    Command="{Binding ResetToCurrentCommand}"
                    ToolTip.Tip="Re-seed Race / Class / Realm and the level range from the live character."/>

            <!-- Column picker. Choices persist per character, so each build can
                 surface the stats it actually plans around. -->
            <Button Content="Columns ▾" Margin="0,0,0,6"
                    ToolTip.Tip="Choose which columns this projection shows. Saved per character.">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="6" MinWidth="200" MaxWidth="320">
                            <TextBlock Text="Show columns" FontWeight="SemiBold"/>
                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ColumnChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="tables:TableColumnChoice">
                                            <CheckBox Margin="0,1"
                                                      IsChecked="{Binding IsVisible}"
                                                      IsEnabled="{Binding !Pinned}"
                                                      Content="{Binding Label}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Reset to defaults"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ResetColumnsCommand}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>

        <!-- Projection grid. The live character's current level row is tinted
             by the code-behind LoadingRow handler, and the columns are built
             there too — which ones show is a per-character choice. -->
        <DataGrid Grid.Row="1"
                  x:Name="ProjectionGrid"
                  ItemsSource="{Binding Rows}"
                  LoadingRow="OnLoadingRow"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"/>

        <!-- Empty-state: no class/race resolved (no game data / no `stat` yet). -->
        <TextBlock Grid.Row="1"
                   IsVisible="{Binding !HasProjection}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   Text="Load a character and game-data set to project levels. Pick a Race and Class above to preview any build."/>
    </Grid>
</UserControl>
