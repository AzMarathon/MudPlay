<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="MudPlay.Views.CharacterWorkshop.GhManagementSectionView"
             x:DataType="vm:GhManagementSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Styles>

    <!-- MaxWidth keeps the tab from forcing the workshop window ultra-wide: without
         it the wrapping instructions text measures at infinite width. -->
    <Grid Margin="22" MaxWidth="900" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: instructions + live phase readout. -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}" TextWrapping="Wrap"
                       Text="Right-click a destination room on the map and choose 'Toggle: Roomba Room' to add it (right-click again to remove it), or type a map/room number below and click Add Room. Assign each room's sort rules, then Start (label at least 2 rooms). Roomba scans the circuit once, moves misfiled floor items to their labeled room in the fewest trips, then scans once more. Tick 'Search rooms for hidden items' to also 'sea' each room. Double-click a room below to see its current contents; open 'Roomba Log' for the full move record and summary."/>
            <TextBlock Text="{Binding PhaseText}"
                       Foreground="{StaticResource ChromeFgBrush}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StartHint}"
                       Foreground="{StaticResource SeverityWarnBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StartHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding CompletionSummary}"
                       Foreground="{StaticResource SeverityInfoBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding CompletionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <!-- Action buttons + add-room + hidden-search tuning (WrapPanel so a narrow
             window wraps the controls instead of forcing the tab wider). -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start Sweep" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}" Margin="0,0,6,6"/>
            <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,6,6"/>
            <Button Content="Roomba Log" Command="{Binding OpenRoombaLogCommand}" Margin="0,0,6,6"/>
            <TextBox Text="{Binding AddRoomInput}" PlaceholderText="map/room" Width="100"
                     VerticalAlignment="Center" Margin="12,0,6,6"/>
            <Button Content="Add Room" Command="{Binding AddRoomCommand}" IsEnabled="{Binding !IsRunning}" Margin="0,0,6,6"/>
            <CheckBox Content="Search rooms for hidden items"
                      IsChecked="{Binding SearchForHidden}"
                      IsEnabled="{Binding !IsRunning}"
                      VerticalAlignment="Center" Margin="12,0,6,6"
                      ToolTip.Tip="Off: sort only items visible on the floor. On: send `sea` in each room during recon to reveal and sort hidden items too."/>
            <TextBlock Classes="FieldLabel" Text="Searches per room" VerticalAlignment="Center" Margin="6,0,6,6"
                       IsEnabled="{Binding SearchesEditable}"/>
            <NumericUpDown Value="{Binding SearchesPerRoom}" Minimum="1" Maximum="20" Increment="1"
                           Width="100" FormatString="0" IsEnabled="{Binding SearchesEditable}" Margin="0,0,0,6"/>
        </WrapPanel>

        <!-- Labeled rooms grid (double-click a row → its current contents below) -->
        <DataGrid Grid.Row="2"
                  Name="RoomsGrid"
                  ItemsSource="{Binding Rooms}"
                  DoubleTapped="OnRoomDoubleTapped"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Room" Binding="{ReflectionBinding RoomName}"
                                    Width="220" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Map / Room #" Binding="{ReflectionBinding RoomKeyText}"
                                    Width="100" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Status" Binding="{ReflectionBinding Status}"
                                    Width="90" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Sorts" Binding="{ReflectionBinding CategoryText}"
                                    Width="200" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:GhRoomLabelRowViewModel">
                            <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Room contents (from double-click) — the current floor after the sweep. -->
        <StackPanel Grid.Row="3" Spacing="4" Margin="0,10,0,0"
                    IsVisible="{Binding RoomContentsTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="SectionHeader" Text="{Binding RoomContentsTitle}"/>
            <Border Padding="8" Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding RoomContentsText}" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
