<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="MudPlay.Views.CharacterWorkshop.GhManagementSectionView"
             x:DataType="vm:GhManagementSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Header: instructions + live phase readout. -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}" TextWrapping="Wrap"
                       Text="Right-click destination rooms on the map and choose 'Label as GH room…' to assign their sort rules, then Start here (label at least 2 rooms). Recon walks the circuit and sorts the floor items it sees; tick 'Search rooms for hidden items' to also 'sea' each room and sort what's hidden. It verifies inventory after each pickup/drop, then takes the shortest route to the next drop or pickup."/>
            <TextBlock Text="{Binding PhaseText}"
                       Foreground="{StaticResource ChromeFgBrush}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StartHint}"
                       Foreground="{StaticResource SeverityWarnBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StartHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding CompletionSummary}"
                       Foreground="{StaticResource SeverityInfoBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding CompletionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <!-- Action buttons + recon tuning -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <Button Content="Start Sweep" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}"/>
            <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
            <TextBlock Classes="FieldLabel" Text="Recon laps" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <NumericUpDown Value="{Binding ReconLaps}" Minimum="1" Maximum="20" Increment="1"
                           Width="100" FormatString="0" IsEnabled="{Binding !IsRunning}"/>
            <CheckBox Content="Search rooms for hidden items"
                      IsChecked="{Binding SearchForHidden}"
                      IsEnabled="{Binding !IsRunning}"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      ToolTip.Tip="Off: sort only items visible on the floor. On: send `sea` in each room during recon to reveal and sort hidden items too."/>
            <TextBlock Classes="FieldLabel" Text="Searches per room" VerticalAlignment="Center" Margin="12,0,0,0"
                       IsEnabled="{Binding SearchesEditable}"/>
            <NumericUpDown Value="{Binding SearchesPerRoom}" Minimum="1" Maximum="20" Increment="1"
                           Width="100" FormatString="0" IsEnabled="{Binding SearchesEditable}"/>
        </StackPanel>

        <!-- Labeled rooms grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rooms}"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Room" Binding="{ReflectionBinding RoomName}"
                                    Width="240" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Map / Room #" Binding="{ReflectionBinding RoomKeyText}"
                                    Width="110" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Sorts" Binding="{ReflectionBinding CategoryText}"
                                    Width="200" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:GhRoomLabelRowViewModel">
                            <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Sweep report -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="SectionHeader" Text="Moved"/>
                <Border Padding="8" Background="{StaticResource ChromeBgElevBrush}"
                        BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding MovedText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="SectionHeader" Text="Left in place (no matching room)"/>
                <Border Padding="8" Background="{StaticResource ChromeBgElevBrush}"
                        BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding LeftInPlaceText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Stranded: only shown when the sweep ended (crashed / manually stopped)
             while items were still carried and undelivered. These need a manual
             drop, so they're called out distinctly from the two panels above. -->
        <StackPanel Grid.Row="4" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding HasStranded}">
            <TextBlock Classes="SectionHeader" Foreground="{StaticResource SeverityErrorBrush}"
                       Text="Still carried — sweep ended before these were dropped"/>
            <Border Padding="8" Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource SeverityErrorBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding StrandedText}" TextWrapping="Wrap"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
