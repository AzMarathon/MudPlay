<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="320"
        x:Class="MudPlay.Views.CharacterWorkshop.BossRoomPickerDialog"
        x:DataType="vm:BossRoomPickerDialogViewModel"
        Title="Walk to boss"
        Width="440" Height="360"
        MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0"
                   Text="{Binding Heading}"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,6" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Text="This boss has several rooms — sorted nearest first. Pick one, then Run to walk there now or Load to arm it."
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Rooms}"
                 SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                 Background="{StaticResource ChromeBgSunkenBrush}"
                 BorderThickness="1" BorderBrush="{StaticResource ChromeBorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BossRoomOption">
                    <TextBlock Text="{Binding Display}" TextWrapping="NoWrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80"/>
            <Button Content="Load" Command="{Binding LoadCommand}" MinWidth="80"/>
            <Button Content="Run" Command="{Binding RunCommand}" IsDefault="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
