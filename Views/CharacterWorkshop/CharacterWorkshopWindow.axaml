<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="MudPlay.Views.CharacterWorkshop.CharacterWorkshopWindow"
        x:DataType="vm:CharacterWorkshopViewModel"
        Title="{Binding WindowTitle}"
        Width="960" Height="600"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBgBrush}">

    <!-- Flat tab strip across the character-workshop sections. Each tab's
         content is the section's own view. Tabs vary widely in how much room
         they need (the Bosses grid is far wider than Character Info), so the
         code-behind snaps the window to the active tab's content on each switch
         (see CharacterWorkshopWindow.axaml.cs) — hence the x:Name here. -->
    <TabControl x:Name="SectionTabs"
                ItemsSource="{Binding Sections}"
                SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                Background="{StaticResource ChromeBgBrush}"
                Padding="0">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkshopSectionViewModel">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeMd}"/>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:WorkshopSectionViewModel">
                <ContentControl Content="{Binding View}"/>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</Window>
