<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
             xmlns:controls="using:MudPlay.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="620"
             x:Class="MudPlay.Views.CharacterWorkshop.CalculatorsSectionView"
             x:DataType="vm:CalculatorsSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        </Style>
        <Style Selector="TextBlock.BoxTitle">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.Section">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.SubBox">
            <Setter Property="Background" Value="{StaticResource ChromeBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="NumericUpDown.Stat">
            <Setter Property="Width" Value="118"/>
            <Setter Property="FormatString" Value="0"/>
            <Setter Property="Increment" Value="1"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="9999"/>
        </Style>

        <!-- Leaderboard table wears the in-game "top N" colour scheme so it reads
             like the listing it mirrors: green headers + Experience, gold ranks,
             cyan names, magenta class, grey guild, on a black background. Per-cell
             colours are set on each column below; these style the chrome. -->
        <Style Selector="DataGrid.Leaderboard DataGridColumnHeader">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#00FF00"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGrid.Leaderboard DataGridRow">
            <Setter Property="Background" Value="#000000"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <!-- Each calculator is its own collapsible Expander; add more here as
                 sibling Expanders to grow the tab into a calculator toolbox. The
                 narrow calculators pin to Width=560; Realm Rankings opts out so its
                 wide table can stretch the panel when expanded (and scroll if the
                 window is too narrow) without shoving the others around. -->
            <StackPanel Spacing="14" HorizontalAlignment="Left">

                <!-- ===== Hit Calculator ===== -->
                <Expander Width="560" HorizontalAlignment="Left">
                    <Expander.Header>
                        <TextBlock Classes="BoxTitle" Text="Hit Calculator"/>
                    </Expander.Header>

                    <StackPanel Spacing="14" Margin="0,8,0,0">

                        <!-- ===== Your values (+ You → Monster projection) ===== -->
                        <Border Classes="SubBox">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="Section" Text="Your Values" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Reset to actual"
                                            Command="{Binding ResetDefensesCommand}"
                                            ToolTip.Tip="Discard your weapon / accuracy / AC / dodge edits and re-seed from the live stat + gear values."/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Accuracy"/>
                                        <NumericUpDown Classes="Stat" Value="{Binding PlayerAccuracy, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Armour Class"/>
                                        <NumericUpDown Classes="Stat" Minimum="-9999" Value="{Binding PlayerAc, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Dodge"/>
                                        <NumericUpDown Classes="Stat" Minimum="-9999" Value="{Binding PlayerDodge, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,2"/>

                                <TextBlock Classes="Section" Text="You → Monster"/>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="FieldLabel" Text="Attack type"/>
                                    <ComboBox ItemsSource="{Binding MatchupAttackTypeOptions}"
                                              SelectedItem="{Binding SelectedMatchupAttackType, Mode=TwoWay}"
                                              MinWidth="180"
                                              HorizontalAlignment="Left"
                                              ToolTip.Tip="Which attack drives the projection. Bash / Smash and the Mystic strikes (Punch / Kick / Jumpkick) appear only when the class can use them."/>
                                </StackPanel>

                                <!-- Weapon picker only applies to a weapon attack; a
                                     bare-handed Mystic strike hides it. -->
                                <StackPanel Spacing="3" IsVisible="{Binding !IsMatchupMartialArts}">
                                    <TextBlock Classes="FieldLabel" Text="Weapon"/>
                                    <AutoCompleteBox ItemsSource="{Binding WeaponNames}"
                                                     SelectedItem="{Binding SelectedWeaponName, Mode=TwoWay}"
                                                     FilterMode="ContainsOrdinal"
                                                     MinimumPrefixLength="1"
                                                     MinWidth="260"
                                                     HorizontalAlignment="Left"
                                                     PlaceholderText="Equipped weapon — type to model a different one…"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Hit Chance" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupPlayerHit}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Damage" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupPlayerDamage}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Swings/Rnd" Margin="0,2,16,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupSwings}" Margin="0,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="DPS" Margin="0,2,16,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupDps}" Margin="0,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== Monster values ===== -->
                        <Border Classes="SubBox">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="Section" Text="Monster Values" VerticalAlignment="Center"/>
                                    <!-- Hit-% picker + jump: find the accuracy that hits you this
                                         often (vs your AC + dodge) and show those monsters. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Classes="FieldLabel" Text="Hits me" VerticalAlignment="Center"/>
                                        <NumericUpDown Value="{Binding HitPercentTarget, Mode=TwoWay}"
                                                       Minimum="0" Maximum="100" Increment="5" FormatString="0"
                                                       Width="92" VerticalAlignment="Center"/>
                                        <TextBlock Classes="FieldLabel" Text="%" VerticalAlignment="Center"/>
                                        <Button Content="Show me the Monsters"
                                                Command="{Binding ShowMonstersAtHitPercentCommand}"
                                                ToolTip.Tip="Open the Monsters game-data tab filtered to monsters accurate enough to hit you at least this often, given your AC + dodge above."/>
                                    </StackPanel>
                                </Grid>

                                <AutoCompleteBox ItemsSource="{Binding MonsterNames}"
                                                 SelectedItem="{Binding SelectedMonsterName, Mode=TwoWay}"
                                                 FilterMode="ContainsOrdinal"
                                                 MinimumPrefixLength="1"
                                                 MinWidth="260"
                                                 HorizontalAlignment="Left"
                                                 PlaceholderText="Type a monster name to fill the values…"/>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Armour Class"/>
                                        <NumericUpDown Classes="Stat" Minimum="-9999" Value="{Binding MonsterAc, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Damage Resist"/>
                                        <NumericUpDown Classes="Stat" Value="{Binding MonsterDr, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Dodge"/>
                                        <NumericUpDown Classes="Stat" Minimum="-9999" Value="{Binding MonsterDodge, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,2"/>

                                <!-- Incoming attacks: chance each lands on YOU, at the
                                     accuracy you set (vs your AC + dodge above). Rows are
                                     seeded from the monster but freely add/removed. -->
                                <TextBlock Classes="Section" Text="Monster → You"/>

                                <!-- Column header. Fixed widths keep the header aligned
                                     with each attack row below (no shared size scope). -->
                                <Grid ColumnDefinitions="104,120,70,78,Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Attack"/>
                                    <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Accuracy"/>
                                    <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Damage"/>
                                    <TextBlock Grid.Column="3" Classes="FieldLabel" Text="Hit % on you"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding MonsterAttacks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MonsterAttackRowViewModel">
                                            <Grid ColumnDefinitions="104,120,70,78,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" Classes="FieldValue" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <NumericUpDown Grid.Column="1" Width="114"
                                                               FormatString="0" Increment="1" Minimum="0" Maximum="9999"
                                                               Value="{Binding Accuracy, Mode=TwoWay}"/>
                                                <TextBlock Grid.Column="2" Classes="FieldValue" Text="{Binding Damage}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Classes="FieldValue" Text="{Binding HitPercent}"
                                                           Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Content="✕" Padding="8,2" VerticalAlignment="Center"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="Remove this attack"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="＋ Add attack" HorizontalAlignment="Left"
                                        Command="{Binding AddAttackCommand}"
                                        ToolTip.Tip="Add a custom attack row to the incoming-hit calculator."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- ===== Movement Speed ===== -->
                <Expander Width="560" HorizontalAlignment="Left">
                    <Expander.Header>
                        <TextBlock Classes="BoxTitle" Text="Movement Speed"/>
                    </Expander.Header>

                    <StackPanel>
                    <!-- ParaMUD realms: the interactive movement-formula solver. -->
                    <Border Classes="SubBox" Margin="0,8,0,0" IsVisible="{Binding IsParadigmRealm}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="Section" Text="Inputs" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Reset to actual"
                                        Command="{Binding ResetMovementCommand}"
                                        ToolTip.Tip="Discard your edits and re-seed encumbrance + quickness from the live values."/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="FieldLabel" Text="Encumbrance %"/>
                                    <NumericUpDown Classes="Stat" Maximum="100" Value="{Binding MoveEncumbrance, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="FieldLabel" Text="Quickness"/>
                                    <NumericUpDown Classes="Stat" Value="{Binding MoveQuickness, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="FieldLabel" Text="Slowness"/>
                                    <NumericUpDown Classes="Stat" Value="{Binding MoveSlowness, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,2"/>

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Speed" Margin="0,2,16,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding MoveSpeedText}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Status" Margin="0,2,16,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding MoveStatusText}"
                                           Foreground="{StaticResource AccentAmberBrush}" Margin="0,2"/>
                            </Grid>

                            <TextBlock Classes="FieldLabel" Text="{Binding MoveAdviceText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Stock realms: the formula doesn't apply — show measured findings. -->
                    <Border Classes="SubBox" Margin="0,8,0,0" IsVisible="{Binding !IsParadigmRealm}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="Section" Text="Measured hop timings"/>
                            <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                       Text="Stock realms don't use the ParaMUD movement formula. Timing a large sample of moves shows a two-band step function — not a smooth ramp with encumbrance:"/>

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="None / Light / Medium"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue"
                                           Text="{Binding StockMoveFastBandText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Heavy / Encumbered"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue"
                                           Foreground="{StaticResource AccentAmberBrush}"
                                           Text="{Binding StockMoveSlowBandText}"/>
                            </Grid>

                            <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                       Text="Speed holds flat until you cross into Heavy, where it roughly doubles. These bands feed the auto-lair travel estimate; tune them under Settings → Auto-Lair."/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Expander>

                <!-- ===== Swing Calculator ===== -->
                <Expander Width="560" HorizontalAlignment="Left">
                    <Expander.Header>
                        <TextBlock Classes="BoxTitle" Text="Swing Calculator"/>
                    </Expander.Header>

                    <StackPanel Spacing="14" Margin="0,8,0,0">
                        <Border Classes="SubBox">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="Section" Text="Inputs" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Reset to actual"
                                            Command="{Binding ResetSwingCommand}"
                                            ToolTip.Tip="Discard your edits and re-seed weapon + stats from the live values."/>
                                </Grid>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="FieldLabel" Text="Weapon"/>
                                    <AutoCompleteBox ItemsSource="{Binding WeaponNames}"
                                                     SelectedItem="{Binding SelectedSwingWeaponName, Mode=TwoWay}"
                                                     FilterMode="ContainsOrdinal"
                                                     MinimumPrefixLength="1"
                                                     MinWidth="260"
                                                     HorizontalAlignment="Left"
                                                     PlaceholderText="Equipped weapon — type to model a different one…"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Level"/>
                                        <NumericUpDown Classes="Stat" Value="{Binding SwingLevel, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Combat Lvl"/>
                                        <NumericUpDown Classes="Stat" Minimum="1" Maximum="5" Value="{Binding SwingCombatLevel, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Agility"/>
                                        <NumericUpDown Classes="Stat" Value="{Binding SwingAgility, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Strength"/>
                                        <NumericUpDown Classes="Stat" Value="{Binding SwingStrength, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Encumbrance %"/>
                                        <NumericUpDown Classes="Stat" Maximum="100" Value="{Binding SwingEncumbrance, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Speed"/>
                                        <ComboBox ItemsSource="{Binding SwingSpeedOptions}"
                                                  SelectedItem="{Binding SwingSpeedOption, Mode=TwoWay}"
                                                  MinWidth="118"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <CheckBox Content="Bashing" IsChecked="{Binding SwingBashing, Mode=TwoWay}"/>
                                    <CheckBox Content="Slowness" IsChecked="{Binding SwingSlowness, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="SubBox" IsVisible="{Binding SwingHasWeapon}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="Result"/>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Energy / swing" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding SwingEnergyText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Raw swings" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding SwingRawText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Encumbrance" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding SwingEncumText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="QnD crits" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding SwingQndText}" Margin="0,2"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,2"/>

                                <TextBlock Classes="Section" Text="Swings / EU remaining (10 rounds)"/>
                                <Grid ColumnDefinitions="70,90,Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Round"/>
                                    <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Swings"/>
                                    <TextBlock Grid.Column="2" Classes="FieldLabel" Text="EU carried"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SwingRounds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SwingRoundRow">
                                            <Grid ColumnDefinitions="70,90,Auto" Margin="0,1">
                                                <TextBlock Grid.Column="0" Classes="FieldValue" Text="{Binding Round}"/>
                                                <TextBlock Grid.Column="1" Classes="FieldValue" Text="{Binding Swings}"/>
                                                <TextBlock Grid.Column="2" Classes="FieldValue" Text="{Binding EnergyCarried}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="FieldLabel" IsVisible="{Binding !SwingHasWeapon}"
                                   Text="Pick a weapon (or equip one) to see the swing breakdown."/>
                    </StackPanel>
                </Expander>

                <!-- ===== Backstab Calculator ===== -->
                <Expander Width="560" HorizontalAlignment="Left">
                    <Expander.Header>
                        <TextBlock Classes="BoxTitle" Text="Backstab Calculator"/>
                    </Expander.Header>

                    <StackPanel Spacing="14" Margin="0,8,0,0">
                        <Border Classes="SubBox">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="Section" Text="Weapon" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Reset to backstab set"
                                            Command="{Binding ResetBackstabCommand}"
                                            ToolTip.Tip="Set the weapon back to the Equipment Manager's Backstab-set weapon."/>
                                </Grid>

                                <AutoCompleteBox ItemsSource="{Binding WeaponNames}"
                                                 SelectedItem="{Binding SelectedBackstabWeaponName, Mode=TwoWay}"
                                                 FilterMode="ContainsOrdinal"
                                                 MinimumPrefixLength="1"
                                                 MinWidth="260"
                                                 HorizontalAlignment="Left"
                                                 PlaceholderText="Backstab-set weapon — type to model a different one…"/>
                                <TextBlock Classes="FieldLabel"
                                           Text="Level, strength, stealth and the +BS bonuses are read live from your character."/>
                            </StackPanel>
                        </Border>

                        <Border Classes="SubBox">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="Inputs (live)"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Level" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabLevelText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Strength" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabStrengthText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Stealth" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabStealthText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Stealth source" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabClassStealthText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Bonuses" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabBonusText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="FieldLabel" Text="Realm" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabRealmText}" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="SubBox" IsVisible="{Binding BackstabHasWeapon}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="Backstab damage"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Weapon range" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabWeaponRangeText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Min" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabMinText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Max" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabMaxText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Average" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabAvgText}" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="FieldLabel" IsVisible="{Binding !BackstabHasWeapon}"
                                   Text="Pick a backstab weapon (or set one on the Backstab gear set) to see the damage range."/>
                    </StackPanel>
                </Expander>

                <!-- ===== Mana Regen ===== -->
                <Expander Width="560" HorizontalAlignment="Left">
                    <Expander.Header>
                        <TextBlock Classes="BoxTitle" Text="Mana Regen"/>
                    </Expander.Header>

                    <StackPanel Spacing="14" Margin="0,8,0,0">
                        <!-- ===== Inputs (all editable — plan level / stats / gear) ===== -->
                        <Border Classes="SubBox">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="Inputs"/>
                                <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                           Text="Seeds from your character when it's a mage, priest or druid; every field is editable so you can plan stat points, level-ups and gear."/>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Class"/>
                                        <ComboBox ItemsSource="{Binding ManaClassOptions}"
                                                  SelectedItem="{Binding SelectedManaClass, Mode=TwoWay}"
                                                  MinWidth="180"
                                                  ToolTip.Tip="Mage / Priest / Druid classes only. Sets the magery stat (mage = INT, priest = WIL, druid = (INT+WIL)/2) and the magery tier from game data."/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="Level"/>
                                        <NumericUpDown Classes="Stat" Minimum="1" Value="{Binding ManaLevel, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Spacing="3" IsVisible="{Binding ManaUsesInt}">
                                        <TextBlock Classes="FieldLabel" Text="Intellect"/>
                                        <NumericUpDown Classes="Stat" Minimum="{Binding ManaIntMinimum}" Value="{Binding ManaIntellect, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3" IsVisible="{Binding ManaUsesWil}">
                                        <TextBlock Classes="FieldLabel" Text="Willpower"/>
                                        <NumericUpDown Classes="Stat" Minimum="{Binding ManaWilMinimum}" Value="{Binding ManaWillpower, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="FieldLabel" Text="+ManaRgn% (gear)"/>
                                        <NumericUpDown Classes="Stat" Minimum="-9999" Value="{Binding ManaGearRegenPercent, Mode=TwoWay}"
                                                       ToolTip.Tip="Summed +ManaRgn% from gear and completed quests (ability 145)."/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Tick vs level chart (breakpoints = step-ups) ===== -->
                        <Border Classes="SubBox">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="Section" Text="Tick vs level"/>
                                <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                           Text="Natural tick (with gear) across your level −1 to +3, one line per magery-stat value in +5 steps (INT for a mage, WIL for a priest, the (INT+WIL)/2 average for a druid) — a step up is a breakpoint. Lines stop at the highest that stat can be trained. The circle marks where you are now."/>
                                <controls:ManaRegenChart Data="{Binding ManaChart}" Height="240" HorizontalAlignment="Stretch"/>

                                <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,4"/>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="3">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="You are here"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaCurrentTickText}"
                                               Foreground="{StaticResource AccentAmberBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Next tick via stat"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaNextByStatText}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Next tick via level"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaNextByLevelText}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Next tick via ManaRgn%"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaNextByRegenText}"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,4"/>

                                <!-- Natural tick (no spell) — consolidated under the graph. -->
                                <TextBlock Classes="Section" Text="Natural tick (every 30s)"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Level + stat" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaBaseTickText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="+ gear ManaRgn%" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaGearTickText}"
                                               Foreground="{StaticResource AccentAmberBrush}" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== Roll spell + breakpoints ===== -->
                        <Border Classes="SubBox" IsVisible="{Binding ManaHasRollSpell}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="Section" Text="Mana regen spell"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Spell" Margin="0,2,16,2"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ManaRollSpellOptions}"
                                              SelectedItem="{Binding SelectedManaRollSpell, Mode=TwoWay}"
                                              MinWidth="180" Margin="0,2"
                                              IsVisible="{Binding ManaHasSpellChoice}"
                                              ToolTip.Tip="This class has more than one mana-regen roll spell — pick which to model."/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaRollSpellText}" Margin="0,2"
                                               IsVisible="{Binding !ManaHasSpellChoice}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Roll range" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaRollRangeText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Worst roll (0%)" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaWorstTickText}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Best roll (100%)" Margin="0,2,16,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaBestTickText}" Margin="0,2"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,2"/>

                                <TextBlock Classes="Section" Text="Model a roll"/>
                                <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                           Text="Slide from the worst (min) to the best (max) roll for this level to see any roll's value, its position in the range, and the tick it lands."/>
                                <Slider Minimum="{Binding ManaRollMin}" Maximum="{Binding ManaRollMax}"
                                        Value="{Binding ManaRollSample, Mode=TwoWay}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Width="480" HorizontalAlignment="Left"/>
                                <TextBlock Classes="FieldValue"
                                           Foreground="{StaticResource AccentAmberBrush}"
                                           Text="{Binding ManaSampleReadoutText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- ===== Realm Rankings ===== -->
                <!-- Unlike the fixed-560 calculators above, this one grows to the
                     full leaderboard table when expanded; MinWidth keeps it flush
                     with their width while collapsed. See the parent StackPanel. -->
                <Expander MinWidth="560" HorizontalAlignment="Left">
                    <Expander.Header>
                        <TextBlock Classes="BoxTitle" Text="Realm Rankings"/>
                    </Expander.Header>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="Parse Toplist"
                                    Command="{Binding ParseToplistCommand}"
                                    ToolTip.Tip="Send `top N` to the game at the stored list's depth (defaults to top 100 before the first capture), then capture the reply automatically."/>
                            <Button Content="Clear history"
                                    Command="{Binding ClearLeaderboardCommand}"
                                    ToolTip.Tip="Wipe this BBS's stored captures."/>
                            <TextBlock Classes="FieldLabel" Text="Class Filter:"
                                       Margin="20,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ClassFilterOptions}"
                                      SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}"
                                      MinWidth="140" VerticalAlignment="Center"
                                      ToolTip.Tip="Show only rows of the selected class; 'No Filter' clears the filter."/>
                        </StackPanel>

                        <TextBlock Classes="FieldLabel" Text="{Binding LeaderboardStatus}" TextWrapping="Wrap"/>

                        <!-- MaxWidth is pinned to the table's measured width in
                             SizeLeaderboardColumns so a long suspect list wraps at
                             the table's right edge instead of running past it (the
                             enclosing ScrollViewer would otherwise grant it
                             unbounded width and it wouldn't wrap at all). -->
                        <TextBlock x:Name="RerollNoticeText"
                                   Text="{Binding LeaderboardRerolls}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   IsVisible="{Binding HasLeaderboardNotices}"
                                   Foreground="{StaticResource AccentAmberBrush}"/>

                        <!-- Left-aligned so the box hugs the table instead of the
                             DataGrid stretching to fill the expander and trailing a
                             wide empty filler cell after the last column. -->
                        <Border IsVisible="{Binding HasLeaderboard}"
                                HorizontalAlignment="Left"
                                Background="#000000"
                                BorderBrush="{StaticResource ChromeBorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <!-- Columns auto-size to their widest value (header or
                                 cell), so nothing truncates and no column carries
                                 dead buffer; the grid is Left-aligned to the same end
                                 as the Border. -->
                            <DataGrid Classes="Leaderboard"
                                      x:Name="LeaderboardGrid"
                                      ItemsSource="{Binding LeaderboardView}"
                                      Sorting="OnLeaderboardSorting"
                                      Height="380"
                                      HorizontalAlignment="Left"
                                      Background="#000000"
                                      RowBackground="#000000"
                                      GridLinesVisibility="None"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserReorderColumns="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <!-- Numeric columns sort on typed *Value keys (via
                                     SortMemberPath) so they order by magnitude, not by
                                     the thousands-separated display text. Rank and
                                     XP/HR are template columns so a coloured movement /
                                     trend cue can sit beside the value. -->
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Rank" SortMemberPath="RankValue" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:LeaderboardRow">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource FontMono}"
                                                               Foreground="#FFC000" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RankMove}" FontFamily="{StaticResource FontMono}"
                                                               Foreground="{Binding RankMoveBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}"
                                                        SortMemberPath="Name"
                                                        Width="Auto" FontFamily="{StaticResource FontMono}"
                                                        Foreground="#00FFFF"/>
                                    <DataGridTextColumn Header="Class" Binding="{ReflectionBinding Class}"
                                                        SortMemberPath="Class"
                                                        Width="Auto" FontFamily="{StaticResource FontMono}"
                                                        Foreground="#FF00FF"/>
                                    <DataGridTextColumn Header="Gang/Guild" Binding="{ReflectionBinding Guild}"
                                                        SortMemberPath="Guild"
                                                        Width="Auto" FontFamily="{StaticResource FontMono}"
                                                        Foreground="#C0C0C0"/>
                                    <DataGridTextColumn Header="Experience" Binding="{ReflectionBinding Experience}"
                                                        SortMemberPath="ExperienceValue"
                                                        Width="Auto" FontFamily="{StaticResource FontMono}"
                                                        Foreground="#00FF00"/>
                                    <DataGridTemplateColumn Header="XP/HR" SortMemberPath="XpPerHourSort" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:LeaderboardRow">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding XpPerHour}" FontFamily="{StaticResource FontMono}"
                                                               Foreground="#FFFF00" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RateTrend}" FontFamily="{StaticResource FontMono}"
                                                               Foreground="{Binding RateTrendBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Classes="FieldLabel" IsVisible="{Binding !HasLeaderboard}"
                                   TextWrapping="Wrap"
                                   Text="No captures yet. Press Parse Toplist (or run `top &lt;N&gt;` in-game) to capture the leaderboard."/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
