<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:game="using:MudPlay.Game"
        xmlns:profile="using:MudPlay.Models.Profile"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="360"
        x:Class="MudPlay.Views.PartyWindow"
        x:DataType="vm:PartyViewModel"
        Title="{Binding HeaderText}"
        Width="920" Height="360"
        MinWidth="{Binding WindowMinWidth}" MinHeight="120"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Rank chip (F/M/B) — rendered per member.
             Matches the StatusChip style on the same row: dark elevated
             background with a coloured border + foreground driven by the
             rank's accent. White-text-on-tinted-fill (the previous
             style) was unreadable for the amber and cyan ranks. -->
        <Style Selector="Border.RankChip">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Status-flag chip (REST / PSN / WAIT / etc.). -->
        <Style Selector="Border.StatusChip">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.StatusChip > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Compact HP/MA bar. -->
        <Style Selector="ProgressBar.HpBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="ProgressBar.MaBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ===== Empty-state hint ===== -->
        <TextBlock DockPanel.Dock="Top"
                   Margin="10,12,10,0"
                   Text="No party active. Members appear here as soon as someone follows you (or you follow someone)."
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !State.IsInParty}"/>

        <!-- ===== Party-buff panel (right) =====
             A compact table of buff slots: each is added via the "Add buff"
             picker (spell + recast timer), then edited (✎) or removed (⨯), and its
             targeting chosen inline — a whole-party buff is one on/off; a
             single-target buff blesses "all members" or a checklist of specific
             members. Backed by CharacterProfile.PartyBuffs, persisted on every
             edit. Hidden entirely for a class with no party-buff spells. Styled to
             sit alongside the member list (same sunken ground, bottom-ruled rows)
             rather than as a contrasting card. -->
        <Border DockPanel.Dock="{Binding BuffDock}"
                Width="{Binding BuffWidth}" Height="{Binding BuffHeight}"
                IsVisible="{Binding Buffs.ShowPanel}"
                Background="{StaticResource ChromeBgSunkenBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="{Binding BuffBorderThickness}">
            <Grid RowDefinitions="Auto,*"
                  DataContext="{Binding Buffs}" x:DataType="vm:PartyBuffPanelViewModel">
                <Button Grid.Row="0" Content="＋ Add buff" Padding="8,2" Margin="8,8,8,4"
                        HorizontalAlignment="Left" IsEnabled="{Binding CanAddBuff}"
                        Command="{Binding AddBuffCommand}"/>

                <TextBlock Grid.Row="1"
                           IsVisible="{Binding !HasSlots}"
                           Margin="8,4,8,0"
                           Text="No buffs configured. Click “Add buff”, pick a spell, then set who receives it."
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"
                           TextWrapping="Wrap"/>

                <!-- Grid of buff rows. Shared column layout (buff | all/on toggle |
                     per-member columns) means every row's toggle and member
                     checkboxes line up under the member-name header. A whole-party
                     (or item) buff spans the member columns with "Party Wide".
                     Horizontal scroll kicks in for a full party. -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSlots}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header: member given-names over the checkbox columns -->
                        <Grid ColumnDefinitions="150,44,*" Margin="6,0,6,2">
                            <TextBlock Grid.Column="0" Text="Buff" FontSize="10"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="All" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Members}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Width="56" FontSize="10"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PartyBuffSlotRowViewModel">
                                    <Border BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                            BorderThickness="0,0,0,1" Padding="6,3">
                                        <Grid ColumnDefinitions="150,44,*">
                                            <!-- col0: edit / delete then "bless - 15s" -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Spacing="2">
                                                <Button Content="✎" Width="20" Height="20" Padding="0" FontSize="11"
                                                        ToolTip.Tip="Edit this buff / recast timer"
                                                        Command="{Binding $parent[ItemsControl].((vm:PartyBuffPanelViewModel)DataContext).EditBuffCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="⨯" Width="20" Height="20" Padding="0"
                                                        ToolTip.Tip="Remove this buff slot"
                                                        Command="{Binding $parent[ItemsControl].((vm:PartyBuffPanelViewModel)DataContext).RemoveBuffCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- col1: All (single-target) / On (whole-party) toggle -->
                                            <CheckBox Grid.Column="1" MinHeight="0" HorizontalAlignment="Center"
                                                      IsVisible="{Binding IsSingleTarget}"
                                                      IsChecked="{Binding AllMembers, Mode=TwoWay}"
                                                      ToolTip.Tip="Bless every party member in the room (auto-adapts to whatever party you're in)."/>
                                            <CheckBox Grid.Column="1" MinHeight="0" HorizontalAlignment="Center"
                                                      IsVisible="{Binding IsWholeParty}"
                                                      IsChecked="{Binding WholePartyOn, Mode=TwoWay}"
                                                      ToolTip.Tip="Cast on the whole party in one go."/>

                                            <!-- col2: per-member checkboxes (single) or Party Wide (whole) -->
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding MemberTargets}"
                                                          IsVisible="{Binding IsSingleTarget}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PartyBuffMemberToggle">
                                                        <Panel Width="56">
                                                            <CheckBox MinHeight="0" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      IsEnabled="{Binding $parent[ItemsControl].((vm:PartyBuffSlotRowViewModel)DataContext).MembersEnabled}"
                                                                      ToolTip.Tip="{Binding DisplayName}"/>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Column="2" Text="Party Wide"
                                                       IsVisible="{Binding IsWholeParty}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"
                                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== Member rows =====
             Column header row dropped — column purpose is obvious from
             the rendered row (star · rank chip · name/class · bars · chips ·
             uninvite). Leader name + HP% lives in the window Title instead
             of an internal strip. -->

        <ItemsControl ItemsSource="{Binding State.Members}"
                      Background="{StaticResource ChromeBgSunkenBrush}"
                      Padding="2"
                      IsVisible="{Binding State.IsInParty}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="game:PartyMember">
                    <Border BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <!-- Every column LEFT of the bars is fixed-pixel so the
                             bars land at the same X on every row. The name
                             column must be fixed too (not *): a flexible column
                             before the bars flexes against the Auto status-chip
                             column after them, so adding/removing a chip shifted
                             the bars sideways. The single * now sits AFTER the
                             chips as a spacer — it absorbs window slack and pins
                             the uninvite button to the right edge without ever
                             touching the bars' position. HP + MA are stacked in
                             one column (bar + "X:cur/max pct%"); the MA sub-row
                             hides for no-mana classes. -->
                        <Grid ColumnDefinitions="20,28,150,190,Auto,*,Auto"
                              VerticalAlignment="Center">

                            <!-- (0) Leader star — visible only on the leader -->
                            <TextBlock Grid.Column="0"
                                       Text="★"
                                       FontSize="13"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       IsVisible="{Binding IsLeader}"/>

                            <!-- (1) Rank chip — every row, colour-coded per rank.
                                 Front = red (melee), Mid = amber (default), Back =
                                 cyan (caster). Parsed from the par row's last
                                 column (Frontrank / Midrank / Backrank) into the
                                 PartyMember.Rank enum. RankBrushConverter drives
                                 both border + text colour so the chip reads the
                                 same way as the StatusChip strip on the same row. -->
                            <Border Grid.Column="1"
                                    Classes="RankChip"
                                    Background="{StaticResource ChromeBgElevBrush}"
                                    BorderBrush="{Binding Rank, Converter={x:Static vm:RankBrushConverter.Instance}}">
                                <TextBlock Text="{Binding Rank, Converter={x:Static vm:RankChipConverter.Instance}}"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Rank, Converter={x:Static vm:RankBrushConverter.Instance}}"/>
                            </Border>

                            <!-- (2) Name on top line; class on a small muted
                                 subtitle below — mirrors the skeleton design's
                                 two-line member cell. -->
                            <StackPanel Grid.Column="2" Orientation="Vertical"
                                        VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource ChromeFgBrush}"/>
                                <TextBlock Text="{Binding Class}"
                                           FontSize="9"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           IsVisible="{Binding Class, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <!-- (3) HP + MA stacked, single column (HEALTH · MANA).
                                 Skeleton-design layout: each member gets two
                                 vertical rows — HP bar + "H:cur/max pct%" on top,
                                 MA bar + "M:cur/max pct%" below. The MA sub-row
                                 hides when BaselineMp=0 (warrior / no-mana class
                                 / pre-@health-exchange) so the row collapses to
                                 HP-only height. -->
                            <StackPanel Grid.Column="3" Orientation="Vertical"
                                        Margin="6,0,8,0" VerticalAlignment="Center"
                                        Width="190" Spacing="2">
                                <!-- HP sub-row -->
                                <Grid ColumnDefinitions="60,8,*" VerticalAlignment="Center">
                                    <ProgressBar Grid.Column="0"
                                                 Classes="HpBar"
                                                 Value="{Binding HpPercent}"
                                                 Maximum="100"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding HpRichDisplay}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="10"
                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                </Grid>
                                <!-- MA sub-row — hidden when no mana pool. -->
                                <Grid ColumnDefinitions="60,8,*" VerticalAlignment="Center"
                                      IsVisible="{Binding BaselineMp, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}">
                                    <ProgressBar Grid.Column="0"
                                                 Classes="MaBar"
                                                 Value="{Binding MpPercent}"
                                                 Maximum="100"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MaRichDisplay}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="10"
                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                </Grid>
                            </StackPanel>

                            <!-- (4) Status-flag chips. Each chip self-collapses when the
                                 corresponding flag is false. REST / MED communicate
                                 stance (from par's state column); the four ailments
                                 (BLD / PSN / DIS / CNF) will be lit by the combat
                                 engine once it parses applied / cured messages; WAIT
                                 fires from the @wait / @ok protocol handlers. -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentGreenBrush}"
                                        IsVisible="{Binding Resting}">
                                    <TextBlock Text="REST" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentCyanBrush}"
                                        IsVisible="{Binding Meditating}">
                                    <TextBlock Text="MED" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Blinded}">
                                    <TextBlock Text="BLD" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Poisoned}">
                                    <TextBlock Text="PSN" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Diseased}">
                                    <TextBlock Text="DIS" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Confused}">
                                    <TextBlock Text="CNF" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentRedBrush}"
                                        IsVisible="{Binding Held}">
                                    <TextBlock Text="HELD" Foreground="{StaticResource AccentRedBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentPrimaryBrush}"
                                        IsVisible="{Binding IsWaiting}">
                                    <TextBlock Text="WAIT" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                </Border>
                                <!-- INVITED chip — visible while waiting on the
                                     player to accept our `invite`. PartyManager
                                     adds the row from the "You have invited X to
                                     follow you." server echo; flips to false on
                                     the "X started to follow you." acceptance. -->
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentCyanBrush}"
                                        IsVisible="{Binding IsInvited}">
                                    <TextBlock Text="INVITED" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- (5) Uninvite — enabled when we're the leader.
                                 PartyManager flips SelfIsLeader=true the moment
                                 we send an invite (on the "You have invited X to
                                 follow you." echo), so this gate covers BOTH
                                 the kick-a-follower and withdraw-a-pending-
                                 invite paths with one binding. -->
                            <Button Grid.Column="6"
                                    Content="⨯"
                                    Width="22" Height="22"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    FontSize="13"
                                    ToolTip.Tip="Uninvite from party (or withdraw a pending invitation)"
                                    Command="{Binding $parent[ItemsControl].DataContext.UninviteCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding $parent[ItemsControl].DataContext.State.SelfIsLeader}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
