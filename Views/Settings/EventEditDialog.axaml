<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="520"
        x:Class="MudPlay.Views.Settings.EventEditDialog"
        x:DataType="vm:EventEditDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector="TextBlock.Error">
            <Setter Property="Foreground" Value="#E55353"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="RadioButton.Row">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <!-- Header: Name + Disabled flag. -->
            <Grid Grid.Row="0" ColumnDefinitions="60,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Column="2" Content="Disabled" Margin="14,0,0,0"
                          IsChecked="{Binding DisabledFlag, Mode=TwoWay}"/>
            </Grid>

            <!-- WHEN section: single grid so the time / numeric / unit
                 columns line up across rows. Errors collapse when empty. -->
            <Grid Grid.Row="1" Margin="0,8,0,0"
                  ColumnDefinitions="100,140,140,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                           Classes="SectionHeader" Text="WHEN (trigger)"/>

                <RadioButton Grid.Row="1" Grid.Column="0" Classes="Row"
                             GroupName="When" Content="Logon"
                             IsChecked="{Binding IsTriggerLogon, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           Classes="Hint" Text="(every game entry)"
                           VerticalAlignment="Center"/>

                <RadioButton Grid.Row="2" Grid.Column="0" Classes="Row"
                             GroupName="When" Content="Logoff"
                             IsChecked="{Binding IsTriggerLogoff, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                           Classes="Hint" Text="(when BBS announces shutdown)"
                           VerticalAlignment="Center"/>

                <RadioButton Grid.Row="3" Grid.Column="0" Classes="Row"
                             GroupName="When" Content="Re-log"
                             IsChecked="{Binding IsTriggerRelog, Mode=TwoWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                           Classes="Hint" Text="(reconnects only, never first connect)"
                           VerticalAlignment="Center"/>

                <RadioButton Grid.Row="4" Grid.Column="0" Classes="Row"
                             GroupName="When" Content="At time"
                             IsChecked="{Binding IsTriggerAtTime, Mode=TwoWay}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding AtTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsTriggerAtTime}"
                         PlaceholderText="HH:mm"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,8,0"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Classes="Hint"
                           Text="system time"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                           Classes="Error"
                           Text="{Binding AtTimeError}"
                           IsVisible="{Binding HasAtTimeError}"/>

                <RadioButton Grid.Row="6" Grid.Column="0" Classes="Row"
                             GroupName="When" Content="Every"
                             IsChecked="{Binding IsTriggerEvery, Mode=TwoWay}"/>
                <NumericUpDown Grid.Row="6" Grid.Column="1"
                               Value="{Binding EveryAmount, Mode=TwoWay}"
                               Minimum="1" Maximum="86400"
                               IsEnabled="{Binding IsTriggerEvery}"
                               FormatString="0"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,8,0"/>
                <ComboBox Grid.Row="6" Grid.Column="2"
                          ItemsSource="{Binding EveryUnits}"
                          SelectedItem="{Binding EveryUnit, Mode=TwoWay}"
                          IsEnabled="{Binding IsTriggerEvery}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                           Classes="Error"
                           Text="{Binding EveryError}"
                           IsVisible="{Binding HasEveryError}"/>

                <!-- When: fires once every listed condition holds, then re-arms
                     only after they stop holding. -->
                <RadioButton Grid.Row="8" Grid.Column="0" Classes="Row"
                             GroupName="When" Content="When"
                             IsChecked="{Binding IsTriggerState, Mode=TwoWay}"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                           Classes="Hint" VerticalAlignment="Center"
                           Text="(all of these are true — fires once, again after they stop being true)"/>
                <ItemsControl Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4"
                              Margin="24,0,0,0"
                              ItemsSource="{Binding Conditions}"
                              IsEnabled="{Binding IsTriggerState}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventConditionRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                <ComboBox Width="130" ItemsSource="{Binding StatOptions}"
                                          SelectedItem="{Binding SelectedStat, Mode=TwoWay}"/>
                                <ComboBox Width="56" ItemsSource="{Binding ComparisonOptions}"
                                          SelectedItem="{Binding SelectedComparison, Mode=TwoWay}"/>
                                <NumericUpDown Width="120" Minimum="0" Maximum="999999999999"
                                               FormatString="0" Value="{Binding Value, Mode=TwoWay}"/>
                                <ComboBox Width="104" ItemsSource="{Binding DenominationOptions}"
                                          SelectedItem="{Binding Denomination, Mode=TwoWay}"
                                          IsVisible="{Binding IsMoney}"/>
                                <Button Content="✕" Width="28" Padding="0"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Remove this condition"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                    <Button Content="+ Add condition" Command="{Binding AddConditionCommand}"
                            ToolTip.Tip="Money (carried coin), encumbrance (% of max carry), experience, or level — compared with a value. All conditions must hold."/>
                    <TextBlock Classes="Error" VerticalAlignment="Center"
                               Text="{Binding ConditionsError}"
                               IsVisible="{Binding HasConditionsError}"/>
                </StackPanel>
            </Grid>

            <!-- WHAT section: shared two-column layout so every action
                 input starts at the same x. WHAT-side targets are
                 validated on Save (popup) rather than inline. -->
            <Grid Grid.Row="2" Margin="0,12,0,0"
                  ColumnDefinitions="100,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Classes="SectionHeader" Text="WHAT (action)"/>

                <RadioButton Grid.Row="1" Grid.Column="0" Classes="Row"
                             GroupName="What" Content="Walk to"
                             IsChecked="{Binding IsActionWalkTo, Mode=TwoWay}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding WalkToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsActionWalkTo}"
                         PlaceholderText="coord (1/297) or room name"
                         HorizontalAlignment="Left" Width="320"/>

                <RadioButton Grid.Row="2" Grid.Column="0" Classes="Row"
                             GroupName="What" Content="Start loop"
                             IsChecked="{Binding IsActionLoop, Mode=TwoWay}"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding AvailableLoopNames}"
                          SelectedItem="{Binding LoopName, Mode=TwoWay}"
                          IsEnabled="{Binding IsActionLoop}"
                          PlaceholderText="(select a saved loop)"
                          HorizontalAlignment="Left" Width="320"/>

                <RadioButton Grid.Row="3" Grid.Column="0" Classes="Row"
                             GroupName="What" Content="Auto-lair"
                             IsChecked="{Binding IsActionAutoLair, Mode=TwoWay}"/>
                <ComboBox Grid.Row="3" Grid.Column="1"
                          ItemsSource="{Binding AvailableAutoLairNames}"
                          SelectedItem="{Binding AutoLairSetupName, Mode=TwoWay}"
                          IsEnabled="{Binding IsActionAutoLair}"
                          PlaceholderText="(select a saved auto-lair setup)"
                          HorizontalAlignment="Left" Width="320"/>

                <RadioButton Grid.Row="4" Grid.Column="0"
                             VerticalAlignment="Top" Margin="0,4,0,0"
                             GroupName="What" Content="Command"
                             IsChecked="{Binding IsActionCommand, Mode=TwoWay}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2"
                            HorizontalAlignment="Left" Width="320">
                    <TextBox Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsActionCommand}"
                             AcceptsReturn="False"
                             PlaceholderText="stat; who; abil 145^M (empty = bare CR)" />
                    <TextBlock Classes="Hint"
                               Text="Supports ^M and ; for multi-fire; empty = carriage return"/>
                </StackPanel>

                <RadioButton Grid.Row="5" Grid.Column="0" Classes="Row"
                             GroupName="What" Content="Roomba"
                             IsChecked="{Binding IsActionRoomba, Mode=TwoWay}"/>
                <ComboBox Grid.Row="5" Grid.Column="1"
                          ItemsSource="{Binding RoombaModeOptions}"
                          SelectedItem="{Binding SelectedRoombaMode, Mode=TwoWay}"
                          IsEnabled="{Binding IsActionRoomba}"
                          HorizontalAlignment="Left" Width="320"
                          ToolTip.Tip="Start a Roomba sweep of your actively-managed rooms (stops any walk, loop or auto-lair first). Inventory only walks the circuit and refreshes the item log without moving anything."/>
            </Grid>

            <!-- Save / Cancel — centered, snug under the WHAT section. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Save" Width="100"
                        IsEnabled="{Binding CanSave}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"/>
                <Button Content="Cancel" Width="100"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
