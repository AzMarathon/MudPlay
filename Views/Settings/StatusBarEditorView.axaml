<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:svc="using:MudPlay.Services"
             xmlns:views="using:MudPlay.Views"
             x:Class="MudPlay.Views.Settings.StatusBarEditorView"
             x:DataType="vm:StatusBarEditorViewModel">

    <UserControl.Styles>
        <Style Selector="Border.ItemChip">
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2,2,2"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <Style Selector="Button.ChipButton">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBlock.ZoneLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="6" HorizontalAlignment="Left">
        <TextBlock Text="Status bar"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" MaxWidth="720"
                   HorizontalAlignment="Left"
                   Text="The bar under the terminal. Pick what each row shows on its left, in its centre and on its right; add rows for more. An item with nothing to show takes no space."/>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatusBarRowEditor">
                    <Border BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgSecBrush}"/>
                                <CheckBox Content="Marquee" IsChecked="{Binding Marquee, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Show this row as one line of text crawling sideways (left items, then centre, then right), so it can carry more than fits the window. The chip, warning and light show as their text."/>
                                <Button Content="Remove row" Command="{Binding RemoveCommand}"
                                        IsVisible="{Binding CanRemove}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Zones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusBarZoneEditor">
                                        <Grid ColumnDefinitions="56,*" Margin="0,2,0,0">
                                            <TextBlock Grid.Column="0" Classes="ZoneLabel" Text="{Binding Title}"/>
                                            <WrapPanel Grid.Column="1" Orientation="Horizontal" MaxWidth="700"
                                                       HorizontalAlignment="Left">
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StatusBarEntryEditor">
                                                            <Border Classes="ItemChip" ToolTip.Tip="{Binding Description}">
                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                               FontSize="{StaticResource FontSizeSm}"
                                                                               IsVisible="{Binding !IsCustomText}"/>
                                                                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             IsVisible="{Binding IsCustomText}"
                                                                             Width="200" VerticalAlignment="Center"
                                                                             PlaceholderText="Text — e.g. Lap {lap} of {loop}"/>
                                                                    <Button Classes="ChipButton" Content="&lt;" Command="{Binding MoveEarlierCommand}"
                                                                            ToolTip.Tip="Move earlier"/>
                                                                    <Button Classes="ChipButton" Content="&gt;" Command="{Binding MoveLaterCommand}"
                                                                            ToolTip.Tip="Move later"/>
                                                                    <Button Classes="ChipButton" Content="×" Command="{Binding RemoveCommand}"
                                                                            ToolTip.Tip="Remove"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                                    <ComboBox Width="250" ItemsSource="{Binding Choices}"
                                                              SelectedItem="{Binding Choice, Mode=TwoWay}"
                                                              PlaceholderText="Add an item…">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:StatusBarItemDef">
                                                                <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Description}">
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                    <TextBlock Text="{Binding Group}" FontSize="{StaticResource FontSizeSm}"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Content="Add" Command="{Binding AddCommand}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add a status bar row" Command="{Binding AddRowCommand}"
                    ToolTip.Tip="Up to four rows. A new row goes under the others."/>
            <Button Content="Reset to default" Command="{Binding ResetCommand}"
                    ToolTip.Tip="One row: engine chip and location on the left, the looked-at target in the centre, the statline warning, ticks and connection light on the right."/>
        </StackPanel>

        <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" MaxWidth="720"
                   HorizontalAlignment="Left" Text="{Binding TokenHelp}"/>

        <!-- The bar as it would look with the edits so far. Live values where there
             are any, sample values otherwise, so every placed item shows. -->
        <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding HasPreview}">
            <TextBlock Text="Preview"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <Border BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="1"
                    Width="760" HorizontalAlignment="Left">
                <views:StatusBarView DataContext="{Binding Preview}"/>
            </Border>
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap" MaxWidth="720"
                       HorizontalAlignment="Left"
                       Text="Nothing changes under the terminal until you press OK or Apply."/>
        </StackPanel>
    </StackPanel>
</UserControl>
