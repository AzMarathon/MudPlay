<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="760"
             x:Class="MudPlay.Views.Settings.OtherSectionView"
             x:DataType="vm:OtherSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBlock.FieldNote">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style Selector="TextBlock.FieldSuffix">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.HelpText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="4"
                    MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Classes="SettingsSectionBanner first" Text="Character profile settings"/>
            <TextBlock Classes="SettingsSectionSub"
                       Text="Saved to the loaded character — each character on a BBS keeps its own."/>
            <Border Classes="SettingsSectionRule"/>

            <!-- Title / phase tag / description deliberately omitted per
                 user direction — section headers throughout this tab
                 are removed too. The bound Title is still surfaced via
                 SettingsWindowViewModel's sidebar selection. -->

            <!-- Prose-style row matching the Player-Database row below.
                 Width="120" on the spinner so the value renders without
                 clipping (Avalonia's default NumericUpDown swallows
                 short widths and shows just the up/down arrows).
                 Range 0..9 with default 5 — small dial reflects the
                 realistic safety buffer at typical mid-game lives
                 counts. Subnote sits directly underneath the label. -->
            <StackPanel Orientation="Vertical" Spacing="2" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="FieldLabel" Text="Block @suicide commands when lives ≤"/>
                    <NumericUpDown Value="{Binding MaxSuicideLivesThreshold, Mode=TwoWay}"
                                   Minimum="0" Maximum="9" Increment="1"
                                   FormatString="0" ShowButtonSpinner="True"
                                   Width="120" MinWidth="120"/>
                    <TextBlock Classes="FieldLabel" Text="lives"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11" FontStyle="Italic"
                           Text="0 = disabled"/>
            </StackPanel>

            <!-- Master gate for walker trap-disarming. Off → the walker
                 steps straight through trapped exits. On → it disarms
                 first, but only when a disarm is actually possible (local
                 Traps skill today; party delegation in a follow-up). -->
            <TextBlock Classes="FieldLabel" Text="Traps:" Margin="0,12,0,0"/>
            <CheckBox Content="Utilize self or party members to disarm traps"
                      IsChecked="{Binding UtilizeDisarmTrapsIfAble, Mode=TwoWay}"
                      ToolTip.Tip="When checked (default): at a trapped exit the walker tries to disarm before moving — first yourself if you have the Traps skill, otherwise it delegates to a capable party member via @trap on say. When unchecked: the walker walks straight through trapped exits with no disarm attempt."/>

            <!-- @trap auto-disarm attempt cap. -->
            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto" Margin="0,12,0,0" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="@trap max disarms"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding MaxTrapDisarmAttempts, Mode=TwoWay}"
                               Minimum="1" Maximum="50" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Caps the `disarm trap &lt;dir&gt;` retry loop. Default 5."/>
            </Grid>

            <!-- Walker door pick cap + verb preference. Bashing has no cap: a
                 bashable door is bashed until it opens, resting to rest-max
                 whenever HP dips (see Health tab). The "Pick locks instead of
                 bashing" toggle flips the walker's verb preference. -->
            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Door max pick"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding MaxPickAttempts, Mode=TwoWay}"
                               Minimum="1" Maximum="100" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Caps the `pick &lt;dir&gt;` retry loop when opening a door. Default 10. Picking is probabilistic — the skill can fail even when the value meets the requirement. (Bashing has no cap — a bashable door is bashed, with rest breaks, until it opens.)"/>

                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Pick locks instead of bashing"
                          IsChecked="{Binding PicklocksOverBash, Mode=TwoWay}"
                          ToolTip.Tip="When checked, the walker prefers `pick &lt;dir&gt;` over `bash &lt;dir&gt;` on doors where both verbs are viable. Bash is louder and breaks stealth; thieves typically flip this on."/>
            </Grid>

            <!-- Auto-Sneak stand-down for a carried Stealth penalty (a log raft): no
                 `sn` while the estimated chance sits under this figure. Char-tier
                 (OtherSettings.SneakStandDownChance), read live through the resolver. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock Classes="FieldLabel" Text="Stop auto-sneaking while a carried item leaves under"/>
                <NumericUpDown Value="{Binding SneakStandDownChance, Mode=TwoWay}"
                               Minimum="0" Maximum="95" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="A few items cut your Stealth just by being in your pack (a log raft is -125). While one of them leaves your estimated chance to sneak under this figure, Auto-Sneak sends no `sn`, says so once on the terminal, and your walk goes on unsneaked until the item is gone. 0 never stands down; 1 stands down only when a sneak can't take at all. Default 15."/>
                <TextBlock Classes="FieldLabel" Text="% chance to sneak."/>
            </StackPanel>

            <!-- (The "search rooms if item needed" checkbox was retired — arming
                 the per-room `sea` for a route item is now the master Auto-Search
                 toggle's job, and the route picker's "Search en route" card turns it
                 on for the leg + buys at a shop as a fallback.) -->

            <!-- Discard verb. When checked, a discard (the auto-discard engine's
                 offload of an excess flagged item, and Chest Offload's Drop /
                 Drop All) goes out as hide <item> instead of drop <item>. These
                 hides are excluded from the Transaction ledger (a discard isn't
                 a stash); manual and stash-room hides still record there.
                 Char-tier. -->
            <CheckBox Content="Hide items when discarding"
                      IsChecked="{Binding HideWhenDiscarding, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: a discard uses `hide &lt;item&gt;` instead of `drop &lt;item&gt;` — the item still leaves your pack, but lands concealed on the ground rather than in plain view. It covers the auto-discard engine's offload of each excess flagged item, and the Drop and Drop All buttons on the Workshop's Chest Offload tab. These hides are kept out of the Transaction history (a discard isn't a stash), while your manual hides and stash-room hides are still logged. A hide a full room refuses (Stock only) keeps the item and is sent again in each new room you enter until it lands; it is never dropped instead. The Action menu's Drop entries always drop; its Hide entries are there for hiding. Applies only for this character."/>

            <!-- Note: the former Buy/Hunt/Defer path-item checkboxes moved to
                 per-item game-data flags on the item record (item-edit dialog:
                 Auto-obtain for path + its buy / source-from-drops / provision-
                 party sub-flags). A path-enabling item is marked once there, so
                 there's no global toggle for it on this tab anymore. -->

            <!-- Note: "Avoid party-impassable level gates" is no longer a
                 checkbox — routing a following party AROUND a (Level: MIN to
                 MAX) gate it can't clear is always-on built-in behaviour now
                 (the alternative strands a member), so there's nothing to
                 toggle here. Each member's level comes from an @level probe
                 (exact, re-confirmed when older than a day) or their who title
                 band until probed. -->

            <!-- Follower-side auto-@comeback. When checked (default), being
                 left behind by the leader (a movement-failure line right
                 before "You are no longer following X.") telepaths
                 @comeback to the leader automatically. Char-tier setting. -->
            <CheckBox Content="Auto-request @comeback when left behind"
                      IsChecked="{Binding AutoRequestComebackWhenLeftBehind, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: if a movement-blocking condition (a prevents-movement gamedata flag or over-encumbrance) strands you as your party leader walks off, MudPlay telepaths @comeback &lt;your room&gt; to the leader so their recovery flow picks you back up. When unchecked, the strand is detected but no request is sent — you handle it manually. Applies only for this character."/>

            <!-- Auto-invite gate: players flagged "invite to party if seen" are
                 invited only while navigation runs. Char-tier setting. -->
            <CheckBox Content="Only auto-invite while navigation is running"
                      IsChecked="{Binding AutoInviteOnlyWhileNavigating, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: players you've flagged 'Invite to party if seen' are auto-invited only while navigation is running — a walk, loop or auto-lair (running or paused), or an auto-deposit or train trip. Standing idle, seeing them does nothing until navigation starts; anyone still in the room is invited then. When unchecked (default), they're invited whenever you see them. Re-invites of your own party (after a disconnect, a split or a trainer trip) aren't affected. Applies only for this character."/>

            <!-- Go ▾ Run / Sprint starts stopped by hand before the run began:
                 whether the autos they turned off come back. Char-tier settings. -->
            <CheckBox Content="Stopping a Run turns Auto-Combat back on"
                      IsChecked="{Binding RunStopRestoresCombat, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: stopping a walk-to, loop or Auto-Lair you started with Run (Go with Auto-Combat off) before it began turns Auto-Combat back on at once. When unchecked (default), Auto-Combat stays off. (A Run that isn't stopped turns it back on by itself once it reaches its destination, loop or first lair.) Applies only for this character."/>
            <CheckBox Content="Stopping a Sprint ends Sprint Mode"
                      IsChecked="{Binding SprintStopEndsSprint, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: stopping a walk-to, loop or Auto-Lair you started with Sprint (Go in Sprint Mode) before it began ends Sprint Mode at once, turning back on the autos it turned off. When unchecked (default), Sprint Mode stays on until your next walk arrives. (A Sprint that isn't stopped ends by itself once it reaches its destination, loop or first lair.) Applies only for this character."/>

            <!-- The yellow monster-HP line a look prints in the terminal. The status
                 bar's target readout is its own item on the bar. Char-tier setting. -->
            <CheckBox Content="Print monster HP in the terminal when I look"
                      IsChecked="{Binding PrintMonsterHpOnLook, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked (default): looking at a monster prints a yellow line in the terminal with its estimated remaining hit points (e.g. [large orc: 100 HP, Sev: 30-49, ~41]). The status bar's target HP readout isn't affected: add or remove it under BBS + Display → Status bar. Applies only for this character."/>

            <!-- Note: Monster Intel's "Est. Rounds to Kill" cap moved out of
                 here and lives entirely in that window now (a NumericUpDown
                 next to the Hits-You-% checkboxes) — editing it doesn't mean
                 leaving Monster Intel to come back. Still backed by
                 OtherSettings.RoundsToKillCap at the Character tier. -->

            <TextBlock Classes="SettingsSectionBanner" Text="Global client settings"/>
            <TextBlock Classes="SettingsSectionSub"
                       Text="Apply to the whole install, regardless of BBS or character."/>
            <Border Classes="SettingsSectionRule"/>

            <!-- Navigation puzzle-solver master toggles (Global tier — one switch
                 per install). Off → a walk-to that would hand off to the solver
                 just fails like any unroutable destination. Read live via
                 PyramidSolver.Enabled / TeleportMazeSolver.Enabled. -->
            <TextBlock Classes="FieldLabel" Text="Navigation puzzle solvers:" Margin="0,14,0,0"/>
            <CheckBox Content="Enable the Great Pyramid climb solver"
                      IsChecked="{Binding PyramidSolverEnabled, Mode=TwoWay}"
                      ToolTip.Tip="When checked (default): walking to a Great Pyramid room drives the party leader up the five-floor puzzle to the top. When unchecked: the walk fails normally instead of handing off to the climb solver. Applies to every character on this install."/>
            <CheckBox Content="Enable the asylum (random-teleport maze) solver"
                      IsChecked="{Binding AsylumSolverEnabled, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked (default): walking to a room inside a random-teleport maze pocket (the Warped Asylum) drives look-peeks and reshuffles until a route exists, then hands the final walk back. When unchecked: the walk fails normally. Applies to every character on this install."/>

            <!-- Paradigm transport-token routing (Global tier). The whole block only
                 shows on a Paradigm realm — tokens are a Paradigm-only item. When on,
                 a walk-to whose destination a held token reaches faster surfaces a
                 (never-auto) blue token card in the route picker. The threshold hides
                 marginal token routes that aren't worth the gold + charge + buff-wipe. -->
            <StackPanel Orientation="Vertical" Spacing="2" IsVisible="{Binding IsParadigmRealm}">
                <TextBlock Classes="FieldLabel" Text="Paradigm transport tokens:" Margin="0,14,0,0"/>
                <CheckBox Content="Offer token routes in the route picker"
                          IsChecked="{Binding EnableTokenRoutes, Mode=TwoWay}"
                          ToolTip.Tip="When checked (default): if a Paradigm transport token you're carrying reaches your walk-to destination meaningfully faster than walking, the route picker shows a blue 'use token' card alongside the normal route. It's never taken automatically — you pick it. Using a token costs gold, spends one of its daily charges, and wipes your buffs (negate magic). When unchecked: token cards never appear. Applies to every character on this install."/>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" VerticalAlignment="Center"
                            IsEnabled="{Binding EnableTokenRoutes}">
                    <TextBlock Classes="FieldLabel" Text="Only when it saves at least"/>
                    <NumericUpDown Value="{Binding TokenRouteMinRoomsShorter, Mode=TwoWay}"
                                   Minimum="1" Maximum="300" Increment="1"
                                   FormatString="0" ShowButtonSpinner="True"
                                   Width="120" MinWidth="120"
                                   ToolTip.Tip="A token route is only offered when it reaches the destination at least this many rooms sooner than walking. A one- or two-room saving isn't worth a token's gold, daily charge, and buff-wipe. Default 50. Applies to every character on this install."/>
                    <TextBlock Classes="FieldLabel" Text="rooms."/>
                </StackPanel>
                <CheckBox Content="Take a token route even if a party member can't follow"
                          IsChecked="{Binding TokenUseWhenPartyIncomplete, Mode=TwoWay}"
                          Margin="0,6,0,0"
                          IsEnabled="{Binding EnableTokenRoutes}"
                          ToolTip.Tip="Only matters as a party leader. On a token route the leader sends the party across FIRST and waits for everyone to follow (retrying a few times), then tokens across itself LAST. When UNCHECKED (default): if a member still can't follow, the leader does NOT token — it stays in the room with the reason in the nav header so you can sort it out. When checked: the leader tokens across anyway and walks on, leaving the stragglers behind. Applies to every character on this install."/>
            </StackPanel>

            <!-- Navigation map re-centre hold (Global tier): after a pan, zoom, floor
                 step or Center on…, the map stays where you looked for this many
                 seconds before following the player again. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,14,0,0" VerticalAlignment="Center">
                <TextBlock Classes="FieldLabel" Text="Navigation map: hold a browsed view for"/>
                <NumericUpDown Value="{Binding MapRecenterHoldSeconds, Mode=TwoWay}"
                               Minimum="0" Maximum="300" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="After you pan or zoom the Navigation map, step floors, or use Center on… / Center on Destination, the map stays where you're looking for this many seconds before it re-centres on you again. 0 = follow you again straight away. Default 15. Applies to every character on this install."/>
                <TextBlock Classes="FieldLabel" Text="seconds before following you again."/>
            </StackPanel>

            <!-- Cleanup-Player-Database row: prose-style "Cleanup Player
                 Database after [spinner] days." — spinner widened from
                 90→120 so 4-digit values (e.g. 3650-day max) render
                 without clipping. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Classes="FieldLabel" Text="Cleanup Player Database after"/>
                <NumericUpDown Value="{Binding PlayerCleanupDays, Mode=TwoWay}"
                               Minimum="0" Maximum="3650" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Stale Players-tab records get dropped at startup once they're older than this. 0 disables auto-cleanup. Per-player 'Don't auto-delete' opts records out individually. Global setting — applies to every character on this install."/>
                <TextBlock Classes="FieldLabel" Text="days."/>
            </StackPanel>

            <!-- Note: the run-away (flee) toggles (Go backwards if running /
                 Break combat before running) graduated to the Combat tab —
                 they sit next to the room thresholds + RunDistance they
                 coordinate with. HealthManager.TryFlee reads RunDirection /
                 BreakBeforeFleeing from CombatSettings now. -->

            <!-- Note: the per-category Verbose toggles + the round-trace
                 toggle moved to the Log pane menu as a single "Combat
                 diagnostics" umbrella switch. The "Log movement hop timing"
                 toggle moved there too (now just "Hop timing", next to
                 "Auto-collect logs"). All are "while I'm debugging right
                 now" affordances, not per-character preferences. -->

            <!-- ============ Location-based auto-equip ============
                 Wear an item while inside a map area, revert on the way out.
                 Each row: a map/room-number block, an And/Or dropdown, a
                 room-name block, then the item to wear. Empty criteria don't
                 constrain; a rule with both filled combines them per the
                 dropdown. Read live by LocationEquipManager off room changes,
                 so the walker / loop / Auto-Lair all honour it, and the
                 Equipment Manager leaves the owned slot alone while inside. -->
            <TextBlock Classes="SectionHeader" Text="LOCATION-BASED AUTO-EQUIP"/>
            <TextBlock Classes="HelpText" Margin="0,0,0,4"
                       Text="Wear an item while inside a map area (matched by room number(s) and/or a room-name substring), then revert the slot when you leave. Handy for area-specific gear like a feathered mask across the Black Wastelands."/>

            <Grid ColumnDefinitions="Auto,130,74,*,150,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Map/room #s" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Match" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Classes="FieldLabel" Text="Room name contains" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Classes="FieldLabel" Text="Wear item" FontWeight="SemiBold"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding LocationEquipRules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocationEquipRuleViewModel">
                        <Grid ColumnDefinitions="Auto,130,74,*,150,Auto" Margin="0,0,0,4">
                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      ToolTip.Tip="Enable this rule. Unchecked rules are kept but never fire."/>
                            <TextBox Grid.Column="1" Margin="6,0,0,0"
                                     Text="{Binding MapRoomNumbers, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="16/153, 154"
                                     ToolTip.Tip="Map/room numbers, comma- or space-separated. '16/153' matches that exact room; a bare '153' matches room 153 in any map. Leave blank to match on room name only."/>
                            <ComboBox Grid.Column="2" Margin="6,0,0,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Static vm:LocationEquipRuleViewModel.MatchModes}"
                                      SelectedItem="{Binding Match, Mode=TwoWay}"
                                      ToolTip.Tip="How the two criteria combine when both are filled: And = must be in the room number(s) AND the name matches; Or = either one."/>
                            <TextBox Grid.Column="3" Margin="6,0,0,0"
                                     Text="{Binding RoomNameContains, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="Black Wastelands"
                                     ToolTip.Tip="Case-insensitive substring the room title must contain. Leave blank to match on map/room number only."/>
                            <TextBox Grid.Column="4" Margin="6,0,0,0"
                                     Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="feathered mask"
                                     ToolTip.Tip="Item to wear while in the area (as it reads in inventory). Worn only when actually carried; the slot reverts to your gear set's item on exit."/>
                            <Button Grid.Column="5" Margin="6,0,0,0" Content="Remove"
                                    Command="{Binding $parent[ItemsControl].((vm:OtherSectionViewModel)DataContext).RemoveLocationEquipRuleCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add rule" Command="{Binding AddLocationEquipRuleCommand}"
                    HorizontalAlignment="Left" Margin="0,4,0,0"/>

            <!-- ============ Inline stub catalog ============
                 Section headers stripped per user direction — the
                 catalog renders as a flat list of rows. The numeric-
                 row template puts the picker INLINE between the
                 label and the suffix (e.g. "Attempt bash [120] times")
                 instead of using a fixed-width left column with the
                 picker pushed right. -->
            <ItemsControl ItemsSource="{Binding StubGroups}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StubGroup">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StubField">
                                    <Grid ColumnDefinitions="*"
                                          Margin="0,3,0,3"
                                          ToolTip.Tip="{Binding Tooltip}">
                                        <!-- Check rows: just the disabled checkbox spanning the row. -->
                                        <CheckBox IsEnabled="False"
                                                  Content="{Binding Label}"
                                                  IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Check}}"/>

                                        <!-- Numeric rows: prose-style with the picker inline.
                                             "Attempt bash [picker] times" — label + picker + suffix. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Numeric}}">
                                            <TextBlock Classes="FieldLabel" Text="{Binding Label}"/>
                                            <NumericUpDown IsEnabled="False"
                                                           Value="0"
                                                           Minimum="{Binding Min}"
                                                           Maximum="{Binding Max}"
                                                           Width="100"/>
                                            <TextBlock Classes="FieldLabel"
                                                       Text="{Binding Suffix}"
                                                       IsVisible="{Binding Suffix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <!-- Text rows: label + textbox horizontally. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Text}}">
                                            <TextBlock Classes="FieldLabel" Text="{Binding Label}"/>
                                            <TextBox IsEnabled="False" Width="220"/>
                                        </StackPanel>

                                        <!-- Note rows: italic prose, no control. -->
                                        <TextBlock Classes="FieldNote"
                                                   Text="{Binding Label}"
                                                   IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Note}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
