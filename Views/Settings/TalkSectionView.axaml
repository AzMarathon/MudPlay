<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
             x:Class="MudPlay.Views.Settings.TalkSectionView"
             x:DataType="vm:TalkSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.HelpText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.emoteRed">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style Selector="TextBlock.WarningText">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,0,0,4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="4"
                    MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Classes="SettingsSectionBanner first" Text="Character profile settings"/>
            <TextBlock Classes="SettingsSectionSub"
                       Text="Everything on this tab saves to the loaded character — each character keeps its own copy."/>
            <Border Classes="SettingsSectionRule"/>

            <!-- ============ Remote-control master switches (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Remote-control master switches"/>

            <CheckBox Content="Disallow all remote control commands"
                      IsChecked="{Binding DisallowAllRemoteCommands, Mode=TwoWay}"
                      ToolTip.Tip="Hard kill-switch. When on, the engine ignores every inbound @-command regardless of channel / sender / handler."/>
            <TextBlock Classes="WarningText"
                       Text="⚠ Warning: this silently blocks ALL inbound @commands — including party heal / cure / coordination requests from your own group."/>

            <CheckBox Content="Disallow @party commands (from any party member)"
                      IsChecked="{Binding DisallowPartyCommands, Mode=TwoWay}"
                      ToolTip.Tip="Stops @party &lt;command&gt; said by a party member from being sent to the game as your own command, whatever the command is. It also takes away a member's free answer to a bare @party (they then need Query health/status). The other party signals (@wait, @ok, @comeback, @share) are not affected."/>

            <!-- ============ Per-channel disable (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Per-channel disable"/>
            <TextBlock Classes="HelpText"
                       Margin="0,0,0,4"
                       Text="The channels the engine listens on. Broadcast (the numbered channel you join) is public, so it is listened on only when its box is unticked. Gossip / Auction / Yell are hard-excluded engine-wide and don't need a toggle."/>

            <CheckBox Content="Disallow @commands from telepaths / pages"
                      IsChecked="{Binding DisallowRemoteFromTelepaths, Mode=TwoWay}"
                      ToolTip.Tip="Drop @commands arriving via /name or `t name`."/>
            <CheckBox Content="Disallow @commands from gangpaths"
                      IsChecked="{Binding DisallowRemoteFromGangpaths, Mode=TwoWay}"
                      ToolTip.Tip="Drop @commands arriving on the gang / guild channel."/>
            <CheckBox Content="Disallow @commands from say (local)"
                      IsChecked="{Binding DisallowRemoteFromLocal, Mode=TwoWay}"
                      ToolTip.Tip="Drop @commands arriving via local-room say."/>
            <CheckBox Content="Disallow @commands from broadcast"
                      IsChecked="{Binding DisallowRemoteFromBroadcast, Mode=TwoWay}"
                      ToolTip.Tip="Drop @commands arriving on the broadcast channel (the numbered channel you join and speak on with br). Ticked by default: it is a public channel anyone can join. Unticked, @commands are read there as on the other channels: anyone who has joined the channel can send one, and each is still subject to that player's permissions. Your client answers each player there once a minute."/>

            <!-- ============ Denial reply (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Denial reply"/>

            <CheckBox Content="Warn sender on invalid / denied remote command"
                      IsChecked="{Binding WarnOnInvalidRemoteCommand, Mode=TwoWay}"
                      ToolTip.Tip="Answer the sender when a command is refused or can't be carried out: no permission, a name that matches nothing, nothing to do. Off, none of those is answered. Never answered either way: an @ word that is no command, the hard-blocks (reroll, @party set suicide), anything while Auto-All is off, and the switches above. Answers another MudPlay client waits on (a leader's reply to @comeback, a trap result) are sent either way."/>

            <Grid ColumnDefinitions="180,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Failure message"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding RemoteCommandFailureMessage, Mode=TwoWay}"
                          IsEnabled="{Binding WarnOnInvalidRemoteCommand}"
                          MaxWidth="380" HorizontalAlignment="Left"
                          ToolTip.Tip="Sent to a sender who lacks the permission for a command (or isn't in your party, for the party signals), and for a refusal with no reason of its own. Left empty, those get no answer."/>
            </Grid>

            <!-- ============ Chat etiquette ============ -->
            <CheckBox Content="Greet players when first met"
                      IsChecked="{Binding GreetPlayersWhenFirstMet, Mode=TwoWay}"
                      ToolTip.Tip="The first time each day a non-party player appears (Also here list or live arrival), send greet then look at them. Tracked per-BBS; self and party members are skipped."/>

            <CheckBox Content="Look back when a player looks at us"
                      IsChecked="{Binding LookBackWhenLookedAt, Mode=TwoWay}"
                      ToolTip.Tip="When the game shows &quot;&lt;name&gt; is looking at you.&quot;, send look at them in return. Fires each time; only ourself is skipped (party members included)."/>

            <CheckBox Content="Look at players to learn/update their inventories"
                      IsChecked="{Binding LookAtPlayersOnArrival, Mode=TwoWay}"
                      ToolTip.Tip="When a non-party player walks into the room, look at them to learn or refresh their equipment. One look per arrival; self and party members are skipped."/>

            <!-- ============ Session logging (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Session logging"/>
            <TextBlock Classes="HelpText"
                       Margin="0,0,0,4"
                       Text="Persist to rolling per-character files in the Logs folder (Tools → Open Logs folder…) so they survive restarts: &lt;char&gt;.&lt;bbs&gt;.talk.log and &lt;char&gt;.&lt;bbs&gt;.transactions.log. Clearing a window (Clear chatlog / Transaction history Clear) also wipes its file."/>

            <CheckBox Content="Log conversations"
                      IsChecked="{Binding LogConversations, Mode=TwoWay}"
                      ToolTip.Tip="Append every Conversation-window line to &lt;char&gt;.&lt;bbs&gt;.talk.log."/>
            <CheckBox Content="Log transactions"
                      IsChecked="{Binding LogTransactions, Mode=TwoWay}"
                      ToolTip.Tip="Append every Session Stats → Transaction history entry to &lt;char&gt;.&lt;bbs&gt;.transactions.log."/>

            <Grid ColumnDefinitions="180,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Log line limit"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding LogMaxLines, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Minimum="100" Maximum="100000" Increment="500"
                               FormatString="0" Width="140" HorizontalAlignment="Left"
                               ToolTip.Tip="Both logs keep only their last N lines on disk (shared cap). The oldest lines roll off as new ones arrive."/>
            </Grid>

            <!-- ============ Conversation emotes ============ -->
            <TextBlock Classes="SectionHeader" Text="Conversation emotes"/>
            <CheckBox Content="Show emoji / emotes in the conversation window"
                      IsChecked="{Binding ConvoShowEmotes, Mode=TwoWay}"
                      ToolTip.Tip="Substitute emoji shortcodes (:lol:) and emoticons (:) ) with emoji, and render image emotes (the bundled Pepe set) inline. Unicode emoji need a colour-emoji font installed on your system."/>
            <TextBlock Classes="HelpText"
                       Margin="0,0,0,4"
                       Text="Turns :lol: / :) / :( and the bundled image emotes into pictures in the Conversation window. Unicode emoji rely on a colour-emoji font being installed."/>

            <!-- ============ Custom emotes ============ -->
            <TextBlock Classes="SectionHeader" Text="Custom emotes"/>
            <TextBlock Classes="HelpText" Margin="0,0,0,4"
                       Text="Define emoji's here, set a shortcode, image and hit add or select one in the list to change it."/>

            <!-- Editor: shortcode + emoji, a preview, then Select image / Add to emoji list -->
            <Grid ColumnDefinitions="Auto,150,Auto,*,Auto,Auto,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text=":" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" PlaceholderText="shortcode"
                         Text="{Binding NewEmoteShortcode, Mode=TwoWay}"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="2" Classes="FieldLabel" Text=":" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" PlaceholderText="paste an emoji — or Select image →"
                         Text="{Binding NewEmoteEmoji, Mode=TwoWay}"
                         IsEnabled="{Binding !HasPendingImage}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="4" Width="30" Height="26" Margin="0,0,8,0"
                        Background="#0DFFFFFF" CornerRadius="{StaticResource CornerSm}"
                        ToolTip.Tip="Preview of the emoji / image you're adding.">
                    <Panel>
                        <Image Source="{Binding PendingImagePreview}" IsVisible="{Binding HasPendingImage}"
                               Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EmotePreviewText}" FontSize="18" IsVisible="{Binding !HasPendingImage}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                </Border>
                <Button Grid.Column="5" Content="Select image…" Margin="0,0,4,0"
                        Command="{Binding SelectImageCommand}"/>
                <Button Grid.Column="6" Content="Add to emoji list"
                        Command="{Binding AddToEmojiListCommand}"/>
            </Grid>

            <!-- Filter + list of all emotes (defaults + custom + imports). -->
            <TextBox Margin="0,6,0,0" PlaceholderText="Filter emotes…"
                     Text="{Binding EmoteFilter, Mode=TwoWay}"/>
            <ListBox Margin="0,4,0,0" MinHeight="60" MaxHeight="240"
                     ItemsSource="{Binding UserEmotes}"
                     SelectedItem="{Binding SelectedEmoteRow, Mode=TwoWay}"
                     BorderBrush="{StaticResource ChromeBorderSoftBrush}" BorderThickness="1"
                     CornerRadius="{StaticResource CornerSm}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:EmoteRowViewModel">
                        <Grid ColumnDefinitions="28,180,*,Auto" Margin="2">
                            <Image Grid.Column="0" Source="{Binding PreviewImage}" Height="20"
                                   IsVisible="{Binding IsImage}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="0" Text="{Binding PreviewText}" FontSize="16"
                                       IsVisible="{Binding IsText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Display}"
                                       Classes.emoteRed="{Binding IsRed}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="HelpText"
                                       Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="{Binding ActionLabel}" Padding="8,2"
                                    Command="{Binding $parent[ListBox].DataContext.RemoveEmoteCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Content="Export set…" Command="{Binding ExportEmotesCommand}"/>
                <Button Content="Import pack / zip…" Command="{Binding ImportPackCommand}"/>
                <Button Content="Import folder…" Command="{Binding ImportFolderCommand}"/>
                <TextBlock Text="{Binding EmoteStatus}" Classes="HelpText" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ============ Conversation window font ============ -->
            <TextBlock Classes="SectionHeader" Text="Conversation window font"/>
            <TextBlock Classes="HelpText"
                       Margin="0,0,0,4"
                       Text="Font and size the Conversation window renders its chat rows with. Sizes are in points, the same scale as the terminal font. Applies to an open window as soon as you save."/>

            <Grid ColumnDefinitions="180,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Font"/>
                <ComboBox Grid.Column="1"
                          Width="240" HorizontalAlignment="Left"
                          ItemsSource="{Binding ConvoFontOptions}"
                          SelectedItem="{Binding SelectedConvoFont, Mode=TwoWay}"
                          ToolTip.Tip="Row font for the Conversation window. JetBrains Mono is the bundled default; IBM Plex Sans is the proportional chrome font; MX437 is the CP437 bitmap terminal font. Every text font installed on your system is listed below them — proportional fonts included, since chat rows aren't a fixed grid like the terminal.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontFamilyOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid ColumnDefinitions="180,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Font size"/>
                <ComboBox Grid.Column="1"
                          Width="240" HorizontalAlignment="Left"
                          ItemsSource="{Binding ConvoFontSizeOptions}"
                          SelectedItem="{Binding SelectedConvoFontSize, Mode=TwoWay}"
                          ToolTip.Tip="Message-body font size in points (8–32, the same range as the terminal). Timestamp / channel tag / speaker render one point smaller.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontSizeOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- ============ Channel colours ============ -->
            <TextBlock Classes="SectionHeader" Text="Channel colours"/>
            <TextBlock Classes="HelpText"
                       Margin="0,0,0,4"
                       Text="Per-channel colours for the Conversation window. Accent tints the channel tag, speaker name and filter toggle; Text tints the message body. Click a swatch to pick a colour visually; Reset returns a slot to the theme default. Applies to the open window as soon as you click OK or Apply."/>

            <Grid ColumnDefinitions="90,190,20,190" Margin="0,2,0,2">
                <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Accent"/>
                <TextBlock Grid.Column="3" Classes="FieldLabel" Text="Text"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding ChannelColorRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChannelColorRowViewModel">
                        <Grid ColumnDefinitions="90,190,20,190" Margin="0,3">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="{Binding Name}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Padding="2" VerticalAlignment="Center"
                                        ToolTip.Tip="Accent colour — the channel tag, speaker name and filter toggle. Click to pick.">
                                    <Border Width="46" Height="18"
                                            Background="{Binding LabelSwatch}"
                                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerSm}"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <LayoutTransformControl>
                                                <LayoutTransformControl.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                </LayoutTransformControl.LayoutTransform>
                                                <ColorView Color="{Binding LabelColor, Mode=TwoWay}"
                                                           IsAlphaEnabled="False"/>
                                            </LayoutTransformControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="Reset" Command="{Binding ResetLabelCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Reset the accent colour to the theme default."/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                <Button Padding="2" VerticalAlignment="Center"
                                        ToolTip.Tip="Message-body text colour. Click to pick.">
                                    <Border Width="46" Height="18"
                                            Background="{Binding TextSwatch}"
                                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerSm}"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <LayoutTransformControl>
                                                <LayoutTransformControl.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                </LayoutTransformControl.LayoutTransform>
                                                <ColorView Color="{Binding TextColor, Mode=TwoWay}"
                                                           IsAlphaEnabled="False"/>
                                            </LayoutTransformControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="Reset" Command="{Binding ResetTextCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Reset the message-body colour to the theme default."/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
