<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:settings="using:MudPlay.Views.Settings"
             xmlns:spells="using:MudPlay.Game.Spells"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="900"
             x:Class="MudPlay.Views.Settings.SpellsSectionView"
             x:DataType="vm:SpellsSectionViewModel">

    <UserControl.Resources>
        <!-- Dropdown row: "code — name". The box commits the Short cast-code
             (ValueMemberBinding); this template only shapes the list display.
             Spells this character hasn't learned are struck through + dimmed.
             (Cast-on-use ITEMS in the bless picker report Learned = true, so
             they're never struck — you possess them, you don't learn them.) -->
        <DataTemplate x:Key="SpellPickItem" x:DataType="spells:SpellPick">
            <TextBlock Text="{Binding Display}" Classes.unlearnedPick="{Binding !Learned}"/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Unlearned dropdown row: struck through + dimmed. -->
        <Style Selector="TextBlock.unlearnedPick">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <!-- A slot pointed at an unlearned spell: red outline warning (still saved). -->
        <Style Selector="AutoCompleteBox.unlearnedSpell">
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="AutoCompleteBox.unlearnedSpell /template/ TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- No-profile banner. -->
            <Border IsVisible="{Binding !HasProfile}" Padding="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Spells"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Load or create a character profile to edit spell picks."
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasProfile}"
                        Margin="22" Spacing="4"
                        MaxWidth="700" HorizontalAlignment="Left">

                <TextBlock Classes="SettingsSectionBanner first" Text="Character profile settings"/>
                <TextBlock Classes="SettingsSectionSub"
                           Text="Everything on this tab saves to the loaded character — each character keeps its own copy."/>
                <Border Classes="SettingsSectionRule"/>
                <!-- Switch combat profiles from this tab too (the Combat tab's chips), to
                     compare or set profiles without going back and forth. -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <TextBlock Classes="FieldLabel" Text="Combat profile:" VerticalAlignment="Center"/>
                    <settings:CombatProfileChipBar DataContext="{Binding ChipBar}"/>
                </StackPanel>



                <!-- ============ Spell type priority (per profile) ============ -->
                <Panel Classes="ProfileFrame">
                    <Border Classes="ProfileGroup" IsVisible="{Binding SpellPriorityInProfile.IsIncluded}"
                            Background="{Binding ActiveProfileAccentSoftBrush}"
                            BorderBrush="{Binding ActiveProfileAccentBrush}"/>
                    <StackPanel Classes="ProfileBody">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Classes="ProfileInclude"
                                      IsChecked="{Binding SpellPriorityInProfile.IsIncluded, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding SpellPriorityInProfile.Tooltip}"/>
                            <TextBlock DockPanel.Dock="Right" Classes="ProfileGroupHeader" Text="{Binding ActiveProfileLabel}"
                                       Foreground="{Binding ActiveProfileAccentBrush}"
                                       IsVisible="{Binding SpellPriorityInProfile.IsIncluded}"/>
                            <TextBlock Classes="SectionHeader" Margin="0,2,0,4" Text="Spell type priority (between-round casting order)"/>
                        </DockPanel>
                                <TextBlock Text="Use the arrows to reorder. Higher in the list = cast earlier. The between-round cast engine evaluates categories top-to-bottom each tick."
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <settings:PriorityRankingView DataContext="{Binding Priority}"
                                                              HorizontalAlignment="Left"/>
                    </StackPanel>
                </Panel>

                <!-- ============ Healing / regeneration (per profile) ============ -->
                <Panel Classes="ProfileFrame">
                    <Border Classes="ProfileGroup" IsVisible="{Binding HealingRegenInProfile.IsIncluded}"
                            Background="{Binding ActiveProfileAccentSoftBrush}"
                            BorderBrush="{Binding ActiveProfileAccentBrush}"/>
                    <StackPanel Classes="ProfileBody">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Classes="ProfileInclude"
                                      IsChecked="{Binding HealingRegenInProfile.IsIncluded, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding HealingRegenInProfile.Tooltip}"/>
                            <TextBlock DockPanel.Dock="Right" Classes="ProfileGroupHeader" Text="{Binding ActiveProfileLabel}"
                                       Foreground="{Binding ActiveProfileAccentBrush}"
                                       IsVisible="{Binding HealingRegenInProfile.IsIncluded}"/>
                            <TextBlock Classes="SectionHeader" Margin="0,2,0,4" Text="Healing / regeneration"/>
                        </DockPanel>
                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Minor heal"/>
                            <AutoCompleteBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding MinorHealSpell, Mode=TwoWay}"
                                             Classes.unlearnedSpell="{Binding MinorHealSpellUnlearned}"
                                             ItemsSource="{Binding SpellSuggestions}"
                                             ValueMemberBinding="{ReflectionBinding Short}"
                                             ItemFilter="{Binding SpellSuggestionFilter}"
                                             ItemTemplate="{StaticResource SpellPickItem}"
                                             PlaceholderText="Type code or name…"
                                             Width="260" HorizontalAlignment="Left"
                                             ToolTip.Tip="Cheap self-heal — fires when Health → Minor heal (combat) threshold trips, or Health → Heal (rest) during rest. Suggestions come from this class's known spells."/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Major heal"/>
                            <AutoCompleteBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding MajorHealSpell, Mode=TwoWay}"
                                             Classes.unlearnedSpell="{Binding MajorHealSpellUnlearned}"
                                             ItemsSource="{Binding SpellSuggestions}"
                                             ValueMemberBinding="{ReflectionBinding Short}"
                                             ItemFilter="{Binding SpellSuggestionFilter}"
                                             ItemTemplate="{StaticResource SpellPickItem}"
                                             PlaceholderText="Type code or name…"
                                             Width="260" HorizontalAlignment="Left"
                                             ToolTip.Tip="Expensive self-heal — fires when Health → Major heal (combat) threshold trips."/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Emergency heal"/>
                            <AutoCompleteBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding EmergencyHealSpell, Mode=TwoWay}"
                                             Classes.unlearnedSpell="{Binding EmergencyHealSpellUnlearned}"
                                             ItemsSource="{Binding SpellSuggestions}"
                                             ValueMemberBinding="{ReflectionBinding Short}"
                                             ItemFilter="{Binding SpellSuggestionFilter}"
                                             ItemTemplate="{StaticResource SpellPickItem}"
                                             PlaceholderText="Type code or name…"
                                             Width="260" HorizontalAlignment="Left"
                                             ToolTip.Tip="Last-resort self-save — fires when the Health → Emergency heal threshold trips. It&apos;s a row in the spell-type priority list above, defaulting to slot 1 so it leads by default; reorder it there like any other. Fires in any state (combat/rest/walk) and ignores the mana-floor gate — an emergency spends whatever mana is left (it still won&apos;t attempt a spell it can&apos;t afford). Falls back to Major then Minor heal when left blank."/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="HP Regen"/>
                            <AutoCompleteBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding HpRegenSpell, Mode=TwoWay}"
                                             Classes.unlearnedSpell="{Binding HpRegenSpellUnlearned}"
                                             ItemsSource="{Binding SpellSuggestions}"
                                             ValueMemberBinding="{ReflectionBinding Short}"
                                             ItemFilter="{Binding SpellSuggestionFilter}"
                                             ItemTemplate="{StaticResource SpellPickItem}"
                                             PlaceholderText="Type code or name…"
                                             Width="260" HorizontalAlignment="Left"
                                             ToolTip.Tip="HP-regen HoT (e.g. regeneration) used as assisted healing: when the Minor heal threshold trips, this is cast FIRST — ahead of the single-target minor heal — unless HP is already in life-threat range or the HoT is still ticking. Want it kept always-up instead? Put it in a Bless slot."/>
                        </Grid>
                    </StackPanel>
                </Panel>

                <!-- ============ Other spells ============ -->
                <TextBlock Classes="SectionHeader" Text="Other spells"/>
                <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Cure Holds"/>
                    <AutoCompleteBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding CureHoldsSpell, Mode=TwoWay}"
                                     Classes.unlearnedSpell="{Binding CureHoldsSpellUnlearned}"
                                     ItemsSource="{Binding SpellSuggestions}"
                                     ValueMemberBinding="{ReflectionBinding Short}"
                                     ItemFilter="{Binding SpellSuggestionFilter}"
                                     ItemTemplate="{StaticResource SpellPickItem}"
                                     PlaceholderText="Type code or name…"
                                     Width="260" HorizontalAlignment="Left"
                                     ToolTip.Tip="Cure-paralyze / cure-hold spell — canonically `freedom` in stock MajorMUD."/>
                    <CheckBox Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              Content="Cure after combat"
                              IsChecked="{Binding CureHoldsAfterCombat, Mode=TwoWay}"
                              ToolTip.Tip="Ticked: this cure waits until the fight is over (no monster left to fight), on you or a party member, so the round's one between-round cast stays free for healing. Unticked: it is cast between rounds as soon as nothing ranked above Curing is due."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Cure poison"/>
                    <AutoCompleteBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding CurePoisonSpell, Mode=TwoWay}"
                                     Classes.unlearnedSpell="{Binding CurePoisonSpellUnlearned}"
                                     ItemsSource="{Binding SpellSuggestions}"
                                     ValueMemberBinding="{ReflectionBinding Short}"
                                     ItemFilter="{Binding SpellSuggestionFilter}"
                                     ItemTemplate="{StaticResource SpellPickItem}"
                                     PlaceholderText="Type code or name…"
                                     Width="260" HorizontalAlignment="Left"
                                     ToolTip.Tip="Cure-poison spell."/>
                    <CheckBox Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              Content="Cure after combat"
                              IsChecked="{Binding CurePoisonAfterCombat, Mode=TwoWay}"
                              ToolTip.Tip="Ticked: this cure waits until the fight is over (no monster left to fight), on you or a party member, so the round's one between-round cast stays free for healing. Unticked: it is cast between rounds as soon as nothing ranked above Curing is due."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Cure disease"/>
                    <AutoCompleteBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding CureDiseaseSpell, Mode=TwoWay}"
                                     Classes.unlearnedSpell="{Binding CureDiseaseSpellUnlearned}"
                                     ItemsSource="{Binding SpellSuggestions}"
                                     ValueMemberBinding="{ReflectionBinding Short}"
                                     ItemFilter="{Binding SpellSuggestionFilter}"
                                     ItemTemplate="{StaticResource SpellPickItem}"
                                     PlaceholderText="Type code or name…"
                                     Width="260" HorizontalAlignment="Left"
                                     ToolTip.Tip="Cure-disease spell."/>
                    <CheckBox Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              Content="Cure after combat"
                              IsChecked="{Binding CureDiseaseAfterCombat, Mode=TwoWay}"
                              ToolTip.Tip="Ticked: this cure waits until the fight is over (no monster left to fight), on you or a party member, so the round's one between-round cast stays free for healing. Unticked: it is cast between rounds as soon as nothing ranked above Curing is due."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Cure blindness"/>
                    <AutoCompleteBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding CureBlindnessSpell, Mode=TwoWay}"
                                     Classes.unlearnedSpell="{Binding CureBlindnessSpellUnlearned}"
                                     ItemsSource="{Binding SpellSuggestions}"
                                     ValueMemberBinding="{ReflectionBinding Short}"
                                     ItemFilter="{Binding SpellSuggestionFilter}"
                                     ItemTemplate="{StaticResource SpellPickItem}"
                                     PlaceholderText="Type code or name…"
                                     Width="260" HorizontalAlignment="Left"
                                     ToolTip.Tip="Cure-blindness spell."/>
                    <CheckBox Grid.Row="3" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              Content="Cure after combat"
                              IsChecked="{Binding CureBlindnessAfterCombat, Mode=TwoWay}"
                              ToolTip.Tip="Ticked: this cure waits until the fight is over (no monster left to fight), on you or a party member, so the round's one between-round cast stays free for healing. Unticked: it is cast between rounds as soon as nothing ranked above Curing is due."/>
                </Grid>

                <!-- Self-bless spell picks + the "when HP/MA full" utility casts
                     moved to the unified Buff Watchdog list; only the timing
                     gates below still live on this tab. -->
                <TextBlock Text="Self bless slots and the “when HP full / MA full” buffs are configured in the Buff Watchdog window (View → Buff Watchdog)."
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="440" HorizontalAlignment="Left"
                           Margin="0,16,0,0"/>

                <!-- Self-bless timing: when the self-buff path may recast. Both
                     scoped to OUR OWN buffs (the party-bless equivalents live on
                     the Party tab). Defaults reproduce the old behaviour — cast
                     out of combat, including while resting — so a profile that
                     leaves these alone is unchanged. -->
                <Panel Classes="ProfileFrame">
                    <Border Classes="ProfileGroup" IsVisible="{Binding BlessTimingInProfile.IsIncluded}"
                            Background="{Binding ActiveProfileAccentSoftBrush}"
                            BorderBrush="{Binding ActiveProfileAccentBrush}"/>
                    <StackPanel Classes="ProfileBody">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Classes="ProfileInclude"
                                      IsChecked="{Binding BlessTimingInProfile.IsIncluded, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding BlessTimingInProfile.Tooltip}"/>
                            <TextBlock DockPanel.Dock="Right" Classes="ProfileGroupHeader" Text="{Binding ActiveProfileLabel}"
                                       Foreground="{Binding ActiveProfileAccentBrush}"
                                       IsVisible="{Binding BlessTimingInProfile.IsIncluded}"/>
                            <TextBlock Classes="SectionHeader" Margin="0,2,0,4" Text="Bless timing"/>
                        </DockPanel>
                        <CheckBox Content="Bless self while resting" IsChecked="{Binding SelfBlessWhileResting, Mode=TwoWay}"
                                  ToolTip.Tip="When checked (default): keep self-buffs up while resting. Uncheck to hold self-bless casts during rest."/>
                        <CheckBox Content="Bless self during combat" IsChecked="{Binding SelfBlessDuringCombat, Mode=TwoWay}"
                                  ToolTip.Tip="When checked: recast self-buffs mid-fight — casting spends that combat round. Off by default; useful when a fast hunting loop rarely leaves combat long enough to bless between fights."/>
                    </StackPanel>
                </Panel>

                <!-- ============ Ailment handling / coordination ============ -->
                <!-- One "Ignore X" toggle per ailment. It's the single "I don't
                     care about this ailment" gate: checking it suppresses BOTH the
                     @wait sent to the party leader AND the ".@blind" say broadcast
                     that lets other MudPlay clients mirror it. Sits on the Spells
                     tab next to the cure-spell picks it coordinates with;
                     AilmentSyncEngine reads these from SpellsSettings. -->
                <TextBlock Classes="SectionHeader" Text="Ailment handling / coordination"/>
                <CheckBox Content="Ignore poison"    IsChecked="{Binding IgnorePoison, Mode=TwoWay}"
                          ToolTip.Tip="When checked: poison neither pauses the party (@wait) nor is announced on say. Always-on triggers (over-encumbered, MovementPrevented, Stunned) still pause regardless. (Poison is read from the par screen, so it never announces on say anyway.)"/>
                <CheckBox Content="Ignore blindness" IsChecked="{Binding IgnoreBlindness, Mode=TwoWay}"
                          ToolTip.Tip="When checked: being blinded neither pauses the party (@wait) nor sends `.@blind` on say."/>
                <CheckBox Content="Ignore confusion" IsChecked="{Binding IgnoreConfusion, Mode=TwoWay}"
                          ToolTip.Tip="When checked: being confused neither pauses the party (@wait) nor sends `.@confused` on say. Caster parties often want to leave this UNCHECKED — confusion makes our cast fail randomly."/>
                <CheckBox Content="Ignore diseased"  IsChecked="{Binding IgnoreDiseased, Mode=TwoWay}"
                          ToolTip.Tip="When checked: being diseased neither pauses the party (@wait) nor sends `.@diseased` on say."/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
