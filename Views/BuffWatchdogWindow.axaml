<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="420"
        x:Class="MudPlay.Views.BuffWatchdogWindow"
        x:DataType="vm:BuffWatchdogViewModel"
        Title="Buff Watchdog"
        Width="380" Height="440"
        MinWidth="320" MinHeight="120"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Section header (Self buffs / Party buffs). -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Margin" Value="10,10,10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>

        <!-- Outlined buff active-timer bar frame (the sunken track sits inside it, the
             elapsed fill grows edge-to-edge within, so the outline marks the true 0%/100%). -->
        <Style Selector="Border.BuffBarFrame">
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The elapsed-time fill — an exact-width Border (FillWidthPx), so its right edge
             meets the recast marker and the frame edge. Green normally, amber in-window. -->
        <Style Selector="Border.BuffFill">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Border.BuffFill.recast">
            <Setter Property="Background" Value="{StaticResource AccentYellowBrush}"/>
        </Style>
        <!-- Dark scrim behind the in-bar label so the text reads over any fill colour
             (bright green would otherwise glare under white text). -->
        <Style Selector="Border.BarScrim">
            <Setter Property="Background" Value="#80101418"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>

        <!-- Remaining-time label inside the bar, offset after the name. -->
        <Style Selector="TextBlock.BarTime">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>

        <!-- 4-letter buff code / #item label, rendered left-aligned INSIDE the bar. -->
        <Style Selector="TextBlock.BarName">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>

        <!-- "unlearned" chip on a configured buff the character hasn't learned. -->
        <Style Selector="Border.UnlearnedChip">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Border.UnlearnedChip > TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Top"
                   Margin="10,12,10,10"
                   Text="No buffs configured. Set up bless slots / regen / party buffs in the Player Workshop and Party windows."
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsEmpty}"/>

        <ScrollViewer>
            <StackPanel>

                <!-- ===== Self buffs ===== -->
                <TextBlock Classes="SectionHeader" Text="Self buffs" IsVisible="{Binding HasSelfBuffs}"/>
                <ItemsControl ItemsSource="{Binding SelfBuffs}"
                              Background="{StaticResource ChromeBgSunkenBrush}"
                              Margin="6,0"
                              Padding="2"
                              IsVisible="{Binding HasSelfBuffs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BuffWatchdogRowViewModel">
                            <Border BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,4">
                                <!-- Fixed-width bar area (220px): the sunken track fills the
                                     frame, the elapsed fill (FillWidthPx) grows from the left
                                     edge, and the recast marker (fraction × 220) lands exactly
                                     where the fill will reach it. Name + time sit left-aligned
                                     inside, on a dark scrim so they read over the fill. -->
                                <Border Classes="BuffBarFrame">
                                    <Grid Width="220" Height="16"
                                          Background="{StaticResource ChromeBgSunkenBrush}"
                                          ClipToBounds="True">
                                        <Border Classes="BuffFill"
                                                Classes.recast="{Binding InRecastWindow}"
                                                HorizontalAlignment="Left"
                                                Width="{Binding FillWidthPx}"/>
                                        <Rectangle Width="2"
                                                   Fill="{StaticResource AccentYellowBrush}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Stretch"
                                                   Margin="{Binding RecastMarkerMargin}"
                                                   IsVisible="{Binding ShowRecastMarker}"/>
                                        <Border Classes="BarScrim">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Classes="BarName" Text="{Binding Name}"/>
                                                <Border Classes="UnlearnedChip" IsVisible="{Binding !IsLearned}">
                                                    <TextBlock Text="unlearned"/>
                                                </Border>
                                                <TextBlock Classes="BarTime" Text="{Binding TimeText}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Party buffs ===== -->
                <TextBlock Classes="SectionHeader" Text="Party buffs" IsVisible="{Binding HasPartyBuffs}"/>
                <ItemsControl ItemsSource="{Binding PartyBuffs}"
                              Background="{StaticResource ChromeBgSunkenBrush}"
                              Margin="6,0,6,8"
                              Padding="2"
                              IsVisible="{Binding HasPartyBuffs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BuffWatchdogRowViewModel">
                            <Border BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,4">
                                <StackPanel VerticalAlignment="Center">
                                    <Border Classes="BuffBarFrame">
                                        <Grid Width="220" Height="16"
                                              Background="{StaticResource ChromeBgSunkenBrush}"
                                              ClipToBounds="True">
                                            <Border Classes="BuffFill"
                                                    Classes.recast="{Binding InRecastWindow}"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding FillWidthPx}"/>
                                            <Rectangle Width="2"
                                                       Fill="{StaticResource AccentYellowBrush}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Stretch"
                                                       Margin="{Binding RecastMarkerMargin}"
                                                       IsVisible="{Binding ShowRecastMarker}"/>
                                            <Border Classes="BarScrim">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Classes="BarName" Text="{Binding Name}"/>
                                                    <Border Classes="UnlearnedChip" IsVisible="{Binding !IsLearned}">
                                                        <TextBlock Text="unlearned"/>
                                                    </Border>
                                                    <TextBlock Classes="BarTime" Text="{Binding TimeText}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Party target (member / class) as a caption under the bar. -->
                                    <TextBlock Text="{Binding TargetText}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,1,0,0"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
