<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="420"
        x:Class="MudPlay.Views.BuffWatchdogWindow"
        x:DataType="vm:BuffWatchdogViewModel"
        Title="Buff Watchdog"
        Width="380" Height="440"
        MinWidth="320" MinHeight="120"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- One config-panel row, shared by the ordinary-spell list and the
             "Weapons" (#item-cast) list below it — same columns as the header
             Grid so both stay aligned. Column 0's name cell is itself a Grid
             (Auto,Auto,*,Auto,Auto), not a StackPanel: a StackPanel never
             constrains a child's width, so TextTrimming="CharacterEllipsis" on
             the name TextBlock had nothing to trim against and a long name (esp.
             once the "(Lvl N)" tag was added) painted straight through the Self
             checkbox in the next column instead of eliding. The "*" column here
             is what actually gives the name a bounded width to ellipsize into. -->
        <DataTemplate x:Key="BuffSlotRowTemplate" x:DataType="vm:BuffSlotRowViewModel">
            <Border BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                    BorderThickness="0,0,0,1" Padding="6,3" Cursor="Hand"
                    ToolTip.Tip="Double-click to edit this buff's spell / recast / conditions"
                    DoubleTapped="OnBuffRowDoubleTapped">
                <Grid ColumnDefinitions="240,40,56,*">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Grid.Column="0" Content="✎" Width="20" Height="20" Padding="0" FontSize="11"
                                ToolTip.Tip="Edit this buff / recast timer"
                                Command="{Binding $parent[ItemsControl].((vm:BuffPanelViewModel)DataContext).EditBuffCommand}"
                                CommandParameter="{Binding}"/>
                        <Button Grid.Column="1" Content="⨯" Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                ToolTip.Tip="Remove this buff slot"
                                Command="{Binding $parent[ItemsControl].((vm:BuffPanelViewModel)DataContext).RemoveBuffCommand}"
                                CommandParameter="{Binding}"/>
                        <TextBlock Grid.Column="2" Text="{Binding HeaderText}" FontWeight="SemiBold" Margin="4,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- Warning marker: this buff and another configured slot remove
                             each other via RemovesSpell whenever they can land on the
                             same character — see AppServices.BuffSlotOverwritePairs. -->
                        <TextBlock Grid.Column="3" Text="⚠" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{StaticResource AccentRedBrush}"
                                   IsVisible="{Binding HasOverwriteWarning}"
                                   ToolTip.Tip="{Binding OverwriteWarningTooltip}"/>
                        <!-- "Add all blesses" can list a buff the class can learn that
                             this character hasn't trained yet — flag it the same way
                             the read-only timer bars already do. -->
                        <Border Grid.Column="4" Classes="UnlearnedChip" IsVisible="{Binding !IsLearned}"
                                ToolTip.Tip="Not learned yet — checking this won't cast until you've trained it.">
                            <TextBlock Text="unlearned"/>
                        </Border>
                    </Grid>

                    <!-- Self checkbox — shown for a self-only or single-target buff. -->
                    <CheckBox Grid.Column="1" MinHeight="0" HorizontalAlignment="Center"
                              IsVisible="{Binding ShowSelf}"
                              IsChecked="{Binding CastOnSelf, Mode=TwoWay}"
                              ToolTip.Tip="Cast this buff on yourself."/>

                    <!-- "All/None" master over the party MEMBERS only (independent of Self):
                         ticked blesses every member incl. joiners; unticked blesses none.
                         Hidden when solo (no party to target). -->
                    <CheckBox Grid.Column="2" MinHeight="0" HorizontalAlignment="Center"
                              IsVisible="{Binding ShowMemberTargets}"
                              IsChecked="{Binding AllTargets, Mode=TwoWay}"
                              ToolTip.Tip="Cast on every party member, auto-adapting as members join or leave. Untick for none. (Self is separate.)"/>
                    <CheckBox Grid.Column="2" MinHeight="0" HorizontalAlignment="Center"
                              IsVisible="{Binding IsWholeParty}"
                              IsChecked="{Binding WholePartyOn, Mode=TwoWay}"
                              ToolTip.Tip="Cast on the whole party in one go."/>

                    <ItemsControl Grid.Column="3" ItemsSource="{Binding MemberTargets}"
                                  IsVisible="{Binding ShowMemberTargets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuffMemberToggle">
                                <Panel Width="56">
                                    <CheckBox MinHeight="0" HorizontalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              ToolTip.Tip="{Binding DisplayName}"/>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12"
                                IsVisible="{Binding IsWholeParty}" VerticalAlignment="Center">
                        <TextBlock Text="Party" Margin="4,0,0,0" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <!-- Solo: also cast this whole-party buff while alone. The
                             on/off checkbox in the All-none column stays as the "cast it
                             party-wide while in a party" toggle. -->
                        <CheckBox Content="Solo" MinHeight="0" FontSize="11"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding CastSolo, Mode=TwoWay}"
                                  ToolTip.Tip="Also cast this whole-party buff while you're solo — a lone character is a party of one, so it still lands on you."/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Section header (Self buffs / Party buffs). -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Margin" Value="10,10,10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>

        <!-- Buff active-timer bar frame: a LIGHT-green outline over a very-dark-green
             track, stretched to the full row width so the outline bounds the real bar
             exactly (the star-weighted fill fills whatever width it's given). -->
        <Style Selector="Border.BuffBarFrame">
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The elapsed-time fill — a DARKER green than the outline, kept flat across the
             whole bar (no bright fill); a dark amber once the fill crosses the recast
             marker. The "due" amber is deliberately DIM — the same darkness as the green,
             not the bright AccentYellow it used to be — so the light name / grey time
             overlaid on it stay readable (bright yellow made grey-on-yellow unreadable).
             The bright accent still lives on the recast MARKER line, not the fill. -->
        <Style Selector="Border.BuffFill">
            <Setter Property="Background" Value="#FF456644"/>
        </Style>
        <Style Selector="Border.BuffFill.recast">
            <Setter Property="Background" Value="#FF6E5A2E"/>
        </Style>

        <!-- Remaining-time label inside the bar, offset after the name. -->
        <Style Selector="TextBlock.BarTime">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>

        <!-- 4-letter buff code / #item label, rendered left-aligned INSIDE the bar. -->
        <Style Selector="TextBlock.BarName">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <!-- Superseded (covered-by-a-party-buff) self-buff rows read deemphasised, so an
             empty bar labelled "covered by chan" reads as intentional, not missing. -->
        <Style Selector="TextBlock.BarName.covered">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.BarTime.covered">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>

        <!-- "unlearned" chip on a configured buff the character hasn't learned. -->
        <Style Selector="Border.UnlearnedChip">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Border.UnlearnedChip > TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
        </Style>
    </Window.Styles>

    <!-- Two zones — the buff-config table and the live timer bars — split by a
         user-draggable GridSplitter. Their arrangement (config on top / bottom /
         left / right) is chosen in Settings → General and applied by the code-behind,
         which reflows this grid + the splitter whenever BuffWatchdogViewModel.Layout
         changes (and collapses the splitter for a class with no configurable buffs).
         Both zones are star-sized so they grow to fill the window. -->
    <Grid x:Name="ZonesGrid">

        <ScrollViewer x:Name="ConfigZone"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

                <!-- ===== Configure buffs =====
                     The editable buff table (moved here from the Party window):
                     ＋ Add buff opens the picker, each slot is edited (✎) / removed (⨯)
                     and its targeting chosen inline. Hidden for a class with no
                     configurable buff spells. Backed by CharacterProfile.PartyBuffs. -->
                <Border Background="{StaticResource ChromeBgSunkenBrush}">
                    <StackPanel HorizontalAlignment="Stretch"
                                DataContext="{Binding Buffs}" x:DataType="vm:BuffPanelViewModel">
                        <StackPanel Orientation="Horizontal" Margin="8,8,8,4" Spacing="6">
                            <Button Content="＋ Add buff" Padding="8,2"
                                    IsEnabled="{Binding CanAddBuff}"
                                    Command="{Binding AddBuffCommand}"/>
                            <Button Content="Add all blesses" Padding="8,2"
                                    IsEnabled="{Binding CanAddAllBlesses}"
                                    Command="{Binding AddAllBlessesCommand}"
                                    ToolTip.Tip="List every buff you or the party can cast, regardless of level. Where two self buffs would strip each other off (e.g. greater zeal / zeal), both are listed but only the higher-level one comes checked — checking the other unchecks it, and vice versa. Whole-party buffs are listed too but never pre-checked — tick Party Wide yourself to turn one on."/>
                            <Button Content="Remove all" Padding="8,2"
                                    IsEnabled="{Binding HasSlots}"
                                    Command="{Binding RemoveAllBuffsCommand}"
                                    Foreground="{StaticResource AccentRedBrush}"
                                    ToolTip.Tip="Remove every configured buff slot — self, party, and whole-party alike. Asks to confirm first (unless confirm-deletes is off in Settings)."/>
                        </StackPanel>

                        <!-- Live mana-upkeep readout: how much mana/second every currently-
                             CHECKED buff costs to keep recast, expressed per passive regen
                             tick (30s — the same cadence the observed "MP +N after ~30s"
                             readout and ManaRegenBreakpointCalculator use) and per minute.
                             Recomputes on every checkbox toggle and party-roster change. -->
                        <TextBlock IsVisible="{Binding HasSlots}" Margin="8,0,8,6" FontSize="11"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   ToolTip.Tip="Mana per second every currently-checked buff needs to stay recast, added up across self, party, and whole-party casts.">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Mana to maintain: {0:0.0} / 30s tick · {1:0.0} / min">
                                    <Binding Path="RequiredManaPerTick"/>
                                    <Binding Path="RequiredManaPerMinute"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock IsVisible="{Binding !HasSlots}" Margin="8,4,8,6"
                                   Text="No buffs configured. Click “Add buff”, pick a spell, then set who receives it."
                                   Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap"/>

                        <!-- Buff rows. Shared columns (buff | self | all-none | per-member) line
                             up under the header; a whole-party buff spans the member columns
                             with "Party Wide". Solo hides the all-none + member columns.
                             Horizontal scroll for a full party. -->
                        <ScrollViewer IsVisible="{Binding HasSlots}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid ColumnDefinitions="240,40,56,*" Margin="6,0,6,2">
                                    <TextBlock Grid.Column="0" Text="Buff" FontSize="10"
                                               VerticalAlignment="Bottom"
                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Self" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                    <TextBlock Grid.Column="2" Text="All/None" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               IsVisible="{Binding ShowPartyColumns}"
                                               Foreground="{StaticResource ChromeFgBrush}"/>
                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Members}"
                                                  IsVisible="{Binding ShowPartyColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" Width="56" FontSize="10"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{StaticResource ChromeFgBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- The whole buff list in one ItemsControl, kept in a single
                                     order (buffs you aim first, then whole-party, then item
                                     "on use" buffs) inside Slots itself — see InsertSorted.
                                     Bound straight to the ObservableCollection so a single
                                     add / remove touches one row instead of rebuilding the
                                     whole list. -->
                                <ItemsControl ItemsSource="{Binding Slots}"
                                              ItemTemplate="{StaticResource BuffSlotRowTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
        </ScrollViewer>

        <!-- Drag to re-divide the two zones. The code-behind sets its orientation
             (rows vs columns) + position from the chosen layout. -->
        <GridSplitter x:Name="ZoneSplitter"
                      Background="{StaticResource ChromeBorderBrush}"/>

        <!-- Timer bars fill whatever space the config table doesn't take. A Grid so the
             collapse/expand toggle can float over the top-right corner, above the scroll. -->
        <Grid x:Name="BarsZone">
            <ScrollViewer>
                <StackPanel>

                <TextBlock Margin="10,12,10,10"
                           Text="No buffs up yet. Add buffs in the config panel and tick who each one is cast on (yourself and/or party members)."
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsEmpty}"/>

                <!-- ===== Buff timers, grouped by player =====
                     One section per player a buff is on: your own name (self +
                     whole-party buffs) first, then each party member with the buffs
                     cast on them. Bars are width-capped (MaxWidth) + left-aligned so
                     they stay short regardless of the window width. -->
                <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding !IsEmpty}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BuffWatchdogPlayerGroup">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Classes="SectionHeader" Text="{Binding PlayerName}"/>
                                <!-- No background — the capped bars sit directly on the
                                     pane background, so the empty space beside a short bar
                                     (and the stretch as the window widens) just blends in. -->
                                <ItemsControl ItemsSource="{Binding Rows}"
                                              Margin="6,0" Padding="2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BuffWatchdogRowViewModel">
                                            <!-- No row divider — each bar's own green frame
                                                 separates it; a full-width line would just
                                                 stretch across the blended pane background. -->
                                            <!-- ToolTip on the whole row so a "conflict" bar carries its
                                                 explanation everywhere, not just on the ⚠ (null = normal
                                                 bar, no tooltip). -->
                                            <Border Padding="6,4" ToolTip.Tip="{Binding ConflictTooltip}">
                                                <!-- ✕ clears this timer (only while up); then the
                                                     width-capped bar: light-green frame, star-weighted
                                                     elapsed fill, recast marker on the fill/rest boundary,
                                                     name + time left-aligned over the dark interior. -->
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                                    <Button Grid.Column="0" Content="✕" Width="18" Height="18"
                                                            Padding="0" FontSize="10" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsActive}"
                                                            ToolTip.Tip="Clear this buff timer (mark it off)"
                                                            Command="{Binding $parent[Window].((vm:BuffWatchdogViewModel)DataContext).ClearTimerCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Border Classes="BuffBarFrame" MaxWidth="260" HorizontalAlignment="Left">
                                                        <Grid Height="20" MinWidth="180" Background="#FF1B2A1D" ClipToBounds="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding FillStar}"/>
                                                                    <ColumnDefinition Width="{Binding FillRestStar}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Classes="BuffFill"
                                                                        Classes.recast="{Binding InRecastWindow}"/>
                                                            </Grid>
                                                            <Grid IsVisible="{Binding ShowRecastMarker}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding MarkerStar}"/>
                                                                    <ColumnDefinition Width="{Binding MarkerRestStar}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="1" Width="2" HorizontalAlignment="Left"
                                                                        Background="{StaticResource AccentYellowBrush}"/>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <!-- Clobbered by a later-cast buff that removes this one: the ⚠
                                                                     sits at the FRONT and the bar reads "conflict" (see the row VM). -->
                                                                <TextBlock Text="⚠" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource AccentRedBrush}"
                                                                           IsVisible="{Binding IsConflicted}"
                                                                           ToolTip.Tip="{Binding OverwriteWarningTooltip}"/>
                                                                <TextBlock Classes="BarName" Classes.covered="{Binding IsCovered}"
                                                                           Text="{Binding Name}"/>
                                                                <Border Classes="UnlearnedChip" IsVisible="{Binding !IsLearned}">
                                                                    <TextBlock Text="unlearned"/>
                                                                </Border>
                                                                <TextBlock Classes="BarTime" Classes.covered="{Binding IsCovered}"
                                                                           Text="{Binding TimeText}"/>
                                                                <!-- Warning marker: another configured buff removes (or is
                                                                     removed by) this one via RemovesSpell — informational
                                                                     only, the bar above still reflects the real timer. -->
                                                                <TextBlock Text="⚠" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource AccentRedBrush}"
                                                                           IsVisible="{Binding HasOverwriteWarning}"
                                                                           ToolTip.Tip="{Binding OverwriteWarningTooltip}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        </Border>
                                                        <!-- Only whole-party buffs need a caption (they land on
                                                             everyone); a self / member buff's player is the header. -->
                                                        <TextBlock Text="whole party" FontSize="9"
                                                                   IsVisible="{Binding IsWholeParty}"
                                                                   Margin="2,1,0,0"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Collapse / expand the config panel. Floats over the bars' top-right
                 corner; only shown when the class actually HAS a config panel. Styled
                 like the navigation map's collapse chip (elevated, bordered, rounded);
                 the arrow points the direction the next click moves the divider. -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    IsVisible="{Binding Buffs.ShowPanel}"
                    Command="{Binding ToggleConfigCommand}"
                    Content="{Binding ConfigToggleGlyph}"
                    ToolTip.Tip="{Binding ConfigToggleTooltip}"
                    Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,2"
                    MinHeight="24"
                    Height="24"
                    FontSize="11"/>
        </Grid>
    </Grid>
</Window>
