<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.GameData.Tables"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="480"
             x:Class="MudPlay.Views.GameData.Tables.GameDataTableSectionView"
             x:DataType="vm:GameDataTableSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.Header">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.StatusText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        </Style>
        <!-- Range boxes sit two-across (min / max), so hide the spin buttons to
             leave room for the number; the user types the bracket values. -->
        <Style Selector="NumericUpDown.range">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="ShowButtonSpinner" Value="False"/>
            <Setter Property="Minimum" Value="-100000000"/>
            <Setter Property="Maximum" Value="100000000"/>
            <Setter Property="Increment" Value="1"/>
            <Setter Property="FormatString" Value="0"/>
        </Style>
        <Style Selector="TextBlock.FilterLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Styles>

    <!-- Table content, a drag handle, and the filter sidebar. Tables that expose
         no filters (everything but Monsters today) have HasFilterPanel = false, so
         the splitter and sidebar collapse (their Auto/0 columns shrink to nothing)
         and the layout looks exactly as before. The sidebar column's width is set
         in code-behind and the GridSplitter resizes it. -->
    <Grid Margin="22" x:Name="OuterGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">

            <!-- Tab header. -->
            <TextBlock Grid.Row="0" Classes="Header" Text="{Binding Title}"/>

            <!-- Optional muted banner — collapses when the VM doesn't set BannerText. -->
            <Border Grid.Row="1"
                    Padding="10,6"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    IsVisible="{Binding BannerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding BannerText}"
                           Classes="StatusText"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Search box + Add/Remove buttons (Add/Remove only render
                 when the section implements IEditableTableSectionViewModel
                 with non-null AddCommand / RemoveCommand — wired in
                 code-behind via FindControl). -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <TextBox Classes="clearable" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Filter…"
                         ToolTip.Tip="{Binding FilterHint}"
                         Width="320"/>
                <Button x:Name="AddButton"    Content="Add"    IsVisible="False"/>
                <Button x:Name="RemoveButton" Content="Remove" IsVisible="False"/>
            </StackPanel>

            <!-- Tabular row grid. Columns are populated in code-behind from
                 the VM's Columns list so they auto-size and align with their
                 headers. -->
            <DataGrid Grid.Row="3"
                      x:Name="RowsGrid"
                      ItemsSource="{Binding FilteredRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"/>

            <!-- Footer status -->
            <TextBlock Grid.Row="4" Classes="StatusText" Text="{Binding StatusText}"/>

        </Grid>

        <!-- Drag handle: resizes the sidebar. Hidden (and its Auto column collapses)
             on tables with no filter panel. -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      Margin="8,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource ChromeBorderBrush}"
                      ShowsPreview="False"
                      IsVisible="{Binding HasFilterPanel}"/>

        <!-- Filter sidebar: labelled groups of min/max ranges, checkboxes, and
             dropdowns that live-curate the list. Scrolls when the list is long. -->
        <Border Grid.Column="2"
                MinWidth="248"
                Padding="12"
                IsVisible="{Binding HasFilterPanel}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <DockPanel LastChildFill="True">
                <!-- The panel CURATES the list live (edit any control → re-filters);
                     the top search box FINDS a monster within the curated list. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Filters"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Reset"
                            Command="{Binding ResetFiltersCommand}"
                            Padding="10,2" FontSize="11"
                            ToolTip.Tip="Clear every filter (and the search box)"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilterGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterGroup">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Header}"
                                               Foreground="{StaticResource ChromeFgBrush}"
                                               FontWeight="SemiBold" Margin="0,6,0,4"/>
                                    <!-- Min / max range boxes (either blank = no limit on that side). -->
                                    <ItemsControl ItemsSource="{Binding Ranges}" IsVisible="{Binding HasRanges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RangeFilter">
                                                <StackPanel Margin="0,0,0,5">
                                                    <TextBlock Classes="FilterLabel" Text="{Binding Label}"
                                                               ToolTip.Tip="{Binding Hint}"/>
                                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                                                        <NumericUpDown Grid.Column="0" Classes="range"
                                                                       PlaceholderText="min"
                                                                       Value="{Binding Min, Mode=TwoWay}"
                                                                       ToolTip.Tip="Minimum (blank = no lower limit)"/>
                                                        <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                        <NumericUpDown Grid.Column="2" Classes="range"
                                                                       PlaceholderText="max"
                                                                       Value="{Binding Max, Mode=TwoWay}"
                                                                       ToolTip.Tip="Maximum (blank = no upper limit)"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Bools}" IsVisible="{Binding HasBools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BoolFilter">
                                                <CheckBox Margin="0,2"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding Hint}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryFilter">
                                                <StackPanel Margin="0,2,0,4">
                                                    <TextBlock Classes="FilterLabel" Text="{Binding Label}"
                                                               ToolTip.Tip="{Binding Hint}"/>
                                                    <ComboBox HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Selected, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
