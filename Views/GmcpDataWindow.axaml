<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels" x:Class="MudPlay.Views.GmcpDataWindow" x:DataType="vm:GmcpDataViewModel"
        Title="Current server data" Width="760" Height="640" MinWidth="540" MinHeight="400">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <TextBlock Text="{Binding Status}"/>
    <ComboBox Grid.Row="1" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" HorizontalAlignment="Stretch"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <TextBox PlaceholderText="Item number" Text="{Binding ItemNumber}" Width="130"/>
      <Button Content="Item card" Command="{Binding ItemCardCommand}"/>
      <Button Content="Can I use it?" Command="{Binding ItemUsabilityCommand}"/>
      <Button Content="Refresh snapshots" Command="{Binding RefreshCommand}"/>
    </StackPanel>
    <TextBox Grid.Row="3" Text="{Binding Body}" IsReadOnly="True" AcceptsReturn="True" FontFamily="monospace"
             TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  </Grid>
</Window>
