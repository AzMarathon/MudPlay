<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="520"
             x:Class="MudPlay.Views.FirstRunTutorialOverlay"
             x:DataType="vm:FirstRunTutorialViewModel"
             IsVisible="{Binding IsActive}">

    <!-- Full-window guidance layer. Everything but the callout card is
         hit-test-transparent, so the terminal + the spotlighted menu stay
         fully usable (the tour never locks the UI). Geometry is placed in
         code-behind against the spotlighted control's live bounds. -->
    <Grid>
        <!-- Dim scrim with a spotlight cutout (EvenOdd geometry set in code). -->
        <Path x:Name="Scrim" Fill="#A6000000" IsHitTestVisible="False"/>

        <Canvas x:Name="Layer">
            <!-- Highlight ring around the spotlighted control. -->
            <Border x:Name="Ring" IsHitTestVisible="False"
                    BorderBrush="{StaticResource AccentYellowBrush}"
                    BorderThickness="2" CornerRadius="4"
                    Background="Transparent"/>

            <!-- Callout card — the only hit-testable element. -->
            <Border x:Name="Card" MaxWidth="360"
                    Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel Spacing="8">
                    <TextBlock Text="First-time setup"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentYellowBrush}"/>
                    <TextBlock Text="{Binding CurrentTitle}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource ChromeFgBrush}"/>
                    <TextBlock Text="{Binding CurrentInstruction}"
                               TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource ChromeFgSecBrush}"/>
                    <TextBlock Text="✓ Done — nice!"
                               IsVisible="{Binding CurrentIsDone}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGreenBrush}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding StepCounterText}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                        <Button Grid.Column="2" Content="Back" Margin="0,0,6,0"
                                Command="{Binding PrevCommand}"
                                IsEnabled="{Binding CanPrev}"/>
                        <Button Grid.Column="3" Content="{Binding NextButtonText}"
                                Command="{Binding NextCommand}"/>
                    </Grid>
                    <Button Content="Skip — don't show this again"
                            HorizontalAlignment="Left" Padding="0" Margin="0,2,0,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="11"
                            Foreground="{StaticResource ChromeFgMutedBrush}"
                            Command="{Binding SkipCommand}"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
