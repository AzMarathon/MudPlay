<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="240"
        x:Class="MudPlay.Views.UpdateWindow"
        x:DataType="vm:UpdateWindowViewModel"
        Title="Update the Client"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Header: verdict headline + installed version -->
        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
            <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="Bold"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CurrentVersionLine}" FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <!-- Buttons (bottom-most) -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              ColumnSpacing="8">
            <Button Grid.Column="0" Content="View release notes ↗"
                    Command="{Binding OpenReleasePageCommand}"
                    IsVisible="{Binding HasReleaseLink}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Cursor="Hand" VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemAccentColor}"/>
            <Button Grid.Column="2" Content="Check again" MinWidth="90"
                    Command="{Binding CheckCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Grid.Column="3" Content="Download &amp; Restart" MinWidth="130"
                    Classes="accent"
                    Command="{Binding DownloadAndRestartCommand}"
                    IsVisible="{Binding CanApply}" IsEnabled="{Binding !IsBusy}"/>
            <Button Grid.Column="4" Content="Close" MinWidth="80"
                    IsCancel="True" Click="OnClose"/>
        </Grid>

        <!-- Download progress (above buttons, only while downloading) -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0"
                    IsVisible="{Binding IsDownloading}">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadProgress}" Height="8"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="12" Opacity="0.75"
                       HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Detail + release notes (fill) -->
        <StackPanel Spacing="10">
            <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                 FontSize="13" Opacity="0.92"/>
            <Border IsVisible="{Binding HasReleaseNotes}"
                    BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource ThemeControlMidBrush}"
                    Padding="10" MaxHeight="230">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap"
                                         FontSize="12" LineHeight="17" Opacity="0.9"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

    </DockPanel>
</Window>
