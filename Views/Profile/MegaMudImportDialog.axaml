<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Profile"
        xmlns:svc="using:MudPlay.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
        x:Class="MudPlay.Views.Profile.MegaMudImportDialog"
        x:DataType="vm:MegaMudImportDialogViewModel"
        Title="Import MegaMUD profile"
        Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Head">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.Dim">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        </Style>
        <Style Selector="Border.Box">
            <Setter Property="Background" Value="{StaticResource ChromeBgSunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <!-- Name and target on top; what comes across and what doesn't share the
             rest of the height, each scrolling on its own. -->
        <Grid RowDefinitions="Auto,Auto,3*,Auto,2*,Auto" RowSpacing="8">

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Classes="Dim" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis"/>
                <Grid ColumnDefinitions="Auto,260,*" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="Character name" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Classes="Dim" Text="{Binding TargetText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRedBrush}"
                           FontSize="{StaticResource FontSizeSm}" IsVisible="{Binding HasError}"/>
                <CheckBox Content="Also store the file's BBS user ID and password as this character's login"
                          IsChecked="{Binding ImportLogin, Mode=TwoWay}" IsVisible="{Binding HasLogin}"
                          ToolTip.Tip="MegaMUD keeps the user ID and password in the file as plain text. Ticked, they are saved encrypted on the new character for this BBS, as if typed into BBS settings. Unticked, they are not read into MudPlay at all."/>
            </StackPanel>

            <TextBlock Grid.Row="1" Classes="Head" Text="{Binding ImportedHeader}" Margin="0,4,0,0"/>
            <Border Grid.Row="2" Classes="Box">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Imported}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:MegaMudImportLine">
                                <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10" Margin="0,1,14,1">
                                    <TextBlock Grid.Column="0" Classes="Dim" Text="{Binding Group}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Setting}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" MaxWidth="330"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource FontMono}"
                                               ToolTip.Tip="{Binding Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="3" Classes="Head" Text="{Binding LeftBehindHeader}" Margin="0,4,0,0"/>
            <Border Grid.Row="4" Classes="Box">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LeftBehind}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:MegaMudImportLine">
                                <Grid ColumnDefinitions="110,200,*" ColumnSpacing="10" Margin="0,2,14,2">
                                    <TextBlock Grid.Column="0" Classes="Dim" Text="{Binding Group}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Setting}" TextWrapping="Wrap"
                                               ToolTip.Tip="{Binding Value}"/>
                                    <TextBlock Grid.Column="2" Classes="Dim" Text="{Binding Note}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="5">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Import" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"
                            IsDefault="True" MinWidth="90"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80"/>
                </StackPanel>
                <TextBlock Classes="Dim" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="A new character is made; nothing existing is changed. Review its settings before playing it."/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
