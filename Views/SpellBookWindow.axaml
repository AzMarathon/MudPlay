<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="MudPlay.Views.SpellBookWindow"
        x:DataType="vm:SpellBookViewModel"
        Title="Spell Book"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Spell-grid cell colours are set via classes (NOT a local Foreground) so
             the selected-row override below can win — a local value beats a
             pseudo-class style, which is why the dim Lvl / Mana / Code text used to
             wash out (barely readable) on the selection highlight. -->
        <Style Selector="TextBlock.cellGlyph"><Setter Property="Foreground" Value="{StaticResource SeverityInfoBrush}"/></Style>
        <Style Selector="TextBlock.cellCode"><Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/></Style>
        <Style Selector="TextBlock.cellName"><Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/></Style>
        <Style Selector="TextBlock.cellDim"><Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/></Style>
        <Style Selector="TextBlock.cellEffect"><Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/></Style>
        <!-- Selected row: force bright, high-contrast text on every cell. -->
        <Style Selector="DataGridRow:selected TextBlock.cellGlyph"><Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/></Style>
        <Style Selector="DataGridRow:selected TextBlock.cellCode"><Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/></Style>
        <Style Selector="DataGridRow:selected TextBlock.cellName"><Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/></Style>
        <Style Selector="DataGridRow:selected TextBlock.cellDim"><Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/></Style>
        <Style Selector="DataGridRow:selected TextBlock.cellEffect"><Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/></Style>
        <!-- Tighten the default column-header padding so a header isn't
             clipped in a snug column. -->
        <Style Selector="DataGridColumnHeader"><Setter Property="Padding" Value="4,0"/></Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ============ Control strip ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderText}"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <!-- How the Success % column is computed, surfaced in the blank
                     space between the class/level and the filters. -->
                <TextBlock Grid.Column="0"
                           Text="{Binding SuccessFormulaText}"
                           HorizontalAlignment="Right"
                           Margin="0,0,16,0"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding ShowAllSpells}"
                          Content="Show all"
                          ToolTip.Tip="Show the full class list regardless of level (the Lvl column shows when each unlocks)."
                          Foreground="{StaticResource ChromeFgSecBrush}"
                          FontSize="11"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2"
                          IsChecked="{Binding ShowObtainedOnly}"
                          Content="Known only"
                          Foreground="{StaticResource ChromeFgSecBrush}"
                          FontSize="11"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Classes="clearable" MinWidth="180"
                         PlaceholderText="Search code / name…"
                         Text="{Binding SearchText, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- ============ Status footer ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ============ Cast-on-use items ============ -->
        <!-- Class-usable wands / scrolls / potions that cast a spell on use
             (Items code-43 CastsSp), listed below the spell grid with a
             charges indicator. Collapses entirely when the class has none. -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasCastItems}"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding CastItemsHeader}"
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CastItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SpellBookItemRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding LevelText}"
                                               ToolTip.Tip="Minimum character level to use this item"
                                               Foreground="{StaticResource ChromeFgSecBrush}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               MinWidth="42"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ItemName}"
                                               Foreground="{StaticResource ChromeFgBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CastsText}"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AffectsText}"
                                               IsVisible="{Binding HasAffects}"
                                               ToolTip.Tip="What the cast spell does, at this item's use-level"
                                               Foreground="{StaticResource ChromeFgSecBrush}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ManaText}"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <!-- Use count tucked inline at the end of the line rather than
                                         right-aligned in its own column (which the scrollbar clipped). -->
                                    <TextBlock Text="·"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChargesText}"
                                               ToolTip.Tip="{Binding ChargesTip}"
                                               Foreground="{StaticResource SeverityInfoBrush}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Spell rows ============ -->
        <!-- DataGrid for user-adjustable columns (resize / reorder / sort).
             ReflectionBinding: column bindings resolve against the row item
             (SpellBookRowViewModel); the DataGrid's auto-wrapped collection
             view defeats compiled-binding item-type inference, matching the
             SpellCoverageReportWindow pattern. -->
        <DataGrid ItemsSource="{Binding Rows}"
                  DoubleTapped="OnSpellRowDoubleTapped"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="0"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  ToolTip.Tip="Double-click a spell to open the record of the item — or trainer NPC — that teaches it.">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" SortMemberPath="IsObtained" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding ObtainedGlyph}" Classes="cellGlyph"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontMono}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Code" SortMemberPath="Short" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding Short}" Classes="cellCode"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontFamily="{StaticResource FontMono}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding Name}" Classes="cellName"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Lvl" SortMemberPath="EffectiveLevel" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding ReqLevelText}" Classes="cellDim"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontMono}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mana" SortMemberPath="Mana" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding ManaText}" Classes="cellDim"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontMono}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Success %" SortMemberPath="SuccessSort" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding SuccessText}" Classes="cellDim"
                                       ToolTip.Tip="{Binding SuccessTooltip}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontMono}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Effect" SortMemberPath="EffectText" Width="*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:SpellBookRowViewModel">
                            <TextBlock Text="{Binding EffectText}" Classes="cellEffect"
                                       ToolTip.Tip="{Binding FormulaText}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       Margin="8,0"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
