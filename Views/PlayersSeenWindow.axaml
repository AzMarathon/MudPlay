<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:profile="using:FujinTerm.Models.Profile"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440"
        x:Class="FujinTerm.Views.PlayersSeenWindow"
        x:DataType="vm:PlayersSeenViewModel"
        Title="Players Seen"
        Width="560" Height="440"
        MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel LastChildFill="True">

        <!-- ============ Column header ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="120,*,120,48">
                <TextBlock Grid.Column="0" Text="Timestamp"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Where"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="Who"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="Times"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ============ Footer: user-driven clear ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Button Content="Clear history"
                    HorizontalAlignment="Right"
                    Command="{Binding ClearCommand}"
                    IsEnabled="{Binding !IsEmpty}"/>
        </Border>

        <!-- ============ Entries list (+ empty placeholder) ============ -->
        <Grid Background="{StaticResource ChromeBgSunkenBrush}">
            <ListBox ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="profile:PlayerSighting">
                        <Grid ColumnDefinitions="120,*,120,48" Margin="4,2">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LastSeen, StringFormat='{}{0:ddMMMyy HH:mm:ss}'}"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding WhereText}"
                                                 Foreground="{StaticResource ChromeFgSecBrush}"
                                                 FontFamily="{StaticResource FontMono}"
                                                 FontSize="11"
                                                 TextWrapping="Wrap"
                                                 VerticalAlignment="Center"/>
                            <SelectableTextBlock Grid.Column="2"
                                                 Text="{Binding Name}"
                                                 Foreground="{StaticResource ChromeFgBrush}"
                                                 FontFamily="{StaticResource FontMono}"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding TimesSeen}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource ChromeFgSecBrush}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No players seen yet."
                       IsVisible="{Binding IsEmpty}"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </DockPanel>
</Window>
