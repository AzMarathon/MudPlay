<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="440"
        x:Class="MudPlay.Views.AvoidRoomsEditorDialog"
        x:DataType="vm:AvoidRoomsEditorDialogViewModel"
        Title="Modify Avoid / Stash Rooms"
        Width="580" Height="440"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Clickable column header — reads as a header caption but re-sorts the
             list on click, carrying the active-sort direction glyph. -->
        <Style Selector="Button.ColHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ColHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ChromeBgHoverBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="Avoid rooms are a personal no-go list — the navigation engine routes the walker, loops, and auto-lair around them. Stash rooms are drop-off points the cash / item engines use when stashing. The two are independent, so a room can be both (it appears once per type). The Map/Room tuple is the lookup key; the name is informational."
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   Margin="0,0,0,10"/>

        <!-- Current entries list -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid RowDefinitions="Auto,*">
                <!-- Column headers — click to sort (toggles asc/desc). -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="100,60,70,*"
                      Background="{StaticResource ChromeBgElevBrush}">
                    <Button Grid.Column="0" Classes="ColHeader" Content="{Binding TypeHeader}"
                            Command="{Binding SortCommand}" CommandParameter="Type"/>
                    <Button Grid.Column="1" Classes="ColHeader" Content="{Binding MapHeader}"
                            Command="{Binding SortCommand}" CommandParameter="Map"/>
                    <Button Grid.Column="2" Classes="ColHeader" Content="{Binding RoomHeader}"
                            Command="{Binding SortCommand}" CommandParameter="Room"/>
                    <Button Grid.Column="3" Classes="ColHeader" Content="{Binding NameHeader}"
                            Command="{Binding SortCommand}" CommandParameter="Name"/>
                </Grid>
                <ListBox Grid.Row="1"
                         x:Name="EntriesList"
                         ItemsSource="{Binding Entries}"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:AvoidRoomRow">
                            <Grid ColumnDefinitions="100,60,70,*">
                                <TextBlock Grid.Column="0" Text="{Binding TypeLabel}" Margin="0,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding Map}"  Margin="0,2"/>
                                <TextBlock Grid.Column="2" Text="{Binding Room}" Margin="0,2"/>
                                <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="0,2"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Add row -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,110,Auto,70,Auto,70,*,Auto"
              ColumnSpacing="6"
              Margin="0,10,0,12">
            <TextBlock Grid.Column="0" Classes="Label" Text="Add — Type"/>
            <ComboBox  Grid.Column="1"
                       ItemsSource="{Binding KindOptions}"
                       SelectedItem="{Binding AddKind, Mode=TwoWay}"
                       HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Column="2" Classes="Label" Text="Map"/>
            <TextBox   Grid.Column="3"
                       Text="{Binding AddMap, Mode=TwoWay}"
                       PlaceholderText="map #"/>
            <TextBlock Grid.Column="4" Classes="Label" Text="Room"/>
            <TextBox   Grid.Column="5"
                       Text="{Binding AddRoom, Mode=TwoWay}"
                       PlaceholderText="room #"/>
            <TextBlock Grid.Column="6" Classes="Label"
                       Text="{Binding AddNamePreview}"
                       TextTrimming="CharacterEllipsis"
                       Margin="6,0"/>
            <Button Grid.Column="7" Content="Add room"
                    Command="{Binding AddRowCommand}"
                    IsEnabled="{Binding CanAdd}"
                    IsDefault="True"/>
        </Grid>

        <!-- Remove / Save / Cancel -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Content="Remove selected"
                    Command="{Binding RemoveSelectedCommand}"
                    IsEnabled="{Binding CanRemoveSelected}"/>
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}"
                    MinWidth="80" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="Save"   Command="{Binding SaveCommand}"
                    MinWidth="80"/>
        </Grid>
    </Grid>
</Window>
