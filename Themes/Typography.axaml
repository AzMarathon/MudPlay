<!--
  Typography tokens — IBM Plex Sans for chrome, JetBrains Mono for monospace
  chrome surfaces. The terminal canvas font is a per-character setting
  (default: the bundled Mx437 bitmap font from Assets/Fonts/).

  Fonts are bundled under Assets/Fonts/ and pulled in via avares://. The
  trailing #Family-Name segment must match the font's internal family name
  exactly; Avalonia uses it to disambiguate when multiple weights live in
  separate .ttf files.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ Font families ============ -->
    <FontFamily x:Key="FontChrome">avares://MudPlay/Assets/Fonts/IBMPlexSans-Regular.ttf#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="FontMono">avares://MudPlay/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
    <!-- The bundled CP437 bitmap font: the terminal's default, and the
         design-time font of the map hover / hold-chip tooltips (DisplayConfig
         swaps the hover tooltip's font at runtime). -->
    <FontFamily x:Key="FontTerminal">avares://MudPlay/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16</FontFamily>

    <!-- ============ Font sizes ============ -->
    <!-- 13 px is the default for chrome text; 11 px is the
         "small / muted" tier used on shortcuts and badges; 16 / 20 are
         section headers + the rare H1 surface. -->
    <sys:Double x:Key="FontSizeSm">11</sys:Double>
    <sys:Double x:Key="FontSizeMd">13</sys:Double>
    <sys:Double x:Key="FontSizeLg">16</sys:Double>
    <sys:Double x:Key="FontSizeXL">20</sys:Double>

    <!-- ============ Line heights ============ -->
    <sys:Double x:Key="LineHeightSm">16</sys:Double>
    <sys:Double x:Key="LineHeightMd">20</sys:Double>
    <sys:Double x:Key="LineHeightLg">24</sys:Double>

</ResourceDictionary>
