{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://anomaly.local/gmcp-contract/1.1.0/Anomaly.Mob.Update.json","title":"Anomaly.Mob.Update","description":"Live state (A.3, A.4, A.9). full:true = a baseline carrying every live field, sent whenever the monster enters the client's room state, even if nothing changed. full:false = only changed fields (at least one). A client drops a message whose room is not its current room (A.2).","x-direction":"s2c","x-frozen":false,"type":"object","additionalProperties":false,"required":["uid","room","full"],"properties":{"uid":{"type":"integer","minimum":1,"description":"monster runtime id, unique within one server start (boot)"},"room":{"type":"string","pattern":"^[0-9]+,[0-9]+$","description":"map,room as `rm` prints it"},"full":{"type":"boolean"},"hp":{"type":"integer"},"maxhp":{"type":"integer"},"target":{"type":["string","null"]},"effects":{"type":"array","items":{"type":"object","properties":{"spell":{"type":"integer"},"name":{"type":"string"},"roundsLeft":{"type":["integer","null"]}},"required":["spell","name","roundsLeft"],"additionalProperties":false}},"status":{"type":"object","properties":{"held":{"type":"boolean"},"blind":{"type":"boolean"},"fleeing":{"type":"boolean"},"charmed":{"type":"boolean"}},"required":["held","blind","fleeing","charmed"],"additionalProperties":false},"effective":{"type":"object","properties":{"ac":{"type":"integer"},"dr":{"type":"integer"},"mr":{"type":"integer"},"accuracy":{"type":"integer"}},"required":["ac","dr","mr","accuracy"],"additionalProperties":false}},"allOf":[{"if":{"properties":{"full":{"const":true}}},"then":{"required":["hp","maxhp","target","effects","status","effective"]}},{"if":{"properties":{"full":{"const":false}}},"then":{"minProperties":4}}]}
