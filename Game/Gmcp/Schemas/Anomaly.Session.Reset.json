{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://anomaly.local/gmcp-contract/1.0.0/Anomaly.Session.Reset.json","title":"Anomaly.Session.Reset","description":"Scoped reset (A.1). scope all: drop everything (static monster cache included). package: that package only. room: room-bound state only; the static monster cache survives (A.9). room names the NEW room.","x-direction":"s2c","x-frozen":false,"type":"object","additionalProperties":false,"required":["scope"],"properties":{"scope":{"enum":["all","package","room"]},"reason":{"enum":["enter","leave","character"]},"package":{"type":"string"},"room":{"type":"string","pattern":"^[0-9]+,[0-9]+$","description":"map,room as `rm` prints it"}},"allOf":[{"if":{"properties":{"scope":{"const":"all"}}},"then":{"required":["reason"]}},{"if":{"properties":{"scope":{"const":"package"}}},"then":{"required":["package"]}},{"if":{"properties":{"scope":{"const":"room"}}},"then":{"required":["room"]}}]}
